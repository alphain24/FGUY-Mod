// Online session autopilot (main menu movie). After the lobby's Start every player's game restarts into
// a lockstepped netplay session; this script then walks the game's own menus to the match with the
// lobby's choices - the same steps on every PC, so everyone's game stays identical.
//
// The menus report each page through GetEventFuncName (patched to ask FGUYEventName). In a session,
// Enter / PlayerJoined events of the pages below go to our OnSess<Page><Event> wrappers, which run the
// game's own handler first and then take the next step. Button presses the game must see (joining
// players, the save slot) come from the loader: FGUYMOD_SessionPress(pad, button, delay in ticks).
//
// Config from the loader (FGUYMOD_SessionConfig): "mode,map,time,score,ff|char:costume:team;..." by slot.

function FGUYEventName(name, event) {
    if (FGUYOnline && name == 'OptionsScreen') return 'Online';
    if (!FGUYSessChecked) FGUYSessionInit();
    // after the match (its results, or a quit) the front end comes back: back to the lobby
    if (FGUYSessOn && event == 'Enter' && FGUYSessStage == 'started' && !FGUYSessReturning) FGUYSessionCheckReturn();
    if (FGUYSessReturning && event == 'Enter' && name != 'OptionsScreen') FGUYSessLastEnter = FGUYSessReturnWaits;
    if (FGUYSessOn && (event == 'Enter' || event == 'PlayerJoined') && _root['OnSess' + name + event] != undefined)
        return 'Sess' + name;
    return name;
}

function FGUYSessionInit() {
    FGUYSessChecked = true;
    var cfg = flash.external.ExternalInterface.call('FGUYMOD_SessionConfig');
    FGUYSessOn = cfg != undefined && cfg != '';
    var auto = flash.external.ExternalInterface.call('FGUYMOD_TestAutoMenu');
    if (!FGUYSessOn && auto != undefined && auto != '') {   // test copies: boot by themselves, then open a page
        FGUYSessOn = true;
        FGUYSessAuto = String(auto);
        FGUYSessStage = 'boot';
        FGUYSessLog('test auto menu: ' + auto);
        return;
    }
    if (!FGUYSessOn) return;
    if (flash.external.ExternalInterface.call('FGUYMOD_SessionReturn') == true) {   // the movie came back after the match
        FGUYSessStage = 'started';
        FGUYSessionCheckReturn();
        return;
    }
    if (flash.external.ExternalInterface.call('FGUYMOD_SessionStarted') == true) {   // story co-op: back in the main
        FGUYSessStage = 'started';   //   menu after a quit - the players' own (no walking into the level again)
        FGUYSessLog('the main menu - the players\' (story co-op)');
        clearInterval(FGUYSessFrontTimer);   // (the host goes back to the lobby: everyone does - asked 4 times a second)
        FGUYSessFrontTimer = setInterval(FGUYSessFrontPoll, 250);
        return;
    }
    var parts = String(cfg).split('|');
    var c = parts[0].split(',');
    FGUYSess = {mode: c[0], map: c[1], time: Number(c[2]), score: Number(c[3]), ff: Number(c[4]), picks: []};
    var p = parts[1].split(';');
    for (var i = 0; i < p.length; i++) {
        var f = p[i].split(':');
        FGUYSess.picks.push({character: f[0], costume: f[1], team: Number(f[2])});
    }
    FGUYSessStage = 'boot';
    FGUYSessLog('session ' + cfg);
}

function FGUYSessFrontPoll() {
    if (FGUYSessReturning) { clearInterval(FGUYSessFrontTimer); return; }
    FGUYSessionCheckReturn();
}

function FGUYSessionCheckReturn() {
    if (flash.external.ExternalInterface.call('FGUYMOD_SessionReturn') != true) return;
    FGUYSessReturning = true;
    FGUYSessLog('the match is over - back to the lobby');
    FGUYReturnCoverShow();   // the game's own menus pass underneath meanwhile
    FGUYSessReturnWaits = 0;
    FGUYSessLastEnter = 0;
    FGUYSessReturnTimer = setInterval(FGUYSessGoOnline, 300);   // once the front end has settled
}

// "Back to the lobby": a full screen cover from the end of the match until the lobby (and its 3D camera)
// has settled - the game's own front end goes by underneath. FGUYReturnCoverCheck takes it away.
function FGUYReturnCoverShow() {
    if (FGUYC == undefined) FGUYColors();
    var c = _root.createEmptyMovieClip('FGUYReturnCover', 25000);
    var vr = Stage.visibleRect;
    var left = 0, width = 960;
    if (vr) { left = vr.x; width = vr.width; }
    c._x = left;
    c._xscale = width / 1600 * 100;
    c._yscale = 720 / 900 * 100;
    FGUYTextN = 0;
    FGUYRect(c, 0, 0, 1600, 900, 0, FGUYC.bg, 100, 0, 0, 0);
    FGUYTitle(c, 0, 370, 1600, 90, 'BACK TO THE LOBBY', 60, FGUYC.title, 'center');
    FGUYText(c, 0, 470, 1600, 40, 'One moment...', false, 24, FGUYC.soft, 'center');
    FGUYReturnCoverSince = FGUYNow();
    FGUYReturnCoverTimer = setInterval(FGUYReturnCoverCheck, 250);
}

// Away once we're in the lobby and its 3D camera has arrived (or after 25 s whatever happened).
function FGUYReturnCoverCheck() {
    var now = FGUYNow();
    // (or it won't: the lobby is gone - an error from the server)
    var arrived = FGUYOnline && FGUYS != undefined && (FGUYS.state == 'lobby' && now - FGUYEnteredAt > 2000 ||
        (FGUYS.state == 'online' || FGUYS.state == 'failed') && FGUYS.status != '');
    if (!arrived && now - FGUYReturnCoverSince < 25000) return;
    clearInterval(FGUYReturnCoverTimer);
    _root.FGUYReturnCover.removeMovieClip();
}

function FGUYSessGoOnline() {
    // Normally the player's own game (waiting hidden since the match started) takes over, back in the lobby,
    // and this one closes (the loader's hand-back). The lobby opens here only if that game isn't there.
    if (flash.external.ExternalInterface.call('FGUYMOD_SessionHandBack') > 0) return;
    // The front end walks back to its own page first (the multiplayer menus): opening ONLINE before it's done
    // gets ONLINE replaced by that page (its input then goes nowhere). And a page that's still sliding in has
    // the menu input locked (LockInput) - opening ONLINE then leaves it locked for good (UnlockInput restores
    // the "previous" state: locked; InputFlags 0 = locked). So: no new page for 1.5 s and the input unlocked
    // (at most 20 s). Counted in timer calls.
    FGUYSessReturnWaits = FGUYSessReturnWaits + 1;
    if ((InputFlags == 0 || FGUYSessReturnWaits - FGUYSessLastEnter < 5) && FGUYSessReturnWaits < 66) return;
    clearInterval(FGUYSessReturnTimer);
    if (FGUYOnline) return;
    // The session played in the game's keyboard / mouse mode (for keyboard players), which also made the
    // keyboard the menus' controller: back to this player's own controls, through the game's own switch.
    var keyboard = flash.external.ExternalInterface.call('FGUYMOD_SessionKeyboard') == true;
    flash.external.ExternalInterface.call('CTRL_SetKeyboardMouseInputEnabled', keyboard);
    flash.external.ExternalInterface.call('FGUYMOD_SessionControls', keyboard);
    getURL('FSCommand:CTRL_EnableButtonInput', '');   // the quit turned the buttons off (CTRL_DisableButtonInput)
    getURL('FSCommand:CTRL_ResetInput', '');
    getURL('FSCommand:CTRL_ClearInput', '');
    OnOnlineSelect();
}

// Real milliseconds: in a match copy getTimer() is off (its clock was the session's fixed one).
function FGUYNow() {
    return Number(flash.external.ExternalInterface.call('FGUYMOD_Now'));
}

function FGUYSessLog(text) {
    flash.external.ExternalInterface.call('FGUYMOD_SessionLog', text);
}

function FGUYPress(pad, button, delay) {
    flash.external.ExternalInterface.call('FGUYMOD_SessionPress', pad, button, delay);
}

// ---- boot: save slot -> main menu ---------------------------------------------------------------------------
function OnSessSaveSlotsEnter() {
    OnSaveSlotsEnter();
    if (FGUYSessStage != 'boot') return;
    FGUYSessLog('save slots');
    FGUYPress(0, 'a', 90);   // load the (host's) save in the first slot
}

function OnSessHomeEnter() {
    OnHomeEnter();
    if (FGUYSessStage != 'boot') return;
    FGUYSessStage = 'menu';
    if (FGUYSessAuto == 'online') {   // as a player would: down, down, A (ONLINE)
        FGUYSessStage = 'done';
        FGUYPress(0, 'down', 90);
        FGUYPress(0, 'down', 110);
        FGUYPress(0, 'a', 130);
        return;
    }
    if (FGUYSessAuto != undefined) { FGUYSessStage = 'done'; FGUYSessLog('at the main menu'); return; }
    FGUYSessLog('main menu - going to ' + FGUYSess.mode + ' ' + FGUYSess.map);
    if (FGUYSess.mode == 'ST') FGUYSessionStory();
    else OnMultiplayerSelect();
}

// ---- story co-op: straight into the level; the others drop in once it runs (the loader presses Start) -------
function FGUYSessionStory() {
    _root.MenuType = MENU_TYPE_SINGLE_PLAYER;
    SetNetworkEnabled(false);
    SetDesiredLevel(FGUYSess.map + 'XX');
    FGUYSessStage = 'started';
    flash.external.ExternalInterface.call('FGUYMOD_SessionLevel');   // the loader drops the others in
    LevelSelectConfirm(true);
}

// ---- multiplayer: mode -> rules -> join screen -> start ------------------------------------------------------
function OnSessMultiplayerModesEnter() {
    OnMultiplayerModesEnter();
    if (FGUYSessStage != 'menu') return;
    FGUYSessStage = 'modes';
    var m = FGUYSess.mode;
    if (m == 'HD') OnHordeSelect();
    else if (m == 'CF') OnCTFSelect();
    else if (m == 'IN') OnInvasionSelect();
    else OnDeathmatchSelect();
}

function OnSessMultiplayerEnter() {
    OnMultiplayerEnter();
    if (FGUYSessStage != 'modes') return;
    FGUYSessStage = 'rules';
    var at = 0;
    for (var i = 0; i < mapPrefixes.length; i++)   // entries look like 'AMX' (map + X), then 'random'
        if (String(mapPrefixes[i]).substr(0, 2) == FGUYSess.map) at = i;
    OnSelectMapValueChanged(at);
    OnTimeLimitValueChanged(FGUYSess.time);
    if (FGUYSess.mode == 'CF') OnFlagLimitValueChanged(FGUYSess.score);
    else if (FGUYSess.mode != 'HD') OnWinningScoreValueChanged(FGUYSess.score);
    OnFriendlyFireEnabledValueChanged(FGUYSess.ff);
    FGUYSessLog('rules set: level ' + DesiredLevel);
    OnMultiplayerNextButtonPressed();
}

function OnSessMultiplayerPrepEnter() {
    OnMultiplayerPrepEnter();
    if (FGUYSessStage != 'rules') return;
    FGUYSessStage = 'prep';
    FGUYSessLog('join screen');
    for (var i = 1; i < FGUYSess.picks.length; i++) FGUYPress(i, 'a', 30 + i * 30);   // everyone joins
    FGUYSessionCheckJoined();
}

function OnSessMultiplayerPrepPlayerJoined(playerIndex) {
    OnMultiplayerPrepPlayerJoined(playerIndex);
    FGUYSessionCheckJoined();
}

function FGUYSessionCheckJoined() {
    if (FGUYSessStage != 'prep') return;
    for (var i = 0; i < FGUYSess.picks.length; i++) if (!IsJoined(i)) return;
    FGUYSessStage = 'started';
    FGUYSessLog('everyone joined - starting');
    // everyone's lobby picks, as the join screen would have them
    for (var p = 0; p < FGUYSess.picks.length; p++) {
        var pick = FGUYSess.picks[p];
        var list = selectableCharacters[p], ci = 0;
        for (var k = 0; k < list.length; k++) if (list[k] == pick.character) ci = k;
        prepCharacter[p] = ci;
        var costumes = costumesInfo[GetCharacterIndex(list[ci])], co = 0;
        if (costumes != undefined)
            for (var q = 0; q < costumes.length; q++) if (String(costumes[q].CostumeIndex) == String(pick.costume)) co = q;
        prepCostume[p] = co;
        prepTeam[p] = pick.team == 1 ? TEAM_EVIL : TEAM_GOOD;
        prepState[p] = PREP_READY;
    }
    flash.external.ExternalInterface.call('FGUYMOD_SessionLevel');   // the level is launched (the loader's cue)
    MultiplayerStartGame();
}
