// Custom skins in the game's own skin pickers, offline (compiled into the main menu movie and the HUD: see
// tools/ui/make_menu_patch.py, make_hud_patch.py). Each custom skin (FGUYMOD_OfflineSkins - the skin packs here, the
// FGUY Cosmetics mod's too) is a skin of its own there, right after the outfit it goes on, with its own name and
// picture:
//   - Store > Costumes (the main menu: costumeInfo, fetched by RefreshCostumes) - the skin that outfit wears, as the
//     MODS page's ON (FGUYMOD_StoreSkinPick); hovering one shows it on the preview (menu player 2). A skin on an outfit
//     not bought yet is there too, at the outfit's price: buying it buys the outfit, and puts the skin on. More than its
//     8 rows scroll.
//   - Multiverse Madness' join screen (the main menu: costumesInfo / prepCostume) and the HUD's change character
//     screen (costumesInfo / costumeInfoIndex) - that player's skin (FGUYMOD_OfflineSkinPick), not the others'.
// A custom skin's entry is its outfit's (the same CostumeIndex: the game puts that outfit on) and the mod puts the
// skin on with it (src/loader/cosmetics.cpp OfflineSkins). Online none of this: skins are picked in the lobby.

// an outfit's picture when its entry names none (as the game's RefreshCostume does) - by character index
function FGUYCostumeDefaultPic(c) {
    var d = ['', 'Costume_StewieDefault.tif', 'Costume_BrianDefault.tif', 'Costume_PeterDefault.tif', 'Costume_LoisDefault.tif',
             'Costume_QuagmireDefault.tif', 'Costume_ChrisDefault.tif', 'Costume_ClevelandDefault.tif', 'Costume_WestDefault.tif',
             'Costume_MegDefault.tif', 'Costume_DeathDefault.tif'];
    return c >= 0 && c < d.length ? d[c] : '';
}

// which outfit an entry is (its picture's name: Costume_<Character><Outfit>.tif - the loader names a skin's outfit so)
function FGUYCostumeKey(entry, c) {
    if (entry == undefined) return '';
    var l = entry.LinkageID;
    return l != undefined && String(l) != '' ? String(l) : FGUYCostumeDefaultPic(c);
}

// the custom skins here: [{pic, file, name, icon}] (FGUYMOD_OfflineSkins: "pic~file~name~icon;...")
function FGUYSkinEntries() {
    var out = [];
    var s = flash.external.ExternalInterface.call('FGUYMOD_OfflineSkins');
    if (s == undefined) return out;
    var e = String(s).split(';');
    for (var i = 0; i < e.length; i++) {
        if (e[i] == '') continue;
        var f = e[i].split('~');
        if (f.length >= 4) out.push({pic: f[0], file: f[1], name: f[2], icon: f[3]});
    }
    return out;
}

function FGUYSkinsOnline() {
    return flash.external.ExternalInterface.call('FGUYMOD_OnlineMatch') == true;
}

// into one character's list of outfits (entries as the game makes them): each custom skin after its outfit - once.
// locked: also after outfits not bought yet, as they are (the Store: its price; buying it buys that outfit) - the skin
// had stayed out of sight, nothing said it needed the outfit
function FGUYAddSkins(list, c, skins, locked) {
    if (list == undefined || list.fguySkins == true) return;
    list.fguySkins = true;
    for (var k = list.length - 1; k >= 0; k--) {   // (from the end: what's inserted doesn't move what's left to do)
        var base = list[k];
        if (base.FGUYSkin != undefined || (base.IsBought == false && !locked)) continue;
        var key = FGUYCostumeKey(base, c), at = k + 1;
        for (var j = 0; j < skins.length; j++) {
            if (skins[j].pic != key) continue;
            list.splice(at, 0, {UIName: skins[j].name, CostumeIndex: base.CostumeIndex, IsBought: base.IsBought == false ? false : true,
                                LinkageID: base.LinkageID, Price: base.Price, UnlockStr: base.UnlockStr, FGUYSkin: skins[j].file,
                                FGUYIcon: skins[j].icon, FGUYPic: key});
            at++;
        }
    }
}

// the join screens' lists (costumesInfo: one per character index)
function FGUYAddAllSkins() {
    if (costumesInfo == undefined || costumesInfo.fguySkins == true || FGUYSkinsOnline()) return;
    costumesInfo.fguySkins = true;
    var skins = FGUYSkinEntries();
    for (var c = 0; c < costumesInfo.length; c++) FGUYAddSkins(costumesInfo[c], c, skins);
}

// A join screen's costume picture (SelectCharacter.container.costumeIcon, the game's bitmap): a custom skin's own
// picture in its place - the same size (the game's: 95% of a 256-tall picture, standing on y 248), centred
function FGUYCostumeOverlay(sc, entry) {
    if (sc == undefined || sc.container == undefined) return;
    var box = sc.container, icon = box.costumeIcon, mine = box.FGUYCostume;
    var url = entry != undefined && entry.FGUYIcon != undefined ? String(entry.FGUYIcon) : '';
    if (url == '') {
        if (mine != undefined) mine.removeMovieClip();
        if (icon != undefined) icon._visible = true;
        return;
    }
    if (mine == undefined || mine.url != url) {
        if (mine != undefined) mine.removeMovieClip();
        mine = box.createEmptyMovieClip('FGUYCostume', box.getNextHighestDepth());
        mine.url = url;
        mine.createEmptyMovieClip('pic', 1).loadMovie(url);
        mine.onEnterFrame = FGUYCostumeOverlayLoaded;
    }
    if (icon != undefined) icon._visible = false;
}

function FGUYCostumeOverlayLoaded() {
    var pic = this.pic;
    if (pic == undefined || !(pic._width > 0)) return;
    var s = 243 / pic._height;
    pic._xscale = s * 100;
    pic._yscale = s * 100;
    pic._x = -pic._width / 2;
    pic._y = 248 - pic._height;
    this.onEnterFrame = undefined;
}

// That player wears the skin of the entry shown (or none) - and, the first time a join screen shows them their
// outfit, shows the skin they wear with it (FGUYMOD_OfflineSkinFor): the index into the list to show
function FGUYJoinSkin(p, list, idx, c) {
    if (list == undefined || FGUYSkinsOnline()) return idx;
    if (FGUYJoinSynced == undefined) FGUYJoinSynced = [];
    if (FGUYJoinSynced[p] != true && list[idx] != undefined) {
        FGUYJoinSynced[p] = true;
        var base = idx;
        while (base > 0 && list[base].FGUYSkin != undefined) base--;
        var wears = String(flash.external.ExternalInterface.call('FGUYMOD_OfflineSkinFor', p, FGUYCostumeKey(list[base], c)));
        for (var k = base + 1; k < list.length && list[k].FGUYSkin != undefined; k++) if (list[k].FGUYSkin == wears) idx = k;
    }
    var e = list[idx];
    flash.external.ExternalInterface.call('FGUYMOD_OfflineSkinPick', p, e != undefined && e.FGUYSkin != undefined ? e.FGUYSkin : '-');
    return idx;
}

// ---- the main menu ----------------------------------------------------------------------------------------------
// Multiverse Madness' join screen: its RefreshCostume(player), wrapped (inserted at its start: this runs it, then
// the custom skin's part - true: done)
function FGUYPrepRefreshWrap(p) {
    if (FGUYPrepRefreshing == true) return false;
    FGUYAddAllSkins();
    var c = GetCharacterIndex(selectableCharacters[p][prepCharacter[p]]), list = costumesInfo[c];
    if (list != undefined) prepCostume[p] = FGUYJoinSkin(p, list, prepCostume[p], c);
    FGUYPrepRefreshing = true;
    RefreshCostume(p);
    FGUYPrepRefreshing = false;
    FGUYCostumeOverlay(GetPrepScreenMovieclip(p).SelectCharacter, list != undefined ? list[prepCostume[p]] : undefined);
    return true;
}

function FGUYPrepEnter() {   // (EnterCharacterPrep: the players' skins shown again from what they wear)
    FGUYJoinSynced = [];
}

// Store > Costumes: RefreshCostumes just fetched costumeInfo (this, inserted right after): the custom skins in it.
// Its 8 buttons show 8 rows: with more (custom skins; Stewie's and Brian's outfits once story mode has unlocked them -
// the game showed their first 8 only) the list scrolls - up / down past the first or last row, the mouse wheel, the
// arrows beside the rows. costumeInfo is the 8 shown (the game's buttons, CurBtn, buying all go by it), FGUYStoreAll
// the whole list, FGUYStoreTop the first shown.
function FGUYStoreAddSkins(c) {
    if (costumeInfo == undefined) return;
    if (!FGUYSkinsOnline()) FGUYAddSkins(costumeInfo, c, FGUYSkinEntries(), true);
    if (c != FGUYStoreChar) { FGUYStoreChar = c; FGUYStoreTop = 0; }
    FGUYStoreAll = costumeInfo.slice(0);
    var n = costumeInfo.length;
    if (FGUYStoreTop == undefined || FGUYStoreTop < 0) FGUYStoreTop = 0;
    if (FGUYStoreTop > Math.max(0, n - 8)) FGUYStoreTop = Math.max(0, n - 8);
    if (n <= 8) return;
    costumeInfo.splice(FGUYStoreTop + 8, n - FGUYStoreTop - 8);
    costumeInfo.splice(0, FGUYStoreTop);
}

// (Down / Up on the Store's costumes - the game calls these instead of moving itself)
function OnCostumesDownPressed() { FGUYStoreMove(1); }
function OnCostumesUpPressed() { FGUYStoreMove(-1); }

function FGUYStoreMove(d) {
    var n = costumeInfo == undefined ? 0 : costumeInfo.length, all = FGUYStoreAll;
    if (n == 0) return;
    if (all == undefined || all.length <= n || (d > 0 ? CurBtn < n - 1 : CurBtn > 0)) {   // (within the rows: as the game)
        if (d > 0) _NextBtn();
        else _PrevBtn();
        FGUYSound('nav');
        return;
    }
    var top = FGUYStoreTop + d, btn = CurBtn;
    if (top < 0) { top = all.length - n; btn = n - 1; }   // (round to the other end, as the game's rows go round)
    else if (top > all.length - n) { top = 0; btn = 0; }
    FGUYStoreGo(top, btn);
    FGUYSound('nav');
}

// the rows from `top` on, `btn` the one pointed at
function FGUYStoreGo(top, btn) {
    UnHover();
    FGUYStoreTop = top;
    CurBtn = btn;
    RefreshCostumes();
    Hover();
}

// by `by` rows (the wheel, the arrows): the same row pointed at
function FGUYStoreScroll(by) {
    if (FGUYStoreAll == undefined || costumeInfo == undefined) return;
    var top = Math.max(0, Math.min(FGUYStoreAll.length - costumeInfo.length, FGUYStoreTop + by));
    if (top == FGUYStoreTop) return;
    FGUYStoreGo(top, CurBtn);
    FGUYSound('nav');
}

// (10 times a second while the rows scroll) the mouse wheel
function FGUYStorePoll() {
    if (CurPage != 'Costumes' || FGUYStoreAll == undefined || FGUYStoreAll.length <= 8) {
        clearInterval(FGUYStoreTimer);
        FGUYStoreTimer = undefined;
        return;
    }
    var steps = Number(flash.external.ExternalInterface.call('FGUYMOD_MenuWheel'));
    if (steps != 0 && !isNaN(steps)) FGUYStoreScroll(-steps);
}

// the arrows beside the rows (more above / below: lit, a click scrolls) and which rows are shown
function FGUYStoreArrows(root) {
    if (root == undefined) return;
    var all = FGUYStoreAll, n = costumeInfo == undefined ? 0 : costumeInfo.length;
    if (all == undefined || all.length <= n || n == 0) {
        root.FGUYScroll.removeMovieClip();
        return;
    }
    if (FGUYC == undefined) FGUYColors();
    if (FGUYStoreTimer == undefined) {
        flash.external.ExternalInterface.call('FGUYMOD_MenuWheel');   // (turned before: not for this page)
        FGUYStoreTimer = setInterval(FGUYStorePoll, 100);
    }
    // (a row's bar: from 60 above its clip's origin to 18 above, ending about 400 right of it - its bounds take in
    //  the hover glow, far bigger)
    var first = root.Costume0, last = root['Costume' + (n - 1)];
    var s = 44, x = Math.round(first._x + 412), top = Math.round(first._y - 60), bottom = Math.round(last._y - 18);
    var ui = root.createEmptyMovieClip('FGUYScroll', 30999);
    var upOn = FGUYStoreTop > 0, downOn = FGUYStoreTop + n < all.length;
    FGUYStoreArrow(ui, x, top, s, -1, upOn);
    FGUYStoreArrow(ui, x, bottom - s, s, 1, downOn);
    var cx = x + s / 2, cy = top + s + 10;   // (which rows: a chip under the up arrow - the wall's light strip behind)
    FGUYRect(ui, cx - 56, cy, 112, 32, 10, FGUYC.ink, 85, FGUYC.rowLine, 100, 2);
    FGUYText(ui, cx - 56, cy + 3, 112, 28, (FGUYStoreTop + 1) + '-' + (FGUYStoreTop + n) + ' of ' + all.length, false, 18,
             FGUYC.white, 'center');
}

function FGUYStoreArrow(ui, x, y, s, d, on) {
    var c = ui.createEmptyMovieClip('arrow' + (d > 0 ? 'Down' : 'Up'), ui.getNextHighestDepth());
    FGUYRect(c, x, y, s, s, Math.round(s / 4), FGUYC.row, 90, on ? FGUYC.yellow : FGUYC.rowLine, 100, 2);
    var m = s / 4;
    if (d < 0) FGUYPoly(c, [x + s / 2, y + m, x + s - m, y + s - m * 1.3, x + m, y + s - m * 1.3], on ? FGUYC.yellow : FGUYC.rowLine, 100);
    else FGUYPoly(c, [x + m, y + m * 1.3, x + s - m, y + m * 1.3, x + s / 2, y + s - m], on ? FGUYC.yellow : FGUYC.rowLine, 100);
    c.fgBy = d;
    c.onRelease = FGUYStoreArrowPress;
}

function FGUYStoreArrowPress() {
    FGUYStoreScroll(this.fgBy);
}

// PurchaseCostume(yesPressed), at its start: it charges each row of the outfit bought - a custom skin's row is that
// outfit's too, so buying one charged its price once a row. Just the first row's price, then (the rows come again
// after: RefreshStorePage).
function FGUYStoreBuying(yes) {
    if (yes != true || costumeInfo == undefined) return;
    var first = true;
    for (var i = 0; i < costumeInfo.length; i++) {
        if (costumeInfo[i].CostumeIndex != costumeToPurchase) continue;
        if (!first) costumeInfo[i].Price = 0;
        first = false;
    }
}

// ...and RefreshCostumes wrapped (inserted at its start): after it, which button is worn - the custom skin the
// outfit wears, or the outfit itself (the game marks every entry of the outfit) - and the one pointed at on the
// preview, its custom skin too
function FGUYStoreRefreshWrap() {
    if (FGUYStoreRefreshing == true || FGUYSkinsOnline()) return false;
    FGUYStoreRefreshing = true;
    RefreshCostumes();
    FGUYStoreRefreshing = false;
    if (costumeInfo == undefined) return true;
    var c = GetDockCharacterIndex(), sel = GetSelectedCostume(c), root = GetCostumesRoot();
    if (FGUYStorePending != undefined) {   // (a skin's outfit bought from the skin's own button: that skin on now)
        for (var p = 0; p < costumeInfo.length; p++) {
            var pe = costumeInfo[p];
            if (pe.FGUYSkin != FGUYStorePending.file || pe.FGUYPic != FGUYStorePending.key || !IsCostumeBought(c, p)) continue;
            FGUYStorePending = undefined;
            flash.external.ExternalInterface.call('FGUYMOD_StoreSkinPick', pe.FGUYPic, pe.FGUYSkin);
            sel = GetSelectedCostume(c);
            break;
        }
    }
    for (var i = 0; i < costumeInfo.length && i < 8; i++) {
        var e = costumeInfo[i], b = root['Costume' + i].button;
        if (b == undefined || e.CostumeIndex != sel) continue;
        var wears = String(flash.external.ExternalInterface.call('FGUYMOD_StoreSkinOf', e.FGUYPic != undefined ? e.FGUYPic : FGUYCostumeKey(e, c)));
        var mine = e.FGUYSkin != undefined ? e.FGUYSkin == wears : wears == '';
        if (!mine) b.status.gotoAndStop('blank');
        if (i == CurBtn && !mine && IsCostumeBought(c, i)) b.gotoAndStop('up');
    }
    var cur = costumeInfo[CurBtn];
    flash.external.ExternalInterface.call('FGUYMOD_OfflineSkinPick', 2, cur != undefined && cur.FGUYSkin != undefined ? cur.FGUYSkin : '-');
    FGUYStoreArrows(root);
    return true;
}

// SelectCostume(index), at its start: picking a custom skin is that outfit's skin from now on (the outfit itself: none)
function FGUYStoreSelect(i) {
    if (costumeInfo == undefined || FGUYSkinsOnline()) return;
    var e = costumeInfo[i], c = GetDockCharacterIndex();
    if (e == undefined) return;
    var key = e.FGUYPic != undefined ? e.FGUYPic : FGUYCostumeKey(e, c);
    if (!IsCostumeBought(c, i)) {   // (the game offers to buy the outfit: a skin's button - that skin once it's bought)
        FGUYStorePending = e.FGUYSkin != undefined ? {file: e.FGUYSkin, key: key} : undefined;
        return;
    }
    FGUYStorePending = undefined;
    flash.external.ExternalInterface.call('FGUYMOD_StoreSkinPick', key, e.FGUYSkin != undefined ? e.FGUYSkin : '');
}

function FGUYStoreExit() {   // (OnCostumesExit: the preview back to what's picked; the rows from the top next time)
    FGUYStorePending = undefined;
    FGUYStoreChar = undefined;
    FGUYStoreAll = undefined;
    clearInterval(FGUYStoreTimer);
    FGUYStoreTimer = undefined;
    GetCostumesRoot().FGUYScroll.removeMovieClip();
    flash.external.ExternalInterface.call('FGUYMOD_OfflineSkinPick', 2, '');
}

// ---- the HUD ----------------------------------------------------------------------------------------------------
// The change character screen (the death menu): its RefreshCostume(player), wrapped like the join screen's
function FGUYHudRefreshWrap(p) {
    if (FGUYHudRefreshing == true) return false;
    FGUYAddAllSkins();
    var c = GetDesiredCharacter(p), list = costumesInfo[c];
    if (list != undefined && costumeInfoIndex[p] != undefined) costumeInfoIndex[p][c] = FGUYJoinSkin(p, list, costumeInfoIndex[p][c], c);
    FGUYHudRefreshing = true;
    RefreshCostume(p);
    FGUYHudRefreshing = false;
    FGUYCostumeOverlay(GetScreenMovieClip(p).SelectCharacter,
                       list != undefined && costumeInfoIndex[p] != undefined ? list[costumeInfoIndex[p][c]] : undefined);
    return true;
}

function FGUYHudEnter() {   // (OnCharacterSelectScreenEnter)
    FGUYJoinSynced = [];
}
