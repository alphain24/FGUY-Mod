// The online pause menu, drawn by the in-game HUD movie (hud.gfx, patched by tools/ui/make_hud_patch.py).
// The loader runs it (src/loader/onlinepause.cpp: input, choices, pausing once everyone has it open); this
// only draws what FGUYMOD_PauseMenu says, every frame, and quits the level when told to.
//   FGUYMOD_PauseMenu   -> "open|selected|host|open count|players|quit|settings|row|top|label~value~kind;..."
//   FGUYMOD_PauseCursor -> "x|y|show"   (x, y in 1/10000 of the screen)
// Item boxes are fractions of the screen - the loader hit-tests the mouse with the same numbers.

function FGUYPauseStart() {
    if (_root.FGUYPauseRunning) return;
    _root.FGUYPauseRunning = true;
    FGUYPauseLast = '';
    FGUYPauseQuitting = false;
    FGUYFitCount = 0;
    FGUYPauseTimer = setInterval(FGUYPausePoll, 33);
}

// Online the HUD is the 4-way split screen's on every PC (every player's menus run everywhere, as they must:
// src/loader/splitview.cpp); this PC shows only its own quarter, zoomed to the whole screen (a quarter has the
// screen's shape) - a hair more than 2x, so the split screen's dividing lines on the quarter's edges stay just
// outside. My elements then go where the single-player HUD has them, at its size (zoomed, the quarter's layout
// sat too far in and too small, the money counter at the bar's other end): FGUYHudScaleTable, per element
// [single-player scale / 4-way scale x, y, single-player x, y, how, outline offset x, y], from the movie's own
// placements and measured in the game (tools/ui/hudscale.py), plus the HUD's widescreen shift (FGUYHudShift).
// The other players' elements aren't drawn here (what reached over the edge of their quarter showed on mine).
// Our own pause menu is zoomed back (it's drawn in whole-screen units).
function FGUYHudScaleTable() {
    return FGUY_HUD_SCALES;
}

// Scales an element by sx, sy keeping the edge of what it draws that's nearest my quarter's corner in place (an
// element's own anchor can be far from what it draws: the score bar's is way below it). Nothing drawn (yet):
// around its anchor.
function FGUYHudRescale(c, sx, sy, qcx, qcy) {
    var b = c.getBounds(_root);
    c._xscale = c._xscale * sx;
    c._yscale = c._yscale * sy;
    if (b == undefined || b.xMax < b.xMin || b.yMax < b.yMin || b.xMax - b.xMin > 100000) return;
    var a = c.getBounds(_root);
    if ((b.xMin + b.xMax) / 2 < qcx) c._x += b.xMin - a.xMin;
    else c._x += b.xMax - a.xMax;
    if ((b.yMin + b.yMax) / 2 < qcy) c._y += b.yMin - a.yMin;
    else c._y += b.yMax - a.yMax;
}

// The HUD's own widescreen shift of an element in the single-player layout (ShiftWideScreenElements).
function FGUYHudShift(name) {
    if (!IsWidescreen()) return 0;
    for (var i = 0; i < WideScreenLeftList.length; i++) if (WideScreenLeftList[i] == name) return -ShiftAmount;
    for (var j = 0; j < WideScreenRightList.length; j++) if (WideScreenRightList[j] == name) return ShiftAmount;
    return 0;
}

function FGUYHudZoom() {
    var q = flash.external.ExternalInterface.call('FGUYMOD_HudZoom');
    if (q == undefined) return;   // (not our loader)
    q = Number(q);
    if (q < 0 || q > 3) {
        if (FGUYZoomed) {
            _root._x = 0;
            _root._y = 0;
            _root._xscale = 100;
            _root._yscale = 100;
            FGUYZoomed = false;
            FGUYHudWholeScreen(false);
        }
        return;
    }
    var z = 2.03;
    var r = FGUYPauseRect();
    var col = q % 2;
    var row = (q - col) / 2;
    var qcx = r.x + (col + 0.5) * r.w / 2;   // my quarter's centre
    var qcy = r.y + (row + 0.5) * r.h / 2;
    _root._xscale = 100 * z;
    _root._yscale = 100 * z;
    _root._x = r.x + r.w / 2 - z * qcx;
    _root._y = r.y + r.h / 2 - z * qcy;
    FGUYZoomed = true;
    if (FGUYHudScales == undefined) FGUYHudScales = FGUYHudScaleTable();
    var names = StageElementsList;
    if (names != undefined) {
        for (var i = 0; i < names.length; i++) {
            var ratio = FGUYHudScales[names[i]];
            for (var v = 0; v < 4; v++) {
                for (var p = 0; p < 4; p++) {
                    var c = _root[names[i] + '_' + v + '_4_' + p];
                    if (c == undefined) continue;
                    if (v != q) {
                        if (c._visible) c._visible = false;
                    } else if (c.fguyScaled == undefined) {   // (once: the HUD may animate it afterwards)
                        c.fguyScaled = true;
                        if (ratio == undefined) continue;
                        var kind = ratio[4];
                        if (kind == 3) {   // (the whole-screen frame: FGUYFitDamageFx fits it)
                            FGUYHudRescale(c, ratio[0] / z, ratio[1] / z, qcx, qcy);
                            continue;
                        }
                        if (kind == 2) continue;   // whole-screen pieces: the zoom alone makes them so
                        var tx = ratio[2] + FGUYHudShift(names[i]);
                        c._xscale = c._xscale * ratio[0] / z;
                        c._yscale = c._yscale * ratio[1] / z;
                        if (kind == 1) {   // by what it draws (its inner layout differs)
                            var b = c.getBounds(_root);
                            c._x += (tx + ratio[5] - _root._x) / z - b.xMin;
                            c._y += (ratio[3] + ratio[6] - _root._y) / z - b.yMin;
                        } else {
                            c._x = (tx - _root._x) / z;
                            c._y = (ratio[3] - _root._y) / z;
                        }
                    }
                }
            }
        }
    }
    FGUYHudWholeScreen(true);
    FGUYPauseUnzoom();
}

// The HUD's whole-screen pieces - not any player's (the announcements: "WELCOME TO MULTIVERSE MADNESS!",
// "ROUND 2"; the match timer, the tips box...): zoomed with my quarter they sat at the screen's bottom right, half
// off it (the whole screen's middle is my quarter's corner). Zoomed back to where and how big the HUD has them on
// the whole screen, every poll (as the pause menu); as they were when the zoom goes.
function FGUYHudWholeScreen(on) {
    var names = ['AnnounceText', 'Timer', 'challengeStats', 'topTextbox', 'Icon_Watermark', 'bruceBox'];
    var z = _root._xscale / 100;
    for (var i = 0; i < names.length; i++) {
        var c = _root[names[i]];
        if (c == undefined) continue;
        if (c.fguyX0 == undefined) {
            if (!on) continue;
            c.fguyX0 = c._x;
            c.fguyY0 = c._y;
            c.fguyXS0 = c._xscale;
            c.fguyYS0 = c._yscale;
        }
        if (on) {
            c._xscale = c.fguyXS0 / z;
            c._yscale = c.fguyYS0 / z;
            c._x = (c.fguyX0 - _root._x) / z;
            c._y = (c.fguyY0 - _root._y) / z;
        } else {
            c._xscale = c.fguyXS0;
            c._yscale = c.fguyYS0;
            c._x = c.fguyX0;
            c._y = c.fguyY0;
        }
    }
}

// Our pause menu is drawn in whole-screen units: zoomed back (here, and right after each redraw - a new menu
// showed zoomed into the quarter for a frame each time you moved in it).
function FGUYPauseUnzoom() {
    var ui = _root.FGUYPauseUI;
    if (ui == undefined || !FGUYZoomed) return;
    var z = _root._xscale / 100;
    ui._xscale = 100 / z;
    ui._yscale = 100 / z;
    ui._x = -_root._x / z;
    ui._y = -_root._y / z;
}

// Research (FGUYMOD_TEST_HUDDUMP=1): where the HUD's own layout has put every element, a second into the level.
function FGUYHudDump() {
    if (FGUYHudDumped != undefined || ++FGUYHudDumpWait < 30) return;
    FGUYHudDumped = true;
    if (flash.external.ExternalInterface.call('FGUYMOD_TestHudDump') != true) return;
    var dn = StageElementsList, dl = [0, 4];
    for (var di = 0; dn != undefined && di < dn.length; di++)
        for (var dv = 0; dv < 4; dv++)
            for (var dk = 0; dk < 2; dk++)
                for (var dp = 0; dp < 4; dp++) {
                    var k = dn[di] + '_' + dv + '_' + dl[dk] + '_' + dp;
                    var m = _root[k];
                    if (m == undefined) continue;
                    var b = m.getBounds(_root);
                    flash.external.ExternalInterface.call('FGUYMOD_HudDebug', 'clip ' + k + ' x/y/xs/ys/vis/bx/by/bx2/by2',
                        m._x, m._y, m._xscale, m._yscale, m._visible, b.xMin, b.yMin, b.xMax, b.yMax);
                }
}

function FGUYPausePoll() {
    if (FGUYHudDumpWait == undefined) FGUYHudDumpWait = 0;
    FGUYHudDump();
    FGUYHudZoom();
    if (++FGUYFitCount >= 15) {   // (twice a second: the HUD may have moved the damage frame again)
        FGUYFitCount = 0;
        FGUYFitDamageFx();
    }
    var s = flash.external.ExternalInterface.call('FGUYMOD_PauseMenu');
    if (s == undefined) return;   // not the loader we know (or offline): nothing to do
    s = String(s);
    var f = s.split('|');
    if (f[5] == '1' && !FGUYPauseQuitting) {   // back to the lobby: leave the level
        FGUYPauseQuitting = true;
        getURL('FSCommand:CTRL_DisableButtonInput', '');
        getURL('FSCommand:GAME_Quit', '');
        flash.external.ExternalInterface.call('FGUYMOD_PauseQuitDone');
    }
    if (s != FGUYPauseLast) {
        FGUYPauseLast = s;
        FGUYPauseDraw(f);
        FGUYPauseUnzoom();
    }
    var c = String(flash.external.ExternalInterface.call('FGUYMOD_PauseCursor')).split('|');
    var ui = _root.FGUYPauseUI;
    if (ui != undefined && ui.pointer != undefined) {
        var r = FGUYPauseRect();
        ui.pointer._visible = c[2] == '1';
        ui.pointer._x = r.x + Number(c[0]) / 10000 * r.w;
        ui.pointer._y = r.y + Number(c[1]) / 10000 * r.h;
    }
    FGUYDeathMouse();
}

// Online, my keyboard player's death menu takes the mouse: the game feeds the HUD no mouse in a match (and a click
// straight on a button would happen on this PC only - out of sync), so the loader gets where the buttons are on
// my screen and turns a click on one into its key in my input (Enter / X / Y: the match's input, every PC alike).
// Here: those boxes (1/10000 of the screen), and the pointer.
function FGUYDeathMouse() {
    if (FGUYMyPlayer == undefined || FGUYMyPlayer < 0) FGUYMyPlayer = Number(flash.external.ExternalInterface.call('FGUYMOD_MyPlayer'));
    var p = FGUYMyPlayer, boxes = '';
    var v = p >= 0 && PlayerViewportMapping != undefined ? PlayerViewportMapping[p] : undefined;
    var r = FGUYPauseRect();
    var layer = _root.FGUYMouseUI;
    var screen = v != undefined && CurScreen != undefined ? CurScreen[v] : undefined;
    var mouseScreen = (screen == 'DeathMenu' || screen == 'CharacterCustomize') && IsKeyboardEnabled(p);
    if (mouseScreen) {
        if (layer == undefined) {
            layer = _root.createEmptyMovieClip('FGUYMouseUI', 30001);
            FGUYPausePointer(layer, r.h / 720);
        }
        FGUYMouseUnzoom(layer);
    }
    // The weapons screen (from the death menu, or a store portal): the wheel - pointing at a weapon chooses it, a
    // click buys it. The loader turns that into the keys a keyboard player has for it (the direction on W A S D,
    // then X), so every PC chooses and buys alike. Its box: the wheel's spokes, the 6th field 1 (a wheel).
    if (mouseScreen && screen == 'CharacterCustomize') {
        var wb = undefined;
        for (var si = 0; si < 8; si++) {
            var spoke = GetSpokeFromSlot(p, si);
            if (spoke == undefined || !spoke._visible) continue;
            var sb = spoke.getBounds(layer);
            if (sb.xMax <= sb.xMin) continue;
            if (wb == undefined) wb = {xMin: sb.xMin, xMax: sb.xMax, yMin: sb.yMin, yMax: sb.yMax};
            else {
                wb.xMin = Math.min(wb.xMin, sb.xMin); wb.xMax = Math.max(wb.xMax, sb.xMax);
                wb.yMin = Math.min(wb.yMin, sb.yMin); wb.yMax = Math.max(wb.yMax, sb.yMax);
            }
        }
        if (wb != undefined)
            boxes = Math.round((wb.xMin - r.x) / r.w * 10000) + ',' + Math.round((wb.yMin - r.y) / r.h * 10000) + ',' +
                    Math.round((wb.xMax - r.x) / r.w * 10000) + ',' + Math.round((wb.yMax - r.y) / r.h * 10000) + ',88,1,' + Math.round(r.w / r.h * 1000) + ';';
    }
    if (mouseScreen && screen == 'DeathMenu') {
        var m = GetScreenMovieClip(p);
        var names = ['continueButton', 'characterSelectButton', 'weaponChangesButton'], keys = [13, 88, 89];
        var got = [], x0 = undefined, x1 = undefined;
        for (var i = 0; m != undefined && i < names.length; i++) {
            var b = m[names[i]];
            if (b == undefined || !b._visible) continue;
            var bb = b.getBounds(layer);
            if (bb.xMax <= bb.xMin) continue;
            got.push({y0: bb.yMin, y1: bb.yMax, x0: bb.xMin, x1: bb.xMax, key: keys[i]});
            if (keys[i] != 13) {   // (Continue's bounds hold our hint line, wider than the buttons)
                x0 = x0 == undefined ? bb.xMin : Math.min(x0, bb.xMin);
                x1 = x1 == undefined ? bb.xMax : Math.max(x1, bb.xMax);
            }
        }
        // The buttons are stacked, and each one's bounds reach over the next (its hidden pad icon): a button's box
        // ends where the next one's starts (the bottom one's: one step on).
        for (var j = 0; j < got.length; j++) {
            var e = got[j], below = undefined, above = undefined;
            for (var k = 0; k < got.length; k++) {
                if (got[k].y0 > e.y0 && (below == undefined || got[k].y0 < below)) below = got[k].y0;
                if (got[k].y0 < e.y0 && (above == undefined || got[k].y0 > above)) above = got[k].y0;
            }
            var y1 = e.y1;
            if (below != undefined) y1 = Math.min(y1, below);
            else if (above != undefined) y1 = Math.min(y1, e.y0 + (e.y0 - above));
            var bx0 = x0 == undefined ? e.x0 : x0, bx1 = x1 == undefined ? e.x1 : x1;
            boxes = boxes + Math.round((bx0 - r.x) / r.w * 10000) + ',' + Math.round((e.y0 - r.y) / r.h * 10000) + ',' +
                    Math.round((bx1 - r.x) / r.w * 10000) + ',' + Math.round((y1 - r.y) / r.h * 10000) + ',' + e.key + ';';
        }
    }
    if (boxes == '' && layer == undefined) return;   // (nothing to say: no menu of mine now, none before)
    var c = String(flash.external.ExternalInterface.call('FGUYMOD_DeathMouse', boxes)).split('|');
    if (layer == undefined) return;
    layer.pointer._visible = c[2] == '1';
    layer.pointer._x = r.x + Number(c[0]) / 10000 * r.w;
    layer.pointer._y = r.y + Number(c[1]) / 10000 * r.h;
    if (boxes == '') layer.removeMovieClip();
}

// The pointer's layer in whole-screen units, like the pause menu's (FGUYPauseUnzoom).
function FGUYMouseUnzoom(layer) {
    if (!FGUYZoomed) {
        layer._xscale = 100; layer._yscale = 100; layer._x = 0; layer._y = 0;
        return;
    }
    var z = _root._xscale / 100;
    layer._xscale = 100 / z;
    layer._yscale = 100 / z;
    layer._x = -_root._x / z;
    layer._y = -_root._y / z;
}

// The damage frame (Icon_DamageFx_<viewport>_<layout>_<player>: frost, fire, acid, electric, disintegrate) is
// drawn for the movie's 4:3 stage (960x720) and isn't in the HUD's widescreen list, so on a wider screen it
// covered only the middle. Stretched across the visible width, from where the movie put it (kept, so it's never
// stretched twice). Called when the HUD lays out, and twice a second (the HUD may move it again).
function FGUYFitDamageFx() {
    var r = FGUYPauseRect();
    var f = r.w / 960;
    var layouts = [0, 1, 2, 4];
    var test = flash.external.ExternalInterface.call('FGUYMOD_TestShowDamageFx') == true;
    for (var v = 0; v < 4; v++) {
        for (var l = 0; l < layouts.length; l++) {
            for (var p = 0; p < 4; p++) {
                var mc = _root['Icon_DamageFx_' + v + '_' + layouts[l] + '_' + p];
                if (mc == undefined) continue;
                if (mc.fguyX0 == undefined) {
                    mc.fguyX0 = mc._x;
                    mc.fguyXScale0 = mc._xscale;
                }
                mc._x = r.x + mc.fguyX0 * f;
                mc._xscale = mc.fguyXScale0 * f;
                if (test) {   // (test screenshots: show it - frost, half-way through)
                    mc._visible = true;
                    mc._alpha = 100;
                    mc.gotoAndStop(1);
                    mc.FX.gotoAndStop(44);
                    flash.external.ExternalInterface.call('FGUYMOD_HudDebug', 'dfx shown Icon_DamageFx_' + v + '_' + layouts[l] + '_' + p + ' x/xscale/x0', mc._x, mc._xscale, mc.fguyX0);
                }
            }
        }
    }
}

// Online, a keyboard player's death menu: which keys do what (Enter goes on, X / Y as on a controller - the
// loader turns the keyboard's X / Y / Backspace into the controller's X / Y / B there, kbm.cpp; a click on a
// button becomes its key: FGUYDeathMouse). The hint goes on the Continue button, so it comes and goes with the menu.
function FGUYDeathHints(playerIndex) {
    if (flash.external.ExternalInterface.call('FGUYMOD_OnlineMatch') != true) return;
    var m = GetScreenMovieClip(playerIndex);
    if (m == undefined || m.continueButton == undefined) return;
    var c = m.continueButton;
    if (!IsKeyboardEnabled(playerIndex)) {
        if (c.fguyHint != undefined) c.fguyHint._visible = false;
        return;
    }
    if (c.fguyHint == undefined)
        c.fguyHint = FGUYPauseText(c, -300, 34, 600, 30, 'ENTER  continue      X  change character      Y  change weapons',
                                   false, 16, 0xFFFFFF, 'center');
    c.fguyHint._visible = true;
}

// ...and on the screens behind it (change character, change weapons): there the game hides its controller help
// in keyboard mode (it's for the mouse there). Ours goes where that help is. which: 0 character, 1 weapons.
function FGUYNavHints(playerIndex, which) {
    if (flash.external.ExternalInterface.call('FGUYMOD_OnlineMatch') != true) return;
    var m = GetScreenMovieClip(playerIndex);
    if (m == undefined || m.navHelp == undefined) return;
    var name = which == 1 ? 'fguyHintWeapons' : 'fguyHintCharacter';
    if (!IsKeyboardEnabled(playerIndex)) {
        if (m[name] != undefined) m[name]._visible = false;
        return;
    }
    if (m[name] == undefined) {
        var b = m.navHelp.getBounds(m), y = b.yMin;
        var wheel = which == 1 ? GetWeaponWheel(playerIndex) : undefined;
        if (wheel != undefined) {   // (the weapons screen's help is inside the wheel: ours goes under it)
            var vb = undefined;   // (its spokes only: the clip holds hidden pieces far around it)
            for (var i = 0; i < 8; i++) {
                var c = GetSpokeFromSlot(playerIndex, i);
                if (c == undefined || !c._visible) continue;
                var cb = c.getBounds(m);
                if (cb.xMax <= cb.xMin) continue;
                if (vb == undefined) vb = {xMin: cb.xMin, xMax: cb.xMax, yMin: cb.yMin, yMax: cb.yMax};
                else {
                    vb.xMin = Math.min(vb.xMin, cb.xMin); vb.xMax = Math.max(vb.xMax, cb.xMax);
                    vb.yMin = Math.min(vb.yMin, cb.yMin); vb.yMax = Math.max(vb.yMax, cb.yMax);
                }
            }
            if (vb != undefined) {
                b = vb;
                y = b.yMax + 8;
            }
        }
        var str = which == 1 ? 'W A S D or point  choose      X or click  buy      ENTER  done      BACKSPACE  back'
                             : 'LEFT / RIGHT  character      UP / DOWN  costume      ENTER  pick      BACKSPACE  back';
        m[name] = FGUYPauseText(m, (b.xMin + b.xMax) / 2 - 400, y, 800, 30, str, false, 16, 0xFFFFFF, 'center');
    }
    m[name]._visible = true;
}

// Research (make_hud_patch.py --debug): a screen's own key handler ran - which key, for whom (where: 1 weapons, 2 death).
function FGUYKeyProbe(playerIndex, where) {
    FGUYKeyN = FGUYKeyN == undefined ? 1 : FGUYKeyN + 1;
    flash.external.ExternalInterface.call('FGUYMOD_HudDebug', 'key handler', where, playerIndex, Key.getCode(), FGUYKeyN,
        Number(flash.external.ExternalInterface.call('STOR_GetCurrency', playerIndex)), currentCustomizeSelection[playerIndex]);
}

function FGUYPauseRect() {   // the visible screen in stage units
    var vr = Stage.visibleRect;
    if (vr) return {x: vr.x, y: vr.y, w: vr.width, h: vr.height};
    return {x: 0, y: 0, w: 960, h: 720};
}

function FGUYPauseBox(mc, x, y, w, h, r, fill, alpha, line, lineAlpha, thick) {
    if (thick > 0) mc.lineStyle(thick, line, lineAlpha);
    else mc.lineStyle(undefined);
    mc.beginFill(fill, alpha);
    mc.moveTo(x + r, y);
    mc.lineTo(x + w - r, y);
    mc.curveTo(x + w, y, x + w, y + r);
    mc.lineTo(x + w, y + h - r);
    mc.curveTo(x + w, y + h, x + w - r, y + h);
    mc.lineTo(x + r, y + h);
    mc.curveTo(x, y + h, x, y + h - r);
    mc.lineTo(x, y + r);
    mc.curveTo(x, y, x + r, y);
    mc.endFill();
}

function FGUYPauseText(mc, x, y, w, h, str, display, size, color, align) {
    FGUYPauseN = FGUYPauseN + 1;
    var name = 't' + FGUYPauseN;
    mc.createTextField(name, mc.getNextHighestDepth(), x, y, w, h);
    var t = mc[name];
    t.embedFonts = true;
    t.selectable = false;
    var fmt = new TextFormat();
    fmt.font = display ? '$font_displayText' : '$font_bodyText';
    fmt.size = size;
    fmt.color = color;
    fmt.align = align;
    t.setNewTextFormat(fmt);
    t.text = str;
    t.setTextFormat(fmt);
    return t;
}

function FGUYPauseDraw(f) {
    _root.FGUYPauseUI.removeMovieClip();
    if (f[0] != '1') return;
    var ui = _root.createEmptyMovieClip('FGUYPauseUI', 30000);
    FGUYPauseN = 0;
    var r = FGUYPauseRect();
    var sel = Number(f[1]), host = f[2] == '1', open = Number(f[3]), players = Number(f[4]);
    var items = host ? ['RESUME', 'SETTINGS', 'QUIT TO LOBBY', 'QUIT WITH PARTY'] : ['RESUME', 'SETTINGS', 'QUIT TO LOBBY'];
    var bg = ui.createEmptyMovieClip('bg', 1);
    FGUYPauseBox(bg, r.x, r.y, r.w, r.h, 0, 0x000000, 45, 0, 0, 0);
    if (f[6] == '1') {
        FGUYPauseSettings(ui, bg, r, f);
        FGUYPausePointer(ui, r.h / 720);
        return;
    }
    var px = r.x + r.w * 0.32, pw = r.w * 0.36, py = r.y + r.h * 0.26, ph = r.h * (0.24 + items.length * 0.085);
    FGUYPauseBox(bg, px, py, pw, ph, 18, 0x13213C, 95, 0x2E5C9A, 100, 3);
    var size = r.h / 720;
    FGUYPauseText(ui, px, py + r.h * 0.03, pw, 50 * size, 'PAUSED', true, 38 * size, 0xF5D33A, 'center');
    FGUYPauseText(ui, px, py + r.h * 0.095, pw, 30 * size, 'The match goes on for the others', false, 15 * size, 0xBFD0EA, 'center');
    for (var i = 0; i < items.length; i++) {
        var iy = r.y + r.h * (0.40 + i * 0.085), ix = r.x + r.w * 0.36, iw = r.w * 0.28, ih = r.h * 0.07;
        if (i == sel) FGUYPauseBox(bg, ix, iy, iw, ih, 12, 0xF5D33A, 100, 0xFFFFFF, 100, 2);
        else FGUYPauseBox(bg, ix, iy, iw, ih, 12, 0x1C3156, 100, 0x2E5C9A, 100, 2);
        FGUYPauseText(ui, ix, iy + ih * 0.18, iw, ih, items[i], true, 22 * size, i == sel ? 0x1A1A1A : 0xFFFFFF, 'center');
    }
    var note = players > 1 ? 'The match pauses when everyone has this menu open (' + open + ' of ' + players + ')' : '';
    FGUYPauseText(ui, px, r.y + r.h * (0.42 + items.length * 0.085), pw, 26 * size, note, false, 13 * size, 0x9FB4D6, 'center');
    FGUYPausePointer(ui, size);
}

// The SETTINGS page: the rows shown (onlinepause.cpp keeps the same boxes for the mouse: rows from 0.215 down
// 0.054 apart, 0.048 high, 0.22..0.78 across; the value 0.52..0.76).
function FGUYPauseSettings(ui, bg, r, f) {
    var size = r.h / 720, row = Number(f[7]), top = Number(f[8]);
    var px = r.x + r.w * 0.2, pw = r.w * 0.6, py = r.y + r.h * 0.08, ph = r.h * 0.84;
    FGUYPauseBox(bg, px, py, pw, ph, 18, 0x13213C, 95, 0x2E5C9A, 100, 3);
    FGUYPauseText(ui, px, py + r.h * 0.015, pw, 46 * size, 'SETTINGS', true, 32 * size, 0xF5D33A, 'center');
    FGUYPauseText(ui, px, py + r.h * 0.075, pw, 24 * size, 'Yours only - the match goes on', false, 14 * size, 0xBFD0EA, 'center');
    var rows = f.length > 9 ? String(f[9]).split(';') : [];
    for (var k = 0; k < rows.length; k++) {
        if (rows[k] == '') continue;
        var cell = rows[k].split('~'), label = cell[0], value = cell[1], kind = cell[2], at = top + k;
        var ry = r.y + r.h * (0.215 + k * 0.054), rh = r.h * 0.048, rx = r.x + r.w * 0.22, rw = r.w * 0.56;
        var vx = r.x + r.w * 0.52, vw = r.w * 0.24, chosen = at == row;
        if (kind == 'h') {
            FGUYPauseText(ui, rx, ry + rh * 0.2, rw, rh, label, true, 18 * size, 0xF5D33A, 'left');
            continue;
        }
        if (kind == 'b') {
            var bx = r.x + r.w * 0.42, bw = r.w * 0.16;
            if (chosen) FGUYPauseBox(bg, bx, ry, bw, rh, 10, 0xF5D33A, 100, 0xFFFFFF, 100, 2);
            else FGUYPauseBox(bg, bx, ry, bw, rh, 10, 0x1C3156, 100, 0x2E5C9A, 100, 2);
            FGUYPauseText(ui, bx, ry + rh * 0.16, bw, rh, label, true, 17 * size, chosen ? 0x1A1A1A : 0xFFFFFF, 'center');
            continue;
        }
        if (kind != 'i') {
            if (chosen) FGUYPauseBox(bg, rx, ry, rw, rh, 10, 0x2A4A7E, 100, 0xF5D33A, 100, 2);
            else FGUYPauseBox(bg, rx, ry, rw, rh, 10, 0x1C3156, 100, 0x2E5C9A, 60, 1);
        }
        var dim = kind == 'i';
        FGUYPauseText(ui, rx + r.w * 0.02, ry + rh * 0.18, r.w * 0.28, rh, label, false, 15 * size, dim ? 0x9FB4D6 : 0xFFFFFF, 'left');
        var shown = value;   // (no '<' / '>' here: Scaleform takes them for HTML and shows nothing)
        if (kind == 's') shown = '-     ' + value + '%     +';
        else if (kind == 'c') shown = '-     ' + value + '     +';
        FGUYPauseText(ui, vx, ry + rh * 0.18, vw, rh, shown, false, (kind == 'i' ? 13 : 16) * size,
                      dim ? 0x9FB4D6 : (chosen ? 0xF5D33A : 0xFFFFFF), kind == 'i' ? 'right' : 'center');
    }
    FGUYPauseText(ui, px, r.y + r.h * 0.865, pw, 24 * size, 'Left / right: change     A / Enter: select     B / Esc: back',
                  false, 13 * size, 0x9FB4D6, 'center');
}

function FGUYPausePointer(ui, size) {
    var p = ui.createEmptyMovieClip('pointer', 100);   // keyboard / mouse players: a pointer
    p.lineStyle(1.5, 0x000000, 100);
    p.beginFill(0xFFFFFF, 100);
    p.moveTo(0, 0);
    p.lineTo(0, 18 * size);
    p.lineTo(5 * size, 13 * size);
    p.lineTo(9 * size, 21 * size);
    p.lineTo(12 * size, 19 * size);
    p.lineTo(8 * size, 12 * size);
    p.lineTo(14 * size, 12 * size);
    p.lineTo(0, 0);
    p.endFill();
    p._visible = false;
}
