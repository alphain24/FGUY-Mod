// The online pause menu, drawn by the in-game HUD movie (hud.gfx, patched by tools/ui/make_hud_patch.py).
// The loader runs it (src/loader/onlinepause.cpp: input, choices, pausing once everyone has it open); this
// only draws what FGUYMOD_PauseMenu says, every frame, and quits the level when told to.
//   FGUYMOD_PauseMenu   -> "open|selected|host|open count|players|quit|settings|row|top|label~value~kind;..."
//   FGUYMOD_PauseCursor -> "x|y|show"   (x, y in 1/10000 of the screen)
// Item boxes are fractions of the screen - the loader hit-tests the mouse with the same numbers.

function FGUYPauseStart() {
    if (_root.FGUYPauseRunning) return;
    _root.FGUYPauseRunning = true;
    FGUYPauseLast = '';
    FGUYPauseQuitting = false;
    FGUYFitCount = 0;
    FGUYPauseTimer = setInterval(FGUYPausePoll, 33);
    if (FGUYOrigEnableLocalInput == undefined && EnableLocalInput != undefined) {
        FGUYOrigEnableLocalInput = EnableLocalInput;
        EnableLocalInput = FGUYEnableLocalInput;
    }
    FGUYKeyWrap();
}

// The HUD's in-match menus (the store, the death menu's screens) hear keys through one Key listener, as
// onKeyDown(controller): its handlers take that as the player, and ask Key.getCode(player) for the key. The game
// gives every key of the keyboard as controller 0's - online a keyboard player in another slot couldn't leave the
// store (Backspace / Esc / Enter went to player 1's screens, and theirs saw no key). So a key that's a keyboard
// player's (FGUYMOD_KeyPlayer, from everyone's synced keys: the same on every PC) goes to their screens, and
// Key.getCode answers it for them while it does. The rest as it was. The listener is wrapped as the HUD makes it
// (EnableLocalInput, wrapped here) - and, for one made before, from the poll.
function FGUYEnableLocalInput(keyHandler, keyUpHandler) {
    var made = FGUYOrigEnableLocalInput(keyHandler, keyUpHandler);
    FGUYKeyWrap();
    return made;
}

function FGUYKeyPlayer(code) {   // (+4: give it as Enter - FGUYMOD_KeyPlayer)
    var p = Number(flash.external.ExternalInterface.call('FGUYMOD_KeyPlayer', code));
    return isNaN(p) ? -1 : p;
}

function FGUYKeyWrap() {
    if (Key.fguyGetCode == undefined) {
        Key.fguyGetCode = Key.getCode;
        Key.getCode = function (i) {
            if (FGUYKeyFor != undefined && FGUYKeyFor >= 0 && i == FGUYKeyFor) return FGUYKeyCode;
            return this.fguyGetCode(i);
        };
    }
    var l = KeyListener;
    if (l == undefined || l.fguyWrapped) return;
    l.fguyWrapped = true;
    l.fguyDown = l.onKeyDown;
    l.fguyUp = l.onKeyUp;
    l.onKeyDown = function (idx) {
        if (this.fguyDown == undefined) return;
        var code = Key.fguyGetCode(idx), p = FGUYKeyPlayer(code);
        if (p >= 4) {
            p -= 4;
            code = 13;
        }
        if (p < 0 || p == idx) {
            this.fguyDown(idx);
            return;
        }
        FGUYKeyFor = p;
        FGUYKeyCode = code;
        this.fguyDown(p);
        FGUYKeyFor = -1;
    };
    l.onKeyUp = function (idx) {
        if (this.fguyUp == undefined) return;
        var code = Key.fguyGetCode(idx), p = FGUYKeyPlayer(code);
        if (p >= 4) {
            p -= 4;
            code = 13;
        }
        if (p < 0 || p == idx) {
            this.fguyUp(idx);
            return;
        }
        FGUYKeyFor = p;
        FGUYKeyCode = code;
        this.fguyUp(p);
        FGUYKeyFor = -1;
    };
}

// Online the HUD is the 4-way split screen's on every PC (every player's menus run everywhere, as they must:
// src/loader/splitview.cpp); this PC shows only its own quarter, zoomed to the whole screen (a quarter has the
// screen's shape) - a hair more than 2x, so the split screen's dividing lines on the quarter's edges stay just
// outside. My elements then go where the single-player HUD has them, at its size (zoomed, the quarter's layout
// sat too far in and too small, the money counter at the bar's other end): FGUYHudScaleTable, per element
// [single-player scale / 4-way scale x, y, single-player x, y, how, outline offset x, y], from the movie's own
// placements and measured in the game (tools/ui/hudscale.py), plus the HUD's widescreen shift (FGUYHudShift).
// The other players' elements aren't drawn here (what reached over the edge of their quarter showed on mine).
// Our own pause menu is zoomed back (it's drawn in whole-screen units).
function FGUYHudScaleTable() {
    return FGUY_HUD_SCALES;
}

// Scales an element by sx, sy keeping the edge of what it draws that's nearest my quarter's corner in place (an
// element's own anchor can be far from what it draws: the score bar's is way below it). Nothing drawn (yet):
// around its anchor.
function FGUYHudRescale(c, sx, sy, qcx, qcy) {
    var b = c.getBounds(_root);
    c._xscale = c._xscale * sx;
    c._yscale = c._yscale * sy;
    if (b == undefined || b.xMax < b.xMin || b.yMax < b.yMin || b.xMax - b.xMin > 100000) return;
    var a = c.getBounds(_root);
    if ((b.xMin + b.xMax) / 2 < qcx) c._x += b.xMin - a.xMin;
    else c._x += b.xMax - a.xMax;
    if ((b.yMin + b.yMax) / 2 < qcy) c._y += b.yMin - a.yMin;
    else c._y += b.yMax - a.yMax;
}

// The HUD's own widescreen shift of an element in the single-player layout (ShiftWideScreenElements).
function FGUYHudShift(name) {
    if (!IsWidescreen()) return 0;
    for (var i = 0; i < WideScreenLeftList.length; i++) if (WideScreenLeftList[i] == name) return -ShiftAmount;
    for (var j = 0; j < WideScreenRightList.length; j++) if (WideScreenRightList[j] == name) return ShiftAmount;
    return 0;
}

// The sniper rifle's / rail gun's scope (frames: 1 SniperRifle43, 2 RailGun43, 3 / 4 their Widescreen, 5 / 6 their
// Widescreen1680 - for 16:10): a split screen's quarter has the 4:3 one, and placed like the other whole-screen pieces
// it was a small box in one corner (Brian's rail gun). So mine takes the one for this screen's shape, and is fitted to
// cover the screen - evenly (the lens stays round), centred on it.
function FGUYScopeFrame(c, r) {
    var f = c._currentframe;
    if (f == 1 || f == 2) {
        var aspect = r.w / r.h;
        if (aspect >= 1.7) c.gotoAndStop(f + 2);
        else if (aspect >= 1.45) c.gotoAndStop(f + 4);
    }
    if (!c._visible) return;
    var b = c.getBounds(_root);
    var bw = b.xMax - b.xMin, bh = b.yMax - b.yMin;
    if (b == undefined || !(bw > 1) || !(bh > 1) || bw > 100000) return;
    var z = _root._xscale / 100;
    var tw = r.w / z, th = r.h / z;   // (the screen, in my zoomed HUD's units)
    var tx = (r.x + r.w / 2 - _root._x) / z, ty = (r.y + r.h / 2 - _root._y) / z;
    var k = Math.max(tw / bw, th / bh);
    if (Math.abs(k - 1) > 0.005) {
        c._xscale = c._xscale * k;
        c._yscale = c._yscale * k;
        b = c.getBounds(_root);
    }
    var dx = tx - (b.xMin + b.xMax) / 2, dy = ty - (b.yMin + b.yMax) / 2;
    if (Math.abs(dx) > 0.5 || Math.abs(dy) > 0.5) {
        c._x += dx;
        c._y += dy;
    }
}

function FGUYHudZoom() {
    var q = flash.external.ExternalInterface.call('FGUYMOD_HudZoom');
    if (q == undefined) return;   // (not our loader)
    q = Number(q);
    if (q < 0 || q > 3) {
        if (FGUYZoomed) {
            _root._x = 0;
            _root._y = 0;
            _root._xscale = 100;
            _root._yscale = 100;
            FGUYZoomed = false;
            FGUYHudWholeScreen(false);
        }
        return;
    }
    var z = 2.03;
    var r = FGUYPauseRect();
    var col = q % 2;
    var row = (q - col) / 2;
    var qcx = r.x + (col + 0.5) * r.w / 2;   // my quarter's centre
    var qcy = r.y + (row + 0.5) * r.h / 2;
    _root._xscale = 100 * z;
    _root._yscale = 100 * z;
    _root._x = r.x + r.w / 2 - z * qcx;
    _root._y = r.y + r.h / 2 - z * qcy;
    FGUYZoomed = true;
    if (FGUYHudScales == undefined) FGUYHudScales = FGUYHudScaleTable();
    var names = StageElementsList;
    if (names != undefined) {
        for (var i = 0; i < names.length; i++) {
            var ratio = FGUYHudScales[names[i]];
            for (var v = 0; v < 4; v++) {
                for (var p = 0; p < 4; p++) {
                    var c = _root[names[i] + '_' + v + '_4_' + p];
                    if (c == undefined) continue;
                    if (v == q && names[i] == 'Icon_Scope') FGUYScopeFrame(c, r);
                    if (v != q) {
                        if (c._visible) c._visible = false;
                    } else if (c.fguyScaled == undefined) {   // (once: the HUD may animate it afterwards)
                        c.fguyScaled = true;
                        if (ratio == undefined) continue;
                        var kind = ratio[4];
                        if (kind == 3) {   // (the whole-screen frame: FGUYFitDamageFx fits it)
                            FGUYHudRescale(c, ratio[0] / z, ratio[1] / z, qcx, qcy);
                            continue;
                        }
                        // (kind 2, whole-screen pieces - the scoreboard, the scope, the curtain: placed as single
                        //  player has them too. The zoom alone left them where the 4-way layout centres them in a 4:3
                        //  quarter - on a widescreen, a fifth of the screen to the right: the scoreboard ran off it)
                        var tx = ratio[2] + FGUYHudShift(names[i]);
                        c._xscale = c._xscale * ratio[0] / z;
                        c._yscale = c._yscale * ratio[1] / z;
                        if (kind == 1) {   // by what it draws (its inner layout differs)
                            var b = c.getBounds(_root);
                            c._x += (tx + ratio[5] - _root._x) / z - b.xMin;
                            c._y += (ratio[3] + ratio[6] - _root._y) / z - b.yMin;
                        } else {
                            c._x = (tx - _root._x) / z;
                            c._y = (ratio[3] - _root._y) / z;
                        }
                    }
                }
            }
        }
    }
    FGUYHudWholeScreen(true);
    FGUYPauseUnzoom();
}

// The HUD's whole-screen pieces - not any player's (the announcements: "WELCOME TO MULTIVERSE MADNESS!",
// "ROUND 2"; the match timer, the tips box...): zoomed with my quarter they sat at the screen's bottom right, half
// off it (the whole screen's middle is my quarter's corner). Zoomed back to where and how big the HUD has them on
// the whole screen, every poll (as the pause menu); as they were when the zoom goes.
function FGUYHudWholeScreen(on) {
    var names = ['AnnounceText', 'Timer', 'challengeStats', 'topTextbox', 'Icon_Watermark', 'bruceBox'];
    var z = _root._xscale / 100;
    for (var i = 0; i < names.length; i++) {
        var c = _root[names[i]];
        if (c == undefined) continue;
        if (c.fguyX0 == undefined) {
            if (!on) continue;
            c.fguyX0 = c._x;
            c.fguyY0 = c._y;
            c.fguyXS0 = c._xscale;
            c.fguyYS0 = c._yscale;
            if (names[i] == 'Timer') {   // (the 4-way layout moves the timer to the screen's middle: single player's
                var at = FGUY_TIMER_AT;  //  spot instead, from the movie - top centre)
                c.fguyX0 = at[0];
                c.fguyY0 = at[1];
                c.fguyXS0 = at[2];
                c.fguyYS0 = at[3];
            }
        }
        if (on) {
            c._xscale = c.fguyXS0 / z;
            c._yscale = c.fguyYS0 / z;
            c._x = (c.fguyX0 - _root._x) / z;
            c._y = (c.fguyY0 - _root._y) / z;
        } else {
            c._xscale = c.fguyXS0;
            c._yscale = c.fguyYS0;
            c._x = c.fguyX0;
            c._y = c.fguyY0;
        }
    }
}

// Our pause menu is drawn in whole-screen units: zoomed back (here, and right after each redraw - a new menu
// showed zoomed into the quarter for a frame each time you moved in it).
function FGUYPauseUnzoom() {
    var ui = _root.FGUYPauseUI;
    if (ui == undefined || !FGUYZoomed) return;
    var z = _root._xscale / 100;
    ui._xscale = 100 / z;
    ui._yscale = 100 / z;
    ui._x = -_root._x / z;
    ui._y = -_root._y / z;
}

// Research (FGUYMOD_TEST_HUDDUMP=1): where the HUD's own layout has put every element, a second into the level.
function FGUYHudDump() {
    if (FGUYHudDumped != undefined || ++FGUYHudDumpWait < 30) return;
    FGUYHudDumped = true;
    if (flash.external.ExternalInterface.call('FGUYMOD_TestHudDump') != true) return;
    var dn = StageElementsList, dl = [0, 4];
    for (var di = 0; dn != undefined && di < dn.length; di++)
        for (var dv = 0; dv < 4; dv++)
            for (var dk = 0; dk < 2; dk++)
                for (var dp = 0; dp < 4; dp++) {
                    var k = dn[di] + '_' + dv + '_' + dl[dk] + '_' + dp;
                    var m = _root[k];
                    if (m == undefined) continue;
                    var b = m.getBounds(_root);
                    flash.external.ExternalInterface.call('FGUYMOD_HudDebug', 'clip ' + k + ' x/y/xs/ys/vis/bx/by/bx2/by2',
                        m._x, m._y, m._xscale, m._yscale, m._visible, b.xMin, b.yMin, b.xMax, b.yMax);
                }
}

// Test (FGUYMOD_TEST_ANNOUNCE=1): ten seconds in, the "ready" announcement (=2: the Ready screen between Multiverse
// Madness waves), and where it is on the screen.
function FGUYTestAnnounce() {
    if (FGUYTestAnnWait == undefined) {
        FGUYTestAnnKind = Number(flash.external.ExternalInterface.call('FGUYMOD_TestAnnounce'));
        FGUYTestAnnWait = FGUYTestAnnKind > 0 ? 300 : -1;
        FGUYTestAnnLog = 0;
    }
    if (FGUYTestAnnWait > 0) {
        FGUYTestAnnWait = FGUYTestAnnWait - 1;
        if (FGUYTestAnnWait == 0) {
            if (FGUYTestAnnKind == 2) PushScreen(Math.max(0, Number(flash.external.ExternalInterface.call('FGUYMOD_MyPlayer'))), 'Ready');
            else AnnounceReady();
        }
        return;
    }
    if (FGUYTestAnnWait != 0 || FGUYTestAnnLog > 240) return;
    FGUYTestAnnLog = FGUYTestAnnLog + 1;
    if (FGUYTestAnnLog % 30 != 1) return;
    var r = FGUYPauseRect(), lay = [0, 4], els = ['Announcement_Text', 'MP_Character_Screen'];
    for (var v = 0; v < 2; v++)
        for (var l = 0; l < 2; l++)
            for (var p = 0; p < 2; p++) {
              for (var e = 0; e < 2; e++) {
                var m = _root[els[e] + '_' + v + '_' + lay[l] + '_' + p];
                if (m == undefined || !m._visible) continue;
                var b = m.getBounds(_root);
                var zx = _root._xscale / 100;
                flash.external.ExternalInterface.call('FGUYMOD_HudDebug', els[e] + ' ' + v + '_' + lay[l] + '_' + p +
                    ' x/xs/screen x0 x1 (of ' + Math.round(r.w) + ', from ' + Math.round(r.x) + ')', m._x, m._xscale,
                    Math.round(_root._x + b.xMin * zx - r.x), Math.round(_root._x + b.xMax * zx - r.x));
              }
            }
}

// Online: the other players' pings, small at the top right of the screen (SETTINGS > Show ping), twice a second.
function FGUYPingPoll() {
    FGUYPingWait = FGUYPingWait == undefined ? 0 : FGUYPingWait - 1;
    if (FGUYPingWait > 0) return;
    FGUYPingWait = 15;
    var s = flash.external.ExternalInterface.call('FGUYMOD_NetStats');
    if (s == undefined) return;   // (not our loader)
    s = String(s);
    if (s == FGUYPingLast && _root.FGUYPingUI != undefined) { FGUYMouseUnzoom(_root.FGUYPingUI); return; }
    FGUYPingLast = s;
    _root.FGUYPingUI.removeMovieClip();
    if (s == '') return;
    var ui = _root.createEmptyMovieClip('FGUYPingUI', 29990);
    var r = FGUYPauseRect(), size = r.h / 720, parts = s.split('|');
    FGUYPauseN = 0;
    for (var i = 0; i < parts.length; i++) {
        var f = parts[i].split(':'), ms = Number(f[1]);
        var color = ms < 0 ? 0x9FB4D6 : (ms < 80 ? 0x7CE07C : (ms < 150 ? 0xF5D33A : 0xFF7B6B));
        FGUYPauseText(ui, r.x + r.w - 260 * size, r.y + (6 + i * 18) * size, 250 * size, 20 * size,
                      f[0] + '  ' + (ms < 0 ? '-' : ms + ' ms'), false, 13 * size, color, 'right');
    }
    FGUYMouseUnzoom(ui);
}

// Online, dead in Multiverse Madness: whose view this PC shows now (splitview.cpp spectates a teammate).
function FGUYSpectatePoll() {
    if (FGUYPingWait != 15) return;   // (with the pings, twice a second)
    var who = flash.external.ExternalInterface.call('FGUYMOD_Spectating');
    if (who == undefined) return;
    who = String(who);
    if (who == FGUYSpecLast && (who == '' || _root.FGUYSpecUI != undefined)) {
        if (_root.FGUYSpecUI != undefined) FGUYMouseUnzoom(_root.FGUYSpecUI);
        return;
    }
    FGUYSpecLast = who;
    _root.FGUYSpecUI.removeMovieClip();
    if (who == '') return;
    var ui = _root.createEmptyMovieClip('FGUYSpecUI', 29991);
    var r = FGUYPauseRect(), size = r.h / 720;
    FGUYPauseN = 0;
    FGUYPauseBox(ui, r.x + r.w * 0.35, r.y + r.h * 0.03, r.w * 0.3, r.h * 0.05, 10, 0x13213C, 80, 0x2E5C9A, 100, 2);
    FGUYPauseText(ui, r.x + r.w * 0.35, r.y + r.h * 0.037, r.w * 0.3, r.h * 0.045, 'SPECTATING  ' + who, true, 16 * size,
                  0xF5D33A, 'center');
    FGUYMouseUnzoom(ui);
}

function FGUYPausePoll() {
    // (the game hides the HUD for cutscenes: then, and in the menus, the frame rate stays at 60 at most - d3d9.cpp)
    flash.external.ExternalInterface.call('FGUYMOD_HudShown', Visible == false ? 0 : 1);
    FGUYTestAnnounce();
    FGUYPingPoll();
    FGUYSpectatePoll();
    FGUYEmotePoll();
    if (FGUYHudDumpWait == undefined) FGUYHudDumpWait = 0;
    FGUYHudDump();
    FGUYHudZoom();
    FGUYKeyWrap();
    if (++FGUYFitCount >= 15) {   // (twice a second: the HUD may have moved the damage frame again - and a skin worn
        FGUYFitCount = 0;         //  may have come since: its head)
        FGUYFitDamageFx();
        for (var hp = 0; hp < 4; hp++) FGUYHeadIcon(hp);
    }
    var s = flash.external.ExternalInterface.call('FGUYMOD_PauseMenu');
    if (s == undefined) return;   // not the loader we know (or offline): nothing to do
    s = String(s);
    var f = s.split('|');
    if (f[5] == '1' && !FGUYPauseQuitting) {   // back to the lobby: leave the level
        FGUYPauseQuitting = true;
        getURL('FSCommand:CTRL_DisableButtonInput', '');
        getURL('FSCommand:GAME_Quit', '');
        flash.external.ExternalInterface.call('FGUYMOD_PauseQuitDone');
    }
    if (s != FGUYPauseLast) {
        FGUYPauseLast = s;
        FGUYPauseDraw(f);
        FGUYPauseUnzoom();
    }
    var c = String(flash.external.ExternalInterface.call('FGUYMOD_PauseCursor')).split('|');
    var ui = _root.FGUYPauseUI;
    if (ui != undefined && ui.pointer != undefined) {
        var r = FGUYPauseRect();
        ui.pointer._visible = c[2] == '1';
        ui.pointer._x = r.x + Number(c[0]) / 10000 * r.w;
        ui.pointer._y = r.y + Number(c[1]) / 10000 * r.h;
    }
    FGUYDeathMouse();
}

// The HUD's head (its SetHeadIcon - and twice a second, from the poll): a player wearing a skin that has a head picture
// (FGUYMOD_HeadIcon - src/loader/icons.cpp makes the movie it loads) shows that in place of the character's drawn head,
// as big and where it was. A skin without one, or none: the game's own again.
function FGUYHeadIcon(p) {
    var v = PlayerViewportMapping != undefined ? PlayerViewportMapping[p] : undefined;
    if (v == undefined) return;
    var bar = _root['Icon_Lifebar' + GetObjectPath(v, p)];
    if (bar == undefined || bar.PlayerHead == undefined) return;
    var url = String(flash.external.ExternalInterface.call('FGUYMOD_HeadIcon', p));
    var head = bar.PlayerHead, mine = bar.FGUYHead;
    if (url == '' || url == 'undefined' || url == 'null') {
        if (mine != undefined) mine.removeMovieClip();
        head._visible = true;
        return;
    }
    if (mine == undefined || mine.url != url) {
        if (mine != undefined) mine.removeMovieClip();
        head._visible = true;   // (its place and size: while it shows)
        var b = head.getBounds(bar);
        mine = bar.createEmptyMovieClip('FGUYHead', bar.getNextHighestDepth());
        mine.url = url;
        mine.box = [b.xMin, b.yMin, b.xMax - b.xMin, b.yMax - b.yMin];
        mine.createEmptyMovieClip('pic', 1).loadMovie(url);
    }
    var pic = mine.pic, box = mine.box;   // (the picture: once loaded, about the head's size, on its box's bottom - a hat
    if (pic == undefined || !(pic._width > 0)) return;   //  stands up out of it)
    var s = Math.min(box[2] / (pic._width / pic._xscale * 100), box[3] / (pic._height / pic._yscale * 100)) * 1.2;
    pic._xscale = s * 100;
    pic._yscale = s * 100;
    pic._x = box[0] + (box[2] - pic._width) / 2;
    pic._y = box[1] + box[3] - pic._height;
    head._visible = false;
}

// The emote wheel (src/loader/emotes.cpp: held BACK / B), over the HUD - what FGUYMOD_EmoteWheel says, drawn again
// when it changes: "1|selected|page|pages|by (1 controller, 2 keyboard)|name~name~..." or "0" (closed).
function FGUYEmotePoll() {
    var s = flash.external.ExternalInterface.call('FGUYMOD_EmoteWheel');
    if (s == undefined) return;   // (not the loader we know)
    s = String(s);
    if (s == FGUYEmoteLast) return;
    FGUYEmoteLast = s;
    _root.FGUYEmoteUI.removeMovieClip();
    var f = s.split('|');
    if (f[0] != '1') return;
    var ui = _root.createEmptyMovieClip('FGUYEmoteUI', 29990);
    FGUYPauseN = 0;   // (FGUYPauseText's field names count from it - offline nothing else set it yet)
    var r = FGUYPauseRect(), size = r.h / 720;
    var names = f[5].split('~'), n = names.length, sel = Number(f[1]), page = Number(f[2]), pages = Number(f[3]);
    var cx = r.x + r.w / 2, cy = r.y + r.h * 0.48, R = r.h * 0.3, R0 = R * 0.36;
    var bg = ui.createEmptyMovieClip('bg', 1), tx = ui.createEmptyMovieClip('txt', 2);   // (the words above the wheel)
    FGUYPauseBox(bg, r.x, r.y, r.w, r.h, 0, 0x000000, 30, 0, 0, 0);
    var step = Math.PI * 2 / n;
    for (var k = 0; k < n; k++) {   // (a slice an emote: the first at the top, then clockwise)
        var on = k == sel;
        FGUYEmoteSlice(bg, cx, cy, R0, R, (k - 0.5) * step, (k + 0.5) * step, on ? 0xF5D33A : 0x13213C, on ? 100 : 88,
                       on ? 0xFFFFFF : 0x2E5C9A);
        var ta = k * step, tr = (R0 + R) / 2, tw = R * 0.62;
        FGUYPauseText(tx, cx + Math.sin(ta) * tr - tw / 2, cy - Math.cos(ta) * tr - 18 * size, tw, 50 * size, names[k], true,
                      16 * size, on ? 0x1A1A1A : 0xFFFFFF, 'center', true);
    }
    FGUYEmoteSlice(bg, cx, cy, 0, R0 * 0.92, 0, Math.PI * 2, 0x0B1730, 92, 0x2E5C9A);
    FGUYPauseText(tx, cx - R0, cy - 20 * size, R0 * 2, 30 * size, 'EMOTES', true, 22 * size, 0xF5D33A, 'center');
    if (pages > 1) FGUYPauseText(tx, cx - R0, cy + 8 * size, R0 * 2, 24 * size, (page + 1) + ' / ' + pages, false, 15 * size, 0xBFD0EA, 'center');
    var hint = f[4] == '1' ? 'Left stick: pick  -  let go of BACK to play' + (pages > 1 ? '  -  LB / RB: more' : '')
                           : 'Mouse: pick  -  let go of B to play' + (pages > 1 ? '  -  mouse wheel: more' : '');
    FGUYPauseText(tx, r.x, cy + R + 14 * size, r.w, 30 * size, hint, false, 16 * size, 0xFFFFFF, 'center');
}

// a ring's slice from angle a0 to a1 (0 = up, clockwise), radius r0 to r1 (r0 0: to the middle)
function FGUYEmoteSlice(mc, cx, cy, r0, r1, a0, a1, fill, alpha, line) {
    mc.lineStyle(2, line, 100);
    mc.beginFill(fill, alpha);
    var steps = Math.max(2, Math.ceil((a1 - a0) / 0.08));
    for (var i = 0; i <= steps; i++) {
        var a = a0 + (a1 - a0) * i / steps;
        if (i == 0) mc.moveTo(cx + Math.sin(a) * r1, cy - Math.cos(a) * r1);
        else mc.lineTo(cx + Math.sin(a) * r1, cy - Math.cos(a) * r1);
    }
    for (var j = steps; j >= 0 && r0 > 0; j--) {   // (r0 0: a disc - no line to the middle)
        var b = a0 + (a1 - a0) * j / steps;
        mc.lineTo(cx + Math.sin(b) * r0, cy - Math.cos(b) * r0);
    }
    mc.endFill();
}

// Online, my keyboard player's death menu takes the mouse: the game feeds the HUD no mouse in a match (and a click
// straight on a button would happen on this PC only - out of sync), so the loader gets where the buttons are on
// my screen and turns a click on one into its key in my input (Enter / X / Y: the match's input, every PC alike).
// Here: those boxes (1/10000 of the screen), and the pointer.
function FGUYDeathMouse() {
    if (FGUYMyPlayer == undefined || FGUYMyPlayer < 0) FGUYMyPlayer = Number(flash.external.ExternalInterface.call('FGUYMOD_MyPlayer'));
    var p = FGUYMyPlayer, boxes = '';
    var v = p >= 0 && PlayerViewportMapping != undefined ? PlayerViewportMapping[p] : undefined;
    var r = FGUYPauseRect();
    var layer = _root.FGUYMouseUI;
    var screen = v != undefined && CurScreen != undefined ? CurScreen[v] : undefined;
    var mouseScreen = (screen == 'DeathMenu' || screen == 'CharacterCustomize') && IsKeyboardEnabled(p);
    // The death menu's CHANGE WEAPONS screen is left with START (it respawns you with the weapon chosen) - online the
    // loader gives START to our pause menu, so it hears when this screen is up (a controller couldn't leave it). (A
    // supply crate's store is the same screen, left with B too: START stays our pause there.)
    var takesStart = screen == 'CharacterCustomize' && !IsInGameWeaponSelect(p);
    if (takesStart != FGUYTakesStart) {
        FGUYTakesStart = takesStart;
        flash.external.ExternalInterface.call('FGUYMOD_HudTakesStart', takesStart ? 1 : 0);
    }
    if (mouseScreen) {
        if (layer == undefined) {
            layer = _root.createEmptyMovieClip('FGUYMouseUI', 30001);
            FGUYPausePointer(layer, r.h / 720);
        }
        FGUYMouseUnzoom(layer);
    }
    // The weapons screen (from the death menu, or a store portal): the wheel - pointing at a weapon chooses it, a
    // click buys it. The loader turns that into the keys a keyboard player has for it (the direction on W A S D,
    // then X), so every PC chooses and buys alike. Its box: the wheel's spokes, the 6th field 1 (a wheel).
    if (mouseScreen && screen == 'CharacterCustomize') {
        var wb = undefined;
        for (var si = 0; si < 8; si++) {
            var spoke = GetSpokeFromSlot(p, si);
            if (spoke == undefined || !spoke._visible) continue;
            var sb = spoke.getBounds(layer);
            if (sb.xMax <= sb.xMin) continue;
            if (wb == undefined) wb = {xMin: sb.xMin, xMax: sb.xMax, yMin: sb.yMin, yMax: sb.yMax};
            else {
                wb.xMin = Math.min(wb.xMin, sb.xMin); wb.xMax = Math.max(wb.xMax, sb.xMax);
                wb.yMin = Math.min(wb.yMin, sb.yMin); wb.yMax = Math.max(wb.yMax, sb.yMax);
            }
        }
        if (wb != undefined)
            boxes = Math.round((wb.xMin - r.x) / r.w * 10000) + ',' + Math.round((wb.yMin - r.y) / r.h * 10000) + ',' +
                    Math.round((wb.xMax - r.x) / r.w * 10000) + ',' + Math.round((wb.yMax - r.y) / r.h * 10000) + ',88,1,' + Math.round(r.w / r.h * 1000) + ';';
    }
    var deathUp = screen == 'DeathMenu';   // (my death menu: our panel over it, any controls)
    if (deathUp != FGUYDeathUp) {
        FGUYDeathUp = deathUp;
        flash.external.ExternalInterface.call('FGUYMOD_DeathPanel', deathUp ? 1 : 0);
    }
    FGUYDeathPanel(p, deathUp, mouseScreen);
    if (mouseScreen && deathUp) boxes = FGUYDeathBoxes;
    if (boxes == '' && layer == undefined) return;   // (nothing to say: no menu of mine now, none before)
    var c = String(flash.external.ExternalInterface.call('FGUYMOD_DeathMouse', boxes)).split('|');
    FGUYDeathPtr = mouseScreen ? {x: r.x + Number(c[0]) / 10000 * r.w, y: r.y + Number(c[1]) / 10000 * r.h} : undefined;
    if (layer == undefined) return;
    layer.pointer._visible = c[2] == '1';
    layer.pointer._x = r.x + Number(c[0]) / 10000 * r.w;
    layer.pointer._y = r.y + Number(c[1]) / 10000 * r.h;
    if (boxes == '') layer.removeMovieClip();
}

// Online, my death menu: the game's is three small lines in the middle of the screen (under the others' name tags,
// which the loader hides meanwhile: FGUYMOD_DeathPanel) - ours is a panel of big buttons, each with its key (a
// keyboard player's) or button; the one under the pointer lights up, and a click on it is its key (FGUYDeathMouse ->
// the loader, through the match's input). The game's buttons stay, unseen: its menu still takes the keys and buttons.
function FGUYDeathPanel(p, show, keyboard) {
    var ui = _root.FGUYDeathUI;
    if (!show) {
        if (ui != undefined) ui.removeMovieClip();
        if (FGUYDeathGame != undefined) { FGUYDeathGameShown(FGUYDeathGame, true); FGUYDeathGame = undefined; }
        FGUYDeathSig = undefined;
        FGUYDeathBoxes = '';
        return;
    }
    var m = GetScreenMovieClip(p);
    if (m != undefined) {
        FGUYDeathGameShown(m, false);
        FGUYDeathGame = m;
    }
    var r = FGUYPauseRect(), size = r.h / 720;
    var labels = ['CONTINUE', 'CHANGE CHARACTER', 'CHANGE WEAPONS'], keys = [13, 88, 89];
    var glyphs = keyboard ? ['ENTER', 'X', 'Y'] : ['A', 'X', 'Y'];
    var pads = [0x3DB54A, 0x2D7FE0, 0xE8B400];
    var pw = Math.min(r.w * 0.44, 560 * size), bh = 64 * size, gap = 14 * size, top = 104 * size;
    var ph = top + 3 * bh + 2 * gap + 54 * size;
    var px = r.x + (r.w - pw) / 2, py = r.y + (r.h - ph) / 2 - 20 * size;
    var bx = px + 26 * size, bw = pw - 52 * size;
    var hover = -1;
    for (var i = 0; keyboard && FGUYDeathPtr != undefined && i < 3; i++) {
        var by = py + top + i * (bh + gap);
        if (FGUYDeathPtr.x >= bx && FGUYDeathPtr.x <= bx + bw && FGUYDeathPtr.y >= by && FGUYDeathPtr.y <= by + bh) hover = i;
    }
    var sig = hover + ',' + keyboard + ',' + r.x + ',' + r.y + ',' + r.w + ',' + r.h;
    if (ui == undefined || sig != FGUYDeathSig) {
        ui.removeMovieClip();
        ui = _root.createEmptyMovieClip('FGUYDeathUI', 29990);
        var bg = ui.createEmptyMovieClip('bg', 1);
        FGUYPauseBox(bg, r.x, r.y, r.w, r.h, 0, 0x000000, 30, 0, 0, 0);
        FGUYPauseBox(bg, px, py, pw, ph, 18, 0x13213C, 95, 0x2E5C9A, 100, 3);
        FGUYPauseText(ui, px, py + 16 * size, pw, 58 * size, 'YOU DIED', true, 44 * size, 0xF5D33A, 'center');
        FGUYPauseText(ui, px, py + 68 * size, pw, 26 * size, 'What next?', false, 16 * size, 0xBFD0EA, 'center');
        for (var k = 0; k < 3; k++) {
            var ky = py + top + k * (bh + gap), on = k == hover;
            FGUYPauseBox(bg, bx, ky, bw, bh, 12, on ? 0xF5D33A : (k == 0 ? 0x24467A : 0x1C3156), 100,
                         on ? 0xFFFFFF : (k == 0 ? 0x5A8AD0 : 0x2E5C9A), 100, 2);
            var gh = 40 * size, gw = keyboard && k == 0 ? 84 * size : gh, gx = bx + 16 * size, gy = ky + (bh - gh) / 2;
            if (keyboard) FGUYPauseBox(bg, gx, gy, gw, gh, 8 * size, 0xFFFFFF, 100, 0x000000, 50, 1);
            else FGUYPauseBox(bg, gx, gy, gw, gh, gh / 2, pads[k], 100, 0xFFFFFF, 80, 2);
            FGUYPauseText(ui, gx, gy + (keyboard && k == 0 ? 9 : 6) * size, gw, gh, glyphs[k], true,
                          (keyboard && k == 0 ? 17 : 22) * size, keyboard ? 0x1A1A1A : 0xFFFFFF, 'center');
            FGUYPauseText(ui, gx + gw + 20 * size, ky + (bh - 34 * size) / 2, bw - gw - 56 * size, 40 * size, labels[k], true,
                          26 * size, on ? 0x1A1A1A : 0xFFFFFF, 'left');
        }
        FGUYPauseText(ui, px, py + ph - 42 * size, pw, 26 * size,
                      keyboard ? 'Press the key - or click the button' : 'Press the button', false, 14 * size, 0x9FB4D6, 'center');
        FGUYDeathSig = sig;
    }
    FGUYMouseUnzoom(ui);
    var boxes = '';
    for (var j = 0; keyboard && j < 3; j++) {
        var jy = py + top + j * (bh + gap);
        boxes = boxes + Math.round((bx - r.x) / r.w * 10000) + ',' + Math.round((jy - r.y) / r.h * 10000) + ',' +
                Math.round((bx + bw - r.x) / r.w * 10000) + ',' + Math.round((jy + bh - r.y) / r.h * 10000) + ',' + keys[j] + ';';
    }
    FGUYDeathBoxes = boxes;
}

// (the game's own death menu buttons: unseen under our panel, back when it goes)
function FGUYDeathGameShown(m, shown) {
    var names = ['continueButton', 'characterSelectButton', 'weaponChangesButton'];
    for (var i = 0; i < names.length; i++) if (m[names[i]] != undefined) m[names[i]]._alpha = shown ? 100 : 0;
}

// The pointer's layer in whole-screen units, like the pause menu's (FGUYPauseUnzoom).
function FGUYMouseUnzoom(layer) {
    if (!FGUYZoomed) {
        layer._xscale = 100; layer._yscale = 100; layer._x = 0; layer._y = 0;
        return;
    }
    var z = _root._xscale / 100;
    layer._xscale = 100 / z;
    layer._yscale = 100 / z;
    layer._x = -_root._x / z;
    layer._y = -_root._y / z;
}

// The damage frame (Icon_DamageFx_<viewport>_<layout>_<player>: frost, fire, acid, electric, disintegrate) is
// drawn for the movie's 4:3 stage (960x720) and isn't in the HUD's widescreen list, so on a wider screen it
// covered only the middle. Stretched across the visible width, from where the movie put it (kept, so it's never
// stretched twice). Called when the HUD lays out, and twice a second (the HUD may move it again).
function FGUYFitDamageFx() {
    var r = FGUYPauseRect();
    var f = r.w / 960;
    var layouts = [0, 1, 2, 4];
    var test = flash.external.ExternalInterface.call('FGUYMOD_TestShowDamageFx') == true;
    for (var v = 0; v < 4; v++) {
        for (var l = 0; l < layouts.length; l++) {
            for (var p = 0; p < 4; p++) {
                var mc = _root['Icon_DamageFx_' + v + '_' + layouts[l] + '_' + p];
                if (mc == undefined) continue;
                if (mc.fguyX0 == undefined) {
                    mc.fguyX0 = mc._x;
                    mc.fguyXScale0 = mc._xscale;
                }
                mc._x = r.x + mc.fguyX0 * f;
                mc._xscale = mc.fguyXScale0 * f;
                if (test) {   // (test screenshots: show it - frost, half-way through)
                    mc._visible = true;
                    mc._alpha = 100;
                    mc.gotoAndStop(1);
                    mc.FX.gotoAndStop(44);
                    flash.external.ExternalInterface.call('FGUYMOD_HudDebug', 'dfx shown Icon_DamageFx_' + v + '_' + layouts[l] + '_' + p + ' x/xscale/x0', mc._x, mc._xscale, mc.fguyX0);
                }
            }
        }
    }
}

// Online, a keyboard player's death menu: which keys do what (Enter goes on, X / Y as on a controller - the
// loader turns the keyboard's X / Y / Backspace into the controller's X / Y / B there, kbm.cpp; a click on a
// button becomes its key: FGUYDeathMouse). The hint goes on the Continue button, so it comes and goes with the menu.
function FGUYDeathHints(playerIndex) {
    if (flash.external.ExternalInterface.call('FGUYMOD_OnlineMatch') != true) return;
    var m = GetScreenMovieClip(playerIndex);
    if (m == undefined || m.continueButton == undefined) return;
    var c = m.continueButton;
    if (!IsKeyboardEnabled(playerIndex)) {
        if (c.fguyHint != undefined) c.fguyHint._visible = false;
        return;
    }
    if (c.fguyHint != undefined) c.fguyHint._visible = false;   // (our panel shows the keys: FGUYDeathPanel)
}

// ...and on the screens behind it (change character, change weapons): there the game hides its controller help
// in keyboard mode (it's for the mouse there). Ours goes where that help is. which: 0 character, 1 weapons.
function FGUYNavHints(playerIndex, which) {
    if (flash.external.ExternalInterface.call('FGUYMOD_OnlineMatch') != true) return;
    var m = GetScreenMovieClip(playerIndex);
    if (m == undefined || m.navHelp == undefined) return;
    var name = which == 1 ? 'fguyHintWeapons' : 'fguyHintCharacter';
    if (!IsKeyboardEnabled(playerIndex)) {
        if (m[name] != undefined) m[name]._visible = false;
        return;
    }
    if (m[name] == undefined) {
        var b = m.navHelp.getBounds(m), y = b.yMin;
        var wheel = which == 1 ? GetWeaponWheel(playerIndex) : undefined;
        if (wheel != undefined) {   // (the weapons screen's help is inside the wheel: ours goes under it)
            var vb = undefined;   // (its spokes only: the clip holds hidden pieces far around it)
            for (var i = 0; i < 8; i++) {
                var c = GetSpokeFromSlot(playerIndex, i);
                if (c == undefined || !c._visible) continue;
                var cb = c.getBounds(m);
                if (cb.xMax <= cb.xMin) continue;
                if (vb == undefined) vb = {xMin: cb.xMin, xMax: cb.xMax, yMin: cb.yMin, yMax: cb.yMax};
                else {
                    vb.xMin = Math.min(vb.xMin, cb.xMin); vb.xMax = Math.max(vb.xMax, cb.xMax);
                    vb.yMin = Math.min(vb.yMin, cb.yMin); vb.yMax = Math.max(vb.yMax, cb.yMax);
                }
            }
            if (vb != undefined) {
                b = vb;
                y = b.yMax + 8;
            }
        }
        var str = which == 1 ? 'W A S D or point  choose      X or click  buy      ENTER  done      BACKSPACE  back'
                             : 'LEFT / RIGHT  character      UP / DOWN  costume      ENTER  pick      BACKSPACE  back';
        m[name] = FGUYPauseText(m, (b.xMin + b.xMax) / 2 - 400, y, 800, 30, str, false, 16, 0xFFFFFF, 'center');
    }
    m[name]._visible = true;
}

// Research (make_hud_patch.py --debug): a screen's own key handler ran - which key, for whom (where: 1 weapons, 2 death).
function FGUYKeyProbe(playerIndex, where) {
    FGUYKeyN = FGUYKeyN == undefined ? 1 : FGUYKeyN + 1;
    flash.external.ExternalInterface.call('FGUYMOD_HudDebug', 'key handler', where, playerIndex, Key.getCode(), FGUYKeyN,
        Number(flash.external.ExternalInterface.call('STOR_GetCurrency', playerIndex)), currentCustomizeSelection[playerIndex]);
}
