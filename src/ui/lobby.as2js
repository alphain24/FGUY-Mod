// The ONLINE screens, drawn at runtime inside the main menu movie (compiled by tools/ui/as2c.py and
// patched in by tools/ui/make_menu_patch.py). Look: the "FGUY Online Lobby" design canvas.
//
// Main Menu > ONLINE opens the borrowed Options > Screen page with FGUYOnline set, so that page's
// events come here (OnOnlineEnter / OnOnlineHandleInput / OnOnlineExit). We hide its own panel and draw
// everything ourselves on one movie clip on top, with the game's own fonts, pictures and sounds.
//
// Screens: 'hub' (host / find / join with code), 'lobby', 'char' (character & skin), 'settings'.
// The lobby data comes from the loader (FGUYMOD_LobbyState, polled), actions go to FGUYMOD_LobbyDo.
// Everything is laid out in the design's 1600 x 900 space and scaled to the screen.

// ---- colours (the design's palette) -----------------------------------------------------------------------
function FGUYColors() {
    FGUYC = {bg: 0x0A1A36, panel: 0x13396A, panel2: 0x164A7E, deep: 0x10284F, row: 0x123060, rowLine: 0x2E66A8,
             rowHot: 0x1C5290, glow: 0x7FE3FF, title: 0x5DBBFF, yellow: 0xFFD23F, ink: 0x06122A, dark: 0x1A1200,
             white: 0xFFFFFF, soft: 0xD8EAFE, muted: 0x9CC3EC, muted2: 0xB9D6F5, chip: 0x13325E, chipLine: 0x3E7FC4,
             green: 0x1E7A46, greenLine: 0x57E39A, red: 0xFFB4B4, redLine: 0x8A3A3A, good: 0x7FE3FF, evil: 0xFF9C8A};
}

// ---- drawing helpers --------------------------------------------------------------------------------------
function FGUYRect(mc, x, y, w, h, r, fill, alpha, line, lineAlpha, thick) {
    if (thick > 0) mc.lineStyle(thick, line, lineAlpha, true);
    else mc.lineStyle();
    if (alpha > 0) mc.beginFill(fill, alpha);
    mc.moveTo(x + r, y);
    mc.lineTo(x + w - r, y);
    mc.curveTo(x + w, y, x + w, y + r);
    mc.lineTo(x + w, y + h - r);
    mc.curveTo(x + w, y + h, x + w - r, y + h);
    mc.lineTo(x + r, y + h);
    mc.curveTo(x, y + h, x, y + h - r);
    mc.lineTo(x, y + r);
    mc.curveTo(x, y, x + r, y);
    if (alpha > 0) mc.endFill();
}

// A panel with the design's cyan rim and soft glow (layered rims; Scaleform has no clip filters).
function FGUYPanel(mc, x, y, w, h, r, fill, rim) {
    FGUYRect(mc, x - 9, y - 9, w + 18, h + 18, r + 9, rim, 6, 0, 0, 0);
    FGUYRect(mc, x - 5, y - 5, w + 10, h + 10, r + 5, rim, 12, 0, 0, 0);
    FGUYRect(mc, x, y, w, h, r, fill, 100, rim, 100, 3);
}

function FGUYCircle(mc, cx, cy, r, fill, alpha, line, thick) {
    if (thick > 0) mc.lineStyle(thick, line, 100, true);
    else mc.lineStyle();
    if (alpha > 0) mc.beginFill(fill, alpha);
    var k = 0.4142, s = 0.7071;
    mc.moveTo(cx + r, cy);
    mc.curveTo(cx + r, cy + k * r, cx + s * r, cy + s * r);
    mc.curveTo(cx + k * r, cy + r, cx, cy + r);
    mc.curveTo(cx - k * r, cy + r, cx - s * r, cy + s * r);
    mc.curveTo(cx - r, cy + k * r, cx - r, cy);
    mc.curveTo(cx - r, cy - k * r, cx - s * r, cy - s * r);
    mc.curveTo(cx - k * r, cy - r, cx, cy - r);
    mc.curveTo(cx + k * r, cy - r, cx + s * r, cy - s * r);
    mc.curveTo(cx + r, cy - k * r, cx + r, cy);
    if (alpha > 0) mc.endFill();
}

// Text in one of the game's fonts. Shrinks to fit its box.
function FGUYText(mc, x, y, w, h, str, display, size, color, align) {
    FGUYTextN = FGUYTextN + 1;
    var name = 't' + FGUYTextN;
    mc.createTextField(name, mc.getNextHighestDepth(), x, y, w, h);
    var t = mc[name];
    t.embedFonts = true;
    t.selectable = false;
    t.wordWrap = false;
    var f = new TextFormat();
    f.font = display ? '$font_displayText' : '$font_bodyText';
    f.size = size;
    f.color = color;
    f.align = align;
    t.setNewTextFormat(f);
    t.text = str;
    t.setTextFormat(f);
    while (t.textWidth > w - 6 && size > 10) {
        size = size - 2;
        f.size = size;
        t.setTextFormat(f);
    }
    return t;
}

// Cartoon title: the game's display font with a dark drop outline under it.
function FGUYTitle(mc, x, y, w, h, str, size, color, align) {
    var o = size / 14;
    FGUYText(mc, x + o, y + o * 1.4, w, h, str, true, size, FGUYC.ink, align);
    FGUYText(mc, x - o * 0.6, y + o * 0.6, w, h, str, true, size, FGUYC.ink, align);
    FGUYText(mc, x + o * 0.6, y - o * 0.4, w, h, str, true, size, FGUYC.ink, align);
    return FGUYText(mc, x, y, w, h, str, true, size, color, align);
}

function FGUYBitmap(linkage) {
    if (!FGUYBmps) FGUYBmps = {};
    if (FGUYBmps[linkage] == undefined) FGUYBmps[linkage] = flash.display.BitmapData.loadBitmap(linkage);
    return FGUYBmps[linkage];
}

// A game picture filling a box edge to edge (scaled to cover it, the overflow cut off by a rounded mask of
// radius r). fy picks which part of a too-tall picture stays: 0 = its top, 0.5 = its middle. zoom > 1
// enlarges it further around that point (to cut off a frame painted into the picture).
function FGUYPicture(mc, linkage, x, y, w, h, r, fy, zoom) {
    var bmp = FGUYBitmap(linkage);
    if (!bmp) return null;
    FGUYTextN = FGUYTextN + 1;
    var holder = mc.createEmptyMovieClip('p' + FGUYTextN, mc.getNextHighestDepth());
    holder.attachBitmap(bmp, 1, 'auto', true);
    var s = Math.max(w / bmp.width, h / bmp.height) * (zoom > 1 ? zoom : 1);
    holder._xscale = s * 100;
    holder._yscale = s * 100;
    holder._x = x + (w - bmp.width * s) / 2;
    holder._y = y + (h - bmp.height * s) * fy;
    var mask = mc.createEmptyMovieClip('m' + FGUYTextN, mc.getNextHighestDepth());
    FGUYRect(mask, x, y, w, h, r, 0xFFFFFF, 100, 0, 0, 0);
    holder.setMask(mask);
    return holder;
}

// A small picture (button glyph) fitted whole into a box, centred.
function FGUYIcon(mc, linkage, x, y, w, h) {
    var bmp = FGUYBitmap(linkage);
    if (!bmp) return null;
    FGUYTextN = FGUYTextN + 1;
    var holder = mc.createEmptyMovieClip('p' + FGUYTextN, mc.getNextHighestDepth());
    holder.attachBitmap(bmp, 1, 'auto', true);
    var s = Math.min(w / bmp.width, h / bmp.height);
    holder._xscale = s * 100;
    holder._yscale = s * 100;
    holder._x = x + (w - bmp.width * s) / 2;
    holder._y = y + (h - bmp.height * s) / 2;
    return holder;
}

// ---- the live 3D character ---------------------------------------------------------------------------------
// The Store's character model (menu player 2) in the main menu scene, seen through the Store camera. While
// the ONLINE page is open the camera stays in the Store; the lobby and character screens leave a window open
// in their background (FGUYDraw) and have the loader draw the 3D scene into it (FGUYStageView).
function FGUY3DStart() {
    FGUY3DChar = undefined;
    FGUY3DCostume = undefined;
    FGUYViewAt = '';
    flash.external.ExternalInterface.call('PLYR_SetJoinEnabled', false);
    DropOtherPlayers();
    flash.external.ExternalInterface.call('MENU_EnableStore');
    if (FGUYPickChar != undefined) FGUY3DShow(FGUYPickChar, FGUYPickCostume);   // (the Store camera frames it)
    getURL('FSCommand:GAME_Run', 'MNUS_Script_Camera_StoreEnter_ref');
    FGUY3DActive = flash.external.ExternalInterface.call('FGUYMOD_TestNo3DFix') != true;
    FGUY3DStep = 0;
    FGUY3DTries = 0;
    FGUY3DLastCam = '';
    FGUY3DAgainAt = FGUYNow() + 800;
}

// The Store camera sometimes doesn't take (about half the time in tests - old builds too): it stays on the main
// menu's view, and the lobby's panel shows the empty living room. Sending it again changes nothing; out of the
// Store and back in does it. So while the ONLINE screens are open (FGUYPoll), twice a second: where is the 3D
// camera? Come to rest anywhere but the Store's spot - out and back in, then look again (a few tries at most).
function FGUY3DAgain() {
    if (!FGUY3DActive) return;
    var now = FGUYNow();
    if (now < FGUY3DAgainAt) return;
    if (FGUY3DStep == 1) {   // out of the Store: back in
        FGUY3DStep = 0;
        FGUY3DAgainAt = now + 1500;   // (it gets there before we look again)
        FGUY3DLastCam = '';
        getURL('FSCommand:GAME_Run', 'MNUS_Script_Camera_StoreEnter_ref');
        return;
    }
    FGUY3DAgainAt = now + 500;
    var cam = String(flash.external.ExternalInterface.call('FGUYMOD_MenuCamera'));
    var still = cam == FGUY3DLastCam;   // (moving: on its way somewhere - wait)
    FGUY3DLastCam = cam;
    var p = cam.split('|');   // (the Store camera's spot: -9.505, 1.197, 14.555)
    var d = Math.abs(Number(p[0]) + 9.505) + Math.abs(Number(p[1]) - 1.197) + Math.abs(Number(p[2]) - 14.555);
    if (!(d > 1) || !still || FGUY3DTries >= 4) return;
    FGUY3DTries = FGUY3DTries + 1;
    flash.external.ExternalInterface.call('FGUYMOD_Log', 'the 3D camera stayed at ' + cam + ' - out of the Store and back in');
    FGUY3DStep = 1;
    FGUY3DAgainAt = now + 300;
    getURL('FSCommand:GAME_Run', 'MNUS_Script_Camera_StoreExit_ref');
}

function FGUY3DStop() {
    FGUY3DActive = false;
    flash.external.ExternalInterface.call('PLYR_ResetRotation', 2);
    flash.external.ExternalInterface.call('MENU_DisableStore');
    getURL('FSCommand:GAME_Run', 'MNUS_Script_Camera_StoreExit_ref');
    flash.external.ExternalInterface.call('FGUYMOD_MenuView', 0, 0, 1, 1);
}

function FGUY3DShow(c, costume) {
    if (c != FGUY3DChar) {
        flash.external.ExternalInterface.call('PLYR_SetCharacter', 2, GetCharacterIndex(c));
        FGUY3DChar = c;
        FGUY3DCostume = undefined;
    }
    if (String(costume) != String(FGUY3DCostume)) {
        flash.external.ExternalInterface.call('PLYR_ApplyCostume', 2, Number(costume));
        FGUY3DCostume = costume;
    }
}

// Draw the 3D scene so the model stands centred at design x, from design y top to bottom. Full screen,
// the Store camera shows the model at 65% across, from 6% to 87% down; the scene keeps the screen's shape.
function FGUYStageView(cx, top, bottom) {
    var key = cx + ',' + top + ',' + bottom;
    if (key == FGUYViewAt) return;
    FGUYViewAt = key;
    var vr = Stage.visibleRect, vy = 0, vh = 720;
    if (vr) { vy = vr.y; vh = vr.height; }
    var nt = (top * 0.8 - vy) / vh, nb = (bottom * 0.8 - vy) / vh;
    var h = (nb - nt) / 0.81;
    var x = Math.max(0, cx / 1600 - 0.648 * h), y = Math.max(0, nt - 0.06 * h);
    flash.external.ExternalInterface.call('FGUYMOD_MenuView', x, y, Math.min(1, x + h), Math.min(1, y + h));
}

// A frame around the 3D window: rims only, so the scene shows through.
function FGUYStage(mc, x, y, w, h) {
    FGUYRect(mc, x - 6, y - 6, w + 12, h + 12, 12, 0, 0, FGUYC.glow, 22, 5);
    FGUYRect(mc, x, y, w, h, 6, 0, 0, FGUYC.glow, 100, 3);
}

// A round portrait: the top of a costume picture inside a circle.
function FGUYPortrait(mc, linkage, cx, cy, r) {
    FGUYCircle(mc, cx, cy, r, 0x2A6AA6, 100, FGUYC.glow, 0);
    var bmp = FGUYBitmap(linkage);
    FGUYTextN = FGUYTextN + 1;
    if (bmp) {
        var holder = mc.createEmptyMovieClip('p' + FGUYTextN, mc.getNextHighestDepth());
        holder.attachBitmap(bmp, 1, 'auto', true);
        var s = (r * 2.6) / bmp.width;
        holder._xscale = s * 100;
        holder._yscale = s * 100;
        holder._x = cx - bmp.width * s / 2;
        holder._y = cy - r * 0.9;
        var mask = mc.createEmptyMovieClip('m' + FGUYTextN, mc.getNextHighestDepth());
        FGUYCircle(mask, cx, cy, r, 0xFFFFFF, 100, 0, 0);
        holder.setMask(mask);
    }
    var ring = mc.createEmptyMovieClip('r' + FGUYTextN, mc.getNextHighestDepth());
    FGUYCircle(ring, cx, cy, r, 0, 0, FGUYC.glow, 2);
}

function FGUYButtonHint(mc, x, y, glyph, label) {
    FGUYIcon(mc, 'controllerSymbol_' + glyph + '.tif', x, y, 34, 34);
    var key = glyph == 'A' ? 13 : (glyph == 'B' ? 27 : (glyph == 'X' ? 88 : (glyph == 'Y' ? 89 : (glyph == 'LB' ? 76 : (glyph == 'RB' ? 82 : 0)))));
    if (key != 0 && FGUYHits != undefined) FGUYHit(x - 4, y - 4, 52 + label.length * 10, 42, 'key', key);
    FGUYText(mc, x + 40, y + 2, 200, 34, label, false, 20, FGUYC.white, 'left');
    return x + 56 + label.length * 10;
}

function FGUYSound(name) {
    getURL('FSCommand:SNDS_PlaySoundFX', name);
}

function FGUYDo(cmd, a, b, c, d, e) {
    flash.external.ExternalInterface.call('FGUYMOD_LobbyDo', cmd, String(a), String(b), String(c), String(d), String(e));
}

function FGUYLocal(text) {  // '=KEY' localisation keys -> the game's text
    if (text == undefined) return '';
    text = String(text);
    if (text.charAt(0) == '=') {
        var s = flash.external.ExternalInterface.call('MENU_GetString', text.substr(1));
        if (s != undefined && s != '') return String(s);
    }
    return text;
}

// ---- game data ---------------------------------------------------------------------------------------------
function FGUYData() {
    FGUYModes = [
        {code: 'DM', suffix: 'DM', name: 'DEATHMATCH', pic: 'Deathmatch_Screen1.tif', teams: true, score: 'WinningScore',
         about: 'Take out the other team. Most points when time runs out, or first to the winning score, wins.'},
        {code: 'HD', suffix: 'HD', name: 'MULTIVERSE MADNESS', pic: 'Horde_screen1.tif', teams: false, score: '',
         about: 'Team up and survive wave after wave of enemies.'},
        {code: 'CF', suffix: 'CF', name: 'CAPTURE THE GREASED-UP DEAF GUY', pic: 'GUDG_screen1.tif', teams: true,
         score: 'FlagLimit', about: 'Grab the Greased-Up Deaf Guy and bring him home. First to the flag limit wins.'},
        {code: 'IN', suffix: 'IN', name: 'INFILTRATION!', pic: 'Invasion_screen1a.tif', teams: true, score: 'WinningScore',
         about: 'One team attacks, the other defends.'},
        {code: 'ST', suffix: 'XX', name: 'STORY CO-OP', pic: 'screenshot_FratRow.tif', teams: false, score: '',
         about: 'Play the story together, everyone on their own screen.'}];
    FGUYMaps = ['FR', 'AM', 'CT', 'CH', 'TF', 'SS', 'AP', 'BP'];
    FGUYStory = ['FR', 'AM', 'CT', 'CH', 'MC', 'PI', 'TF', 'SS', 'GC', 'BP'];
    FGUYMapPics = {FR: 'screenshot_FratRow.tif', AM: 'screenshot_Amish.tif', CT: 'screenshot_Crippletron.tif',
                   CH: 'screenshot_CH.tif', TF: 'screenshot_TF.tif', SS: 'screenshot_SS.tif', BP: 'screenshot_BertramPrime.tif',
                   MC: 'screenshot_MC.tif', PI: 'screenshot_PI.tif', GC: 'screenshot_PvGC.tif',
                   AP: 'screenshot_PvGC.tif'};   // the Airport is the "Chicken Fight!" level's map
    FGUYCostumes = GetCostumesInfo();          // my save's bought costumes, by character index
    FGUYAllCostumes = [];                      // every costume (names and pictures for any save's picks)
    for (var i = 0; i < 11; i++) FGUYAllCostumes[i] = flash.external.ExternalInterface.call('STOR_GetCostumesInfo', 0, i);
    FGUYOwnAt = '';
    FGUYChars = FGUYCharList();
    FGUYRules = {TimeLimit: FGUYRuleList('TimeLimit'), WinningScore: FGUYRuleList('WinningScore'),
                 FlagLimit: FGUYRuleList('FlagLimit'), FriendlyFire: ['OFF', 'ON']};
}

function FGUYRuleList(row) {
    var list = ButtonListStrings[ButtonIndexMapping[row]];
    var out = [];
    if (list == undefined) return ['-'];
    for (var i = 0; i < list.length; i++) out.push(FGUYLocal(list[i]));
    return out;
}

function FGUYMode(code) {
    for (var i = 0; i < FGUYModes.length; i++) if (FGUYModes[i].code == code) return FGUYModes[i];
    return FGUYModes[0];
}

// The maps a mode has: the host's unlocked multiplayer maps (the session plays on the host's save) that
// the game's level table has in that mode.
function FGUYMapsFor(code) {
    var mode = FGUYMode(code);
    var list = mode.code == 'ST' ? FGUYStory : GetUnlockedMultiplayerLevelPrefixes();
    var out = [];
    for (var i = 0; i < list.length; i++)
        if (mode.code == 'ST' || LevelMap[list[i] + mode.suffix] != undefined) out.push(list[i]);
    if (out.length == 0) out.push(list[0]);
    return out;
}

function FGUYMapName(map, code) {
    var key = FGUYMode(code).code == 'ST' ? 'NAM_' + map + 'XX' : 'NAM_' + map + 'MP';
    var s = flash.external.ExternalInterface.call('MENU_GetString', key);
    if (s == undefined || s == '' || s == key) return map;
    return String(s).toUpperCase();
}

// The game's level shots are drawn as a TV screen inside a dark bezel: show just the screen.
function FGUYMapPicture(mc, map, code, x, y, w, h, r) {
    return FGUYPicture(mc, FGUYMapPic(map, code), x, y, w, h, r, 0.5, 1.6);
}

function FGUYPoly(mc, pts, fill, alpha) {
    mc.lineStyle();
    mc.beginFill(fill, alpha);
    mc.moveTo(pts[0], pts[1]);
    for (var i = 2; i < pts.length; i = i + 2) mc.lineTo(pts[i], pts[i + 1]);
    mc.endFill();
}

function FGUYMapPic(map, code) {
    var p = FGUYMapPics[map];
    if (p == undefined) return FGUYMode(code).pic;
    return p;
}

function FGUYCharName(c) {
    if (c == 'Adam') return 'ADAM WEST';
    return String(c).toUpperCase();
}

// The pick lists. In a lobby they come from the host's save (FGUYS.own, shared through the server), because
// the match plays on it; otherwise from mine.
function FGUYOwned() {
    var own = FGUYS.state == 'lobby' ? FGUYS.own : '';
    if (own == FGUYOwnAt && FGUYOwnParsed != undefined) return FGUYOwnParsed;
    FGUYOwnAt = own;
    FGUYOwnParsed = null;
    if (own == undefined || own == '') return null;
    var o = {chars: [], costumes: {}};
    var entries = String(own).split(';');
    for (var i = 0; i < entries.length; i++) {
        var f = entries[i].split(':');
        if (f[0] == '') continue;
        o.chars.push(f[0]);
        o.costumes[f[0]] = f.length > 1 && f[1] != '' ? f[1].split('.') : ['0'];
    }
    FGUYOwnParsed = o;
    return o;
}

function FGUYCharList() {
    if (FGUYS != undefined && FGUYS.mode == 'ST') return ['Stewie', 'Brian'];   // story co-op: the story's two
    var o = FGUYOwned();
    if (o != null) {
        var all = GetMultiplayerCharacterList(), out = [];
        for (var i = 0; i < all.length; i++)
            for (var k = 0; k < o.chars.length; k++) if (o.chars[k] == all[i]) out.push(all[i]);
        if (out.length > 0) return out;
    }
    var mine = GetUnlockedMultiplayerCharacterList();
    return mine.length > 0 ? mine : GetMultiplayerCharacterList();
}

function FGUYCostumeList(c) {
    var o = FGUYOwned(), ci = GetCharacterIndex(c);
    if (o != null && o.costumes[c] != undefined) {
        var all = FGUYAllCostumes[ci], wanted = o.costumes[c], out = [];
        if (all != undefined)
            for (var i = 0; i < all.length; i++)
                for (var k = 0; k < wanted.length; k++) if (String(all[i].CostumeIndex) == String(wanted[k])) out.push(all[i]);
        if (out.length > 0) return out;
    }
    var list = FGUYCostumes[ci];
    if (list == undefined) return [];
    return list;
}

// Host: what my save has, for everyone's pick lists: Peter:0.1.3;Lois:0.2
function FGUYOwnString() {
    var chars = GetUnlockedMultiplayerCharacterList(), parts = [];
    for (var i = 0; i < chars.length; i++) {
        var list = FGUYCostumes[GetCharacterIndex(chars[i])], idx = [];
        if (list != undefined) for (var k = 0; k < list.length; k++) idx.push(list[k].CostumeIndex);
        parts.push(chars[i] + ':' + idx.join('.'));
    }
    return parts.join(';');
}

// Story co-op: everyone plays someone else (Stewie, Brian). Another player in the lobby who has character c - with
// lowerOnly, only one who joined before me (a lower slot): they keep it, I change.
function FGUYStoryTakenBy(c, lowerOnly) {
    if (FGUYS.mode != 'ST' || FGUYS.state != 'lobby') return null;
    for (var i = 0; i < FGUYS.members.length; i++) {
        var m = FGUYS.members[i];
        if (m.slot != FGUYS.slot && m.character == c && (!lowerOnly || m.slot < FGUYS.slot)) return m;
    }
    return null;
}

// My pick must be something the host's save has; if not, take the first one that is. In story co-op also one
// nobody who joined before me has (if there is one left).
function FGUYCheckPick() {
    FGUYChars = FGUYCharList();
    var ok = false;
    for (var i = 0; i < FGUYChars.length; i++) if (FGUYChars[i] == FGUYPickChar) ok = true;
    var changed = false, taken = null;
    if (!ok) { FGUYPickChar = FGUYChars[0]; changed = true; }
    var first = FGUYStoryTakenBy(FGUYPickChar, true);
    if (first != null)
        for (var j = 0; j < FGUYChars.length; j++)
            if (FGUYStoryTakenBy(FGUYChars[j], false) == null) {
                FGUYPickChar = FGUYChars[j];
                FGUYPickCostume = -1;   // (its first costume, below)
                changed = true;
                taken = first;
                break;
            }
    var list = FGUYCostumeList(FGUYPickChar), cok = false;
    for (var k = 0; k < list.length; k++) if (String(list[k].CostumeIndex) == String(FGUYPickCostume)) cok = true;
    if (!cok) { FGUYPickCostume = list.length > 0 ? list[0].CostumeIndex : 0; changed = true; }
    if (changed && FGUYS.state == 'lobby') {
        FGUYSendPick();
        if (taken != null) FGUYToast(taken.name + ' is ' + FGUYCharName(taken.character) + " - you're " + FGUYCharName(FGUYPickChar));
        else if (FGUYS.mode == 'ST') FGUYToast("Story co-op is Stewie and Brian - you're " + FGUYCharName(FGUYPickChar));
        else FGUYToast("The host's save doesn't have your pick - you're " + FGUYCharName(FGUYPickChar));
    }
}

// The picture for a character in a costume (game costume index). Like the game's join screen: a costume
// without its own picture name uses Costume_<name>Default.tif (Adam West's pictures are "West").
function FGUYDefaultPic(c) {
    return 'Costume_' + (c == 'Adam' ? 'West' : (c == 'Quag' ? 'Quagmire' : c)) + 'Default.tif';
}

function FGUYEntryPic(c, entry) {
    if (entry == undefined || entry.LinkageID == undefined || entry.LinkageID == '') return FGUYDefaultPic(c);
    return entry.LinkageID;
}

function FGUYCostumePic(c, costume) {
    var list = FGUYCostumeList(c);
    for (var i = 0; i < list.length; i++) if (String(list[i].CostumeIndex) == String(costume)) return FGUYEntryPic(c, list[i]);
    return FGUYDefaultPic(c);
}

function FGUYCostumeName(c, costume) {
    var list = FGUYCostumeList(c);
    for (var i = 0; i < list.length; i++)
        if (String(list[i].CostumeIndex) == String(costume)) {
            var n = FGUYLocal(list[i].UIName);
            if (n.indexOf('Costume(') == 0) return i == 0 ? 'Classic' : 'Skin ' + (i + 1);
            return n;
        }
    return 'Classic';
}

// ---- lobby state from the loader ---------------------------------------------------------------------------
function FGUYParse(blob) {
    var st = {state: 'off', status: '', code: '', slot: -1, priv: false, name: '', server: '', ping: 0,
              mode: 'DM', map: 'FR', time: 0, score: 0, ff: 0, own: '', members: [], lobbies: [], chat: []};
    var lines = String(blob).split('\n');
    for (var i = 0; i < lines.length; i++) {
        var f = lines[i].split('|');
        if (f[0] == 'S') {
            st.state = f[1]; st.status = f[2]; st.code = f[3]; st.slot = Number(f[4]); st.priv = f[5] == '1';
            st.name = f[6]; st.server = f[7]; st.ping = Number(f[8]);
        } else if (f[0] == 'C') {
            st.mode = f[1]; st.map = f[2]; st.time = Number(f[3]); st.score = Number(f[4]); st.ff = Number(f[5]);
            st.rate = Number(f[6]);
        } else if (f[0] == 'O') {
            st.own = f[1];
        } else if (f[0] == 'M') {
            st.members.push({slot: Number(f[1]), name: f[2], ready: f[3] == '1', away: f[3] == '2', ping: Number(f[4]), character: f[5],
                             costume: f[6], team: Number(f[7]), input: f[8] == 'k' ? 'k' : 'c', rate: Number(f[9])});
        } else if (f[0] == 'T') {
            st.chat.push({seq: Number(f[1]), name: f[2], text: f.slice(3).join('|')});
        } else if (f[0] == 'L') {
            st.lobbies.push({code: f[1], host: f[2], players: Number(f[3]), max: Number(f[4]), mode: f[5], map: f[6],
                             mods: f.length > 7 && f[7] != '-' ? String(f[7]).split('+').join(', ').split('_').join(' ') : ''});
        }
    }
    return st;
}

function FGUYPoll() {
    var blob = flash.external.ExternalInterface.call('FGUYMOD_LobbyState');
    FGUY3DAgain();
    if (FGUYScreen == 'loading') {   // animate
        var step = Math.floor((FGUYNow() - FGUYLoadStart) / 450);
        if (step != FGUYLoadStep) { FGUYLoadStep = step; FGUYDraw(); }
    }
    if (FGUYToastUntil > 0 && FGUYNow() > FGUYToastUntil) { FGUYToastUntil = 0; FGUYDraw(); }
    if (FGUYChatQuick == undefined) { FGUYChatQuick = 0; FGUYChatTyping = false; FGUYChatDraft = ''; FGUYChatSeen = 0; }
    if (FGUYChatTyping) FGUYChatPoll();
    var typed = flash.external.ExternalInterface.call('FGUYMOD_TypedText');
    if (typed != undefined && typed != '' && FGUYScreen == 'hub') { FGUYTyped(String(typed)); FGUYDraw(); }
    else if (typed != undefined && String(typed).indexOf('T') >= 0 && FGUYScreen == 'lobby' && !FGUYChatTyping) { FGUYChatOpen(); FGUYDraw(); }
    if (FGUYBot) FGUYBotStep();
    if (blob == FGUYLastBlob) return;
    FGUYLastBlob = blob;
    var was = FGUYS.state, old = FGUYS;
    FGUYS = FGUYParse(blob);
    if (was == 'lobby' && FGUYS.state == 'lobby') FGUYNoticeChanges(old, FGUYS);
    var lastChat = FGUYS.chat.length > 0 ? FGUYS.chat[FGUYS.chat.length - 1] : undefined;
    if (lastChat != undefined && lastChat.seq > FGUYChatSeen) {
        FGUYChatSeen = lastChat.seq;
        if (lastChat.name != FGUYS.name) FGUYSound('nav');
    }
    // The loading screen without a match starting: back from the match (this game waited hidden meanwhile -
    // or the match didn't start). Covered until we're in the lobby again, and the 3D and music come back.
    if (FGUYScreen == 'loading' && FGUYS.state != 'starting' && !FGUYBackFromMatch) {
        FGUYBackFromMatch = true;
        FGUYReturnCoverShow();
    }
    if (FGUYBackFromMatch && FGUYS.state != 'returning') {   // there (or not: its lobby is gone - the hub)
        FGUYBackFromMatch = false;
        FGUYScreen = 'hub';
        FGUYFocus = 0;
        FGUYEnteredAt = FGUYNow();   // (the cover waits for the 3D camera from here)
        FGUY3DStart();
        PlayOptionsSubMenuMusic();   // what the loading screen stopped
        FGUYApplySettingsBack();     // and my settings as I left them in the match
        var saved = String(flash.external.ExternalInterface.call('FGUYMOD_ReportNew'));
        if (saved != '' && saved != 'undefined') {   // (the match went out of sync: its report)
            FGUYToast('The match went out of sync - a report was saved (Y on the ONLINE screen)');
            FGUYToastUntil = FGUYNow() + 9000;
        }
        FGUYReportSettings();
    }
    if (FGUYS.state == 'lobby' && was != 'lobby') {
        FGUYPickInput = FGUYMe().input;
        FGUYScreen = 'lobby';
        FGUYFocus = 0;
        FGUYSound('accept');
        if (FGUYIsHost()) { FGUYCheckMap(); FGUYDo('own', FGUYOwnString()); }
    }
    if (FGUYS.own != old.own || FGUYS.state != was || FGUYS.mode != old.mode || (FGUYS.mode == 'ST' && FGUYS.state == 'lobby'))
        FGUYCheckPick();
    if (FGUYS.state == 'starting' && FGUYScreen != 'loading') {
        FGUYScreen = 'loading';
        FGUYLoadStart = FGUYNow();
        StopMusic();   // the menu music stops: the loading screen has its own sting
        FGUY3DStop();  // and the 3D character (its voice and sounds) goes
        PauseTVSound();
        flash.external.ExternalInterface.call('FGUYMOD_LoadingSound', FGUYS.mode, FGUYS.map);
    }
    if (FGUYS.state != 'lobby' && FGUYS.state != 'starting' && FGUYS.state != 'returning' && FGUYScreen != 'hub')
        FGUYScreen = 'hub';
    FGUYDraw();
}

// Tell everyone what just changed in the lobby (the host's own changes are announced when made).
function FGUYNoticeChanges(a, b) {
    if (b.slot != 0) {
        var m = FGUYMode(b.mode);
        if (a.mode != b.mode) FGUYToast('Host changed the mode to ' + m.name);
        else if (a.map != b.map) FGUYToast('Host changed the map to ' + FGUYMapName(b.map, b.mode));
        else if (a.time != b.time || a.score != b.score || a.ff != b.ff) FGUYToast('Host changed the rules: ' + FGUYRulesLine(false));
        if (a.mode != b.mode || a.map != b.map || a.time != b.time || a.score != b.score || a.ff != b.ff) FGUYSound('change');
    }
    for (var i = 0; i < b.members.length; i++) {
        var p = b.members[i], q = null;
        for (var k = 0; k < a.members.length; k++) if (a.members[k].name == p.name) q = a.members[k];
        if (p.slot == b.slot) continue;
        if (q == null) { FGUYToast(p.name + ' joined'); FGUYSound('accept'); }
        else if (p.ready != q.ready) FGUYToast(p.name + (p.ready ? ' is ready' : ' is not ready'));
        else if (p.character != q.character) FGUYToast(p.name + ' picked ' + FGUYCharName(p.character));
    }
    for (var j = 0; j < a.members.length; j++) {
        var gone = true;
        for (var n = 0; n < b.members.length; n++) if (b.members[n].name == a.members[j].name) gone = false;
        if (gone && a.members[j].slot != a.slot) FGUYToast(a.members[j].name + ' left');
    }
}

// What's happening in the lobby, for the footer: [text, tone].
function FGUYLobbyStatus() {
    if (FGUYS.status != '') return [FGUYS.status, 'warn'];
    var n = FGUYS.members.length;
    if (FGUYIsHost()) {
        if (n < 2) return ['Waiting for players - share code ' + FGUYS.code, 'info'];
        var waiting = [];
        for (var i = 0; i < n; i++) if (FGUYS.members[i].slot != 0 && !FGUYS.members[i].ready) waiting.push(FGUYS.members[i].name);
        if (waiting.length > 0) return ['Waiting for ' + waiting.join(', ') + ' to ready up', 'info'];
        return ["Everyone's ready! Press X to start", 'good'];
    }
    if (!FGUYMe().ready) return ["Press X when you're ready", 'warn'];
    return ["You're ready - waiting for the host to start", 'good'];
}

function FGUYIsHost() {
    return FGUYS.state == 'lobby' && FGUYS.slot == 0;
}

function FGUYMe() {
    for (var i = 0; i < FGUYS.members.length; i++) if (FGUYS.members[i].slot == FGUYS.slot) return FGUYS.members[i];
    return {name: FGUYS.name, character: FGUYPickChar, costume: FGUYPickCostume, team: FGUYPickTeam,
            input: FGUYPickInput == undefined ? 'c' : FGUYPickInput, ready: false};
}

function FGUYSendPick() {
    FGUYDo('pick', FGUYPickChar, FGUYPickCostume, FGUYPickTeam, FGUYPickInput);
}

function FGUYInputName(input) {
    return input == 'k' ? 'Keyboard & mouse' : 'Controller';
}

function FGUYSendConf() {
    FGUYDo('conf', FGUYS.mode, FGUYS.map, FGUYS.time, FGUYS.score, FGUYS.ff);
}

// ---- the page ----------------------------------------------------------------------------------------------------
// Main Menu > MODS: the same page as ONLINE (its own screen, no server).
function OnModsSelect() {
    FGUYModsPage = true;
    OnOnlineSelect();
}

function OnOnlineSelect() {
    FGUYOnline = true;
    PauseTVSound();
    PlayOptionsSubMenuMusic();
    GotoPage('OptionsScreen');
}

// My own settings - read with the game's own getters - for the next match: the session game plays on the host's
// save, so it takes mine from here (src/loader/onlinesettings.cpp).
function FGUYReportSettings() {
    var X = flash.external.ExternalInterface;
    var s = 'aim=' + Math.round(Number(X.call('OPTN_GetAimSensitivity')) * 100) +
            ';inv=' + (X.call('OPTN_GetInvertYAxis') == true ? 1 : 0) +
            ';ret=' + (X.call('OPTN_GetReticlesEnabled') == true ? 1 : 0) +
            ';sub=' + (X.call('MENU_IsSubtitlesEnabled') == true ? 1 : 0) +
            ';mus=' + Number(X.call('SNDS_GetMusicVolume')) + ';sfx=' + Number(X.call('SNDS_GetSoundFXVolume')) +
            ';dlg=' + Number(X.call('SNDS_GetDialogVolume')) + ';cin=' + Number(X.call('SNDS_GetCinematicVolume'));
    X.call('FGUYMOD_MySettings', s);
}

// Back from a match: what I changed there, through the game's own setters (as Options would - and the save
// keeps them).
function FGUYApplySettingsBack() {
    var X = flash.external.ExternalInterface;
    var back = X.call('FGUYMOD_SettingsBack');
    if (back == undefined || String(back) == '') return;
    var m = {}, f = String(back).split(';');
    for (var i = 0; i < f.length; i++) {
        var kv = f[i].split('=');
        m[kv[0]] = kv[1];
    }
    X.call('OPTN_SetAimSensitivity', Number(m.aim) / 100);
    if ((X.call('OPTN_GetInvertYAxis') == true) != (m.inv == '1')) X.call('OPTN_ToggleInvertYAxis');
    if ((X.call('OPTN_GetReticlesEnabled') == true) != (m.ret == '1')) X.call('OPTN_ToggleReticlesEnabled');
    getURL('FSCommand:MENU_SetSubtitlesEnabled', m.sub == '1' ? 'true' : 'false');
    getURL('FSCommand:SNDS_SetMusicVolume', Number(m.mus));
    getURL('FSCommand:SNDS_SetSoundFXVolume', Number(m.sfx));
    getURL('FSCommand:SNDS_SetDialogVolume', Number(m.dlg));
    getURL('FSCommand:SNDS_SetCinematicVolume', Number(m.cin));
}

function OnOnlineEnter() {
    if (FGUYModsPage) { FGUYModsEnter(); return; }
    flash.external.ExternalInterface.call('FGUYMOD_OnlineEnter');
    FGUYReportSettings();
    _root.subMenu._visible = false;
    Selection.setFocus(null);   // a menu button left with focus would swallow A / Enter
    FGUYColors();
    FGUYData();
    FGUYScreen = 'hub';
    FGUYHubPanel = 0;
    FGUYFocus = 0;
    FGUYHostPrivate = 0;
    FGUYHostMax = 4;
    FGUYFind = 0;
    FGUYCode = [0, 0, 0, 0];
    FGUYCodeLen = 0;
    FGUYCodePos = 0;
    FGUYCodeChars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';   // as the server's codes (no I O 0 1)
    if (FGUYPickChar == undefined) { FGUYPickChar = 'Peter'; FGUYPickCostume = 0; FGUYPickTeam = 0; }
    FGUYLastBlob = '';
    FGUYS = FGUYParse('');
    FGUYBot = flash.external.ExternalInterface.call('FGUYMOD_IsBot') == true;
    FGUYBotNext = 0;
    FGUYEnteredAt = FGUYNow();
    FGUY3DStart();
    FGUYDraw();
    FGUYTimer = setInterval(FGUYPoll, 150);
}

function OnOnlineExit() {
    if (FGUYModsPage) {
        FGUYModsPage = false;
        _root.FGUYLobbyUI.removeMovieClip();
        _root.subMenu._visible = true;
        FGUYOnline = false;
        return;
    }
    clearInterval(FGUYTimer);
    FGUY3DStop();
    flash.external.ExternalInterface.call('FGUYMOD_OnlineExit');
    _root.FGUYLobbyUI.removeMovieClip();
    _root.subMenu._visible = true;
    FGUYOnline = false;
}

// ---- the mouse ------------------------------------------------------------------------------------------------------
// Every redraw registers the clickable things (FGUYHit: a box, a kind and an index); at the end of the draw each
// gets an invisible clip on top of everything. Hovering selects what's under the cursor (like moving there with
// the d-pad), clicking does what A does there. The handlers run with `this` = the clip.
function FGUYHit(x, y, w, h, kind, index) {
    FGUYHits.push({x: x, y: y, w: w, h: h, kind: kind, index: index});
}

function FGUYMakeHits(ui) {
    for (var i = 0; i < FGUYHits.length; i++) {
        var hit = FGUYHits[i];
        if (hit.kind == 'stage') { FGUYMakeStage(ui, hit, i); continue; }
        var c = ui.createEmptyMovieClip('hit' + i, ui.getNextHighestDepth());
        c.beginFill(0xFFFFFF, 0);
        c.moveTo(hit.x, hit.y);
        c.lineTo(hit.x + hit.w, hit.y);
        c.lineTo(hit.x + hit.w, hit.y + hit.h);
        c.lineTo(hit.x, hit.y + hit.h);
        c.lineTo(hit.x, hit.y);
        c.endFill();
        c.fgKind = hit.kind;
        c.fgIndex = hit.index;
        c.onRollOver = FGUYHitOver;
        c.onRelease = FGUYHitPress;
    }
}

// The 3D character's window: press and drag to turn the character (Q / E turn it too, in the loader).
function FGUYMakeStage(ui, hit, i) {
    var c = ui.createEmptyMovieClip('hit' + i, ui.getNextHighestDepth());
    c.beginFill(0xFFFFFF, 0);
    c.moveTo(hit.x, hit.y);
    c.lineTo(hit.x + hit.w, hit.y);
    c.lineTo(hit.x + hit.w, hit.y + hit.h);
    c.lineTo(hit.x, hit.y + hit.h);
    c.lineTo(hit.x, hit.y);
    c.endFill();
    c.onPress = FGUYStagePress;
    c.onMouseMove = FGUYStageMove;
    c.onMouseUp = FGUYStageRelease;
}

function FGUYStagePress() {
    FGUYDragging = true;
    FGUYDragX = _root._xmouse;
}

function FGUYStageMove() {
    if (!FGUYDragging) return;
    var x = _root._xmouse;
    flash.external.ExternalInterface.call('FGUYMOD_TurnPreview', (x - FGUYDragX) * 0.012);
    FGUYDragX = x;
}

function FGUYStageRelease() {
    FGUYDragging = false;
}

function FGUYHitOver() {
    if (FGUYMouseHover(this.fgKind, this.fgIndex)) { FGUYSound('nav'); FGUYDraw(); }
}

function FGUYHitPress() {
    FGUYKeyFromPad = false;
    FGUYMouseClick(this.fgKind, this.fgIndex);
    if (FGUYOnline) FGUYDraw();
}

// Hover: select what's under the cursor. Returns true if that changed anything.
function FGUYMouseHover(kind, i) {
    var was = FGUYScreen + FGUYHubPanel + ',' + FGUYFocus + ',' + FGUYFind + ',' + FGUYCharSel + ',' + FGUYCostumeSel;
    if (kind == 'hubPanel') { if (FGUYHubPanel != i) { FGUYHubPanel = i; FGUYFocus = 0; } }
    else if (kind == 'hostPrivate' || kind == 'hostMax' || kind == 'hostCreate') {
        FGUYHubPanel = 0;
        FGUYFocus = kind == 'hostPrivate' ? 0 : (kind == 'hostMax' ? 1 : 2);
    } else if (kind == 'find') { FGUYHubPanel = 1; FGUYFind = i; }
    else if (kind == 'codeBox') { FGUYHubPanel = 2; FGUYFocus = 0; }
    else if (kind == 'codeJoin') { FGUYHubPanel = 2; FGUYFocus = 1; }
    else if (kind == 'lobbyItem' || kind == 'lobbyItemLeft' || kind == 'lobbyItemRight' ||
             kind == 'setRow' || kind == 'setRowLeft' || kind == 'setRowRight') FGUYFocus = i;
    else if (kind == 'charCard') { if (FGUYCharSel != i) { FGUYCharSel = i; FGUYCostumeSel = 0; } }
    else if (kind == 'skin') FGUYCostumeSel = i;
    else if (kind == 'modRow') FGUYModsSel = i;
    var now = FGUYScreen + FGUYHubPanel + ',' + FGUYFocus + ',' + FGUYFind + ',' + FGUYCharSel + ',' + FGUYCostumeSel;
    return now != was;
}

// Click: do what A (or the arrow, or the button in a hint) does there.
function FGUYMouseClick(kind, i) {
    FGUYMouseHover(kind, i);
    var online = FGUYS.state == 'online';
    if (kind == 'hostPrivate') { FGUYHostPrivate = i; FGUYSound('change'); }
    else if (kind == 'hostMax') { FGUYHostMax = i; FGUYSound('change'); }
    else if (kind == 'hostCreate' || kind == 'find') FGUYInputHub(13);
    else if (kind == 'codeBox') { FGUYCodePos = Math.min(i, FGUYCodeLen < 4 ? FGUYCodeLen : 3); FGUYSound('nav'); }
    else if (kind == 'codeJoin') FGUYInputCode(13, online);
    else if (kind == 'lobbyItem') FGUYInputLobby(13);
    else if (kind == 'lobbyItemLeft') FGUYInputLobby(37);
    else if (kind == 'lobbyItemRight') FGUYInputLobby(39);
    else if (kind == 'setRow') FGUYInputSettings(FGUYIsHost() ? 13 : 39);
    else if (kind == 'setRowLeft') FGUYInputSettings(37);
    else if (kind == 'setRowRight') FGUYInputSettings(39);
    else if (kind == 'charCard') FGUYInputChar(13);
    else if (kind == 'skin') FGUYSound('change');
    else if (kind == 'team') { FGUYPickTeam = i; FGUYSound('change'); }
    else if (kind == 'key') FGUYScreenKey(i);   // a footer button hint: its button
    else if (kind == 'modRow') FGUYInputMods(13);
}

function FGUYScreenKey(key) {   // a key, as if pressed (footer hints, mouse)
    if (FGUYScreen == 'mods') FGUYInputMods(key);
    else if (FGUYScreen == 'hub') FGUYInputHub(key);
    else if (FGUYScreen == 'lobby') FGUYInputLobby(key);
    else if (FGUYScreen == 'char') FGUYInputChar(key);
    else if (FGUYScreen == 'settings') FGUYInputSettings(key);
}

// The test bot (FGUYMOD_BOT): a hidden copy of the game that joins a lobby and readies up by itself.
function FGUYBotStep() {
    var now = FGUYNow();
    if (now < FGUYBotNext) return;
    FGUYBotNext = now + 2000;
    if (FGUYS.state == 'online') {
        var code = String(flash.external.ExternalInterface.call('FGUYMOD_BotJoin'));
        if (code != '' && code != 'undefined') FGUYDo('join', code);
        else if (FGUYS.lobbies.length > 0) FGUYDo('join', FGUYS.lobbies[0].code);
        FGUYBotPicked = false;
    } else if (FGUYS.state == 'lobby' && FGUYS.slot > 0) {
        if (!FGUYBotPicked) {   // someone at random from the host's list
            FGUYBotPicked = true;
            FGUYChars = FGUYCharList();
            FGUYPickChar = FGUYChars[Math.floor(Math.random() * FGUYChars.length)];
            var list = FGUYCostumeList(FGUYPickChar);
            FGUYPickCostume = list.length > 0 ? list[Math.floor(Math.random() * list.length)].CostumeIndex : 0;
            FGUYPickTeam = Math.random() < 0.5 ? 0 : 1;
            FGUYPickInput = 'c';
            FGUYSendPick();
        } else if (!FGUYMe().ready) { FGUYDo('ready'); FGUYBotNext = now + 5000; }   // (it toggles: give it time)
    }
}

// ---- drawing: one full redraw per change -------------------------------------------------------------------------
function FGUYDraw() {
    _root.FGUYLobbyUI.removeMovieClip();
    var ui = _root.createEmptyMovieClip('FGUYLobbyUI', 20000);
    var vr = Stage.visibleRect;
    var left = 0, width = 960;
    if (vr) { left = vr.x; width = vr.width; }
    ui._x = left;
    ui._xscale = width / 1600 * 100;
    ui._yscale = 720 / 900 * 100;
    FGUYTextN = 0;
    FGUYHits = [];
    // the background, with a window left open for the 3D character on the lobby and character screens
    var hole = null;
    if (FGUYScreen == 'lobby') hole = [483, 309, 554, 502];
    else if (FGUYScreen == 'char') hole = [1045, 123, 504, 437];
    if (hole == null) FGUYRect(ui, 0, 0, 1600, 900, 0, FGUYC.bg, 100, 0, 0, 0);
    else {
        var hx = hole[0], hy = hole[1], hw = hole[2], hh = hole[3];
        FGUYRect(ui, 0, 0, 1600, hy + 1, 0, FGUYC.bg, 100, 0, 0, 0);
        FGUYRect(ui, 0, hy + hh - 1, 1600, 901 - hy - hh, 0, FGUYC.bg, 100, 0, 0, 0);
        FGUYRect(ui, 0, hy, hx + 1, hh, 0, FGUYC.bg, 100, 0, 0, 0);
        FGUYRect(ui, hx + hw - 1, hy, 1601 - hx - hw, hh, 0, FGUYC.bg, 100, 0, 0, 0);
    }
    if (FGUYScreen == 'mods') FGUYDrawMods(ui);
    else if (FGUYScreen == 'hub') FGUYDrawHub(ui);
    else if (FGUYScreen == 'lobby') FGUYDrawLobby(ui);
    else if (FGUYScreen == 'char') FGUYDrawChar(ui);
    else if (FGUYScreen == 'loading') FGUYDrawLoading(ui);
    else FGUYDrawSettings(ui);
    FGUYMakeHits(ui);
}

function FGUYStatusChip(ui) {
    var st = FGUYS.state, text = 'Not connected', dot = FGUYC.redLine;
    if (st == 'connecting') { text = 'Connecting to the server...'; dot = FGUYC.yellow; }
    else if (st == 'failed') text = FGUYS.status != '' ? FGUYS.status : 'Server offline';
    else if (st == 'online' || st == 'lobby' || st == 'starting') {
        text = 'Server online' + (FGUYS.ping > 0 ? ' - ' + FGUYS.ping + ' ms' : '');
        dot = FGUYC.greenLine;
    }
    FGUYRect(ui, 1120, 40, 432, 44, 22, FGUYC.chip, 100, dot, 100, 2);
    FGUYCircle(ui, 1146, 62, 6, dot, 100, 0, 0);
    FGUYText(ui, 1160, 48, 380, 34, text, false, 20, FGUYC.white, 'left');
}

// Footer: button hints on the left; on the right what's happening (tone: 'info', 'good' or 'warn'), or for a
// moment a note about something that just changed (FGUYToast).
function FGUYFooter(ui, hints, note, tone) {
    var x = 48;
    for (var i = 0; i < hints.length; i = i + 2) {
        if (hints[i] == 'ARROWS') x = FGUYArrowsHint(ui, x, 850, hints[i + 1]);
        else x = FGUYButtonHint(ui, x, 850, hints[i], hints[i + 1]);
    }
    if (FGUYToastUntil > FGUYNow()) { note = FGUYToastText; tone = 'toast'; }
    if (note == undefined || note == '') return;
    var fill = FGUYC.chip, line = FGUYC.chipLine, ink = FGUYC.soft;
    if (tone == 'good') { fill = FGUYC.green; line = FGUYC.greenLine; ink = FGUYC.white; }
    else if (tone == 'warn') { fill = 0x3A2A10; line = FGUYC.yellow; ink = FGUYC.yellow; }
    else if (tone == 'toast') { fill = FGUYC.yellow; line = FGUYC.white; ink = FGUYC.dark; }
    var w = Math.min(820, 60 + note.length * 11);
    FGUYRect(ui, 1552 - w, 840, w, 46, 23, fill, 100, line, 100, 2);
    FGUYText(ui, 1552 - w + 14, 847, w - 28, 34, note, false, 20, ink, 'center');
}

function FGUYToast(text) {
    FGUYToastText = text;
    FGUYToastUntil = FGUYNow() + 2800;
}

// A left / right arrows hint (the d-pad has no button picture).
function FGUYArrowsHint(ui, x, y, label) {
    FGUYCircle(ui, x + 17, y + 17, 16, 0x3B4A60, 100, FGUYC.white, 2);
    FGUYPoly(ui, [x + 5, y + 17, x + 14, y + 10, x + 14, y + 24], FGUYC.white, 100);
    FGUYPoly(ui, [x + 29, y + 17, x + 20, y + 10, x + 20, y + 24], FGUYC.white, 100);
    FGUYText(ui, x + 40, y + 2, 200, 34, label, false, 20, FGUYC.white, 'left');
    return x + 56 + label.length * 10;
}

// A selectable row: label (yellow cartoon text) and value. arrows: the value can be changed with left /
// right (shown on the selected row). locked: shows who can change it instead.
function FGUYRow(ui, x, y, w, h, label, value, hot, arrows, locked, kind, index) {
    if (kind != undefined) FGUYHit(x, y, w, h, kind, index);
    if (hot) {
        FGUYRect(ui, x - 4, y - 4, w + 8, h + 8, 20, FGUYC.yellow, 30, 0, 0, 0);
        FGUYRect(ui, x, y, w, h, 16, FGUYC.rowHot, 100, FGUYC.yellow, 100, 3);
    } else {
        FGUYRect(ui, x, y, w, h, 16, FGUYC.row, 100, FGUYC.rowLine, 100, 2);
    }
    var lt = FGUYTitle(ui, x + 20, y + (h - 36) / 2, w * 0.55, 40, label, 26, FGUYC.yellow, 'left');
    var right = hot && arrows ? x + w - 40 : x + w - 20;
    var left = x + 20 + lt.textWidth + (hot && arrows ? 44 : 18);   // the value never runs into the label
    // the arrows stay put whatever the value (a moving arrow made the next click land on the row instead)
    var lx = Math.max(x + w - 300, left - 30);
    if (hot && arrows) left = lx + 24;
    var t = FGUYText(ui, left, y + (h - 30) / 2 + 2, right - left, 32, value, false, 20, FGUYC.white, hot && arrows ? 'center' : 'right');
    var cy = y + h / 2;
    if (hot && arrows) {
        FGUYPoly(ui, [lx, cy, lx + 12, cy - 10, lx + 12, cy + 10], FGUYC.yellow, 100);
        FGUYPoly(ui, [x + w - 16, cy, x + w - 28, cy - 10, x + w - 28, cy + 10], FGUYC.yellow, 100);
        if (kind != undefined) {
            FGUYHit(lx - 10, y, 32, h, kind + 'Left', index);
            FGUYHit(x + w - 38, y, 38, h, kind + 'Right', index);
        }
    } else if (hot && locked != undefined && locked != '') {
        FGUYRect(ui, x + w - 150, y - 14, 140, 24, 12, FGUYC.ink, 100, FGUYC.chipLine, 100, 1);
        FGUYText(ui, x + w - 150, y - 12, 140, 22, locked, false, 14, FGUYC.muted2, 'center');
    }
}

// A big yellow action button.
function FGUYBigButton(ui, x, y, w, h, label, note, hot, enabled) {
    var fill = enabled ? FGUYC.yellow : 0x6B6430;
    if (hot) FGUYRect(ui, x - 6, y - 6, w + 12, h + 12, 24, FGUYC.yellow, 35, 0, 0, 0);
    FGUYRect(ui, x, y, w, h, 18, fill, 100, hot ? FGUYC.white : FGUYC.ink, 100, 3);
    FGUYText(ui, x + 20, y + (h - 46) / 2, note == '' ? w - 40 : w * 0.62, 50, label, true, 34, FGUYC.dark, note == '' ? 'center' : 'left');
    if (note != '') FGUYText(ui, x + w * 0.6, y + (h - 26) / 2, w * 0.4 - 20, 30, note, false, 18, FGUYC.dark, 'right');
}

function FGUYChoice(ui, x, y, w, label, picked, hot) {
    if (picked) FGUYRect(ui, x, y, w, 58, 14, FGUYC.yellow, 100, hot ? FGUYC.white : FGUYC.yellow, 100, hot ? 3 : 2);
    else FGUYRect(ui, x, y, w, 58, 14, FGUYC.panel2, 100, hot ? FGUYC.yellow : FGUYC.chipLine, 100, 2);
    FGUYText(ui, x, y + 12, w, 34, label, false, 22, picked ? FGUYC.dark : FGUYC.white, 'center');
}

// ---- hub -------------------------------------------------------------------------------------------------------------
function FGUYDrawHub(ui) {
    FGUYTitle(ui, 48, 26, 600, 80, 'ONLINE', 60, FGUYC.title, 'left');
    FGUYStatusChip(ui);
    FGUYText(ui, 640, 50, 460, 30, FGUYS.name != '' ? 'Playing as ' + FGUYS.name : '', false, 20, FGUYC.muted2, 'right');
    var online = FGUYS.state == 'online';
    var px = [48, 545, 1042], pw = 494, py = 130, ph = 690;
    for (var p = 0; p < 3; p++) {
        FGUYPanel(ui, px[p], py, pw, ph, 28, p == 0 ? FGUYC.panel2 : FGUYC.panel, FGUYHubPanel == p ? FGUYC.yellow : FGUYC.glow);
        FGUYHit(px[p], py, pw, ph, 'hubPanel', p);
    }
    // host
    var x = px[0] + 28, hot = FGUYHubPanel == 0;
    FGUYTitle(ui, x, py + 24, pw - 56, 56, 'HOST A GAME', 40, FGUYC.yellow, 'left');
    FGUYText(ui, x, py + 92, pw - 56, 30, 'Make a lobby. You pick the mode, map', false, 19, FGUYC.soft, 'left');
    FGUYText(ui, x, py + 118, pw - 56, 30, 'and rules in the lobby.', false, 19, FGUYC.soft, 'left');
    FGUYText(ui, x, py + 172, 300, 26, 'WHO CAN JOIN', false, 16, FGUYC.muted, 'left');
    FGUYChoice(ui, x, py + 200, 213, 'Anyone', FGUYHostPrivate == 0, hot && FGUYFocus == 0);
    FGUYChoice(ui, x + 225, py + 200, 213, 'Code only', FGUYHostPrivate == 1, hot && FGUYFocus == 0);
    FGUYHit(x, py + 200, 213, 58, 'hostPrivate', 0);
    FGUYHit(x + 225, py + 200, 213, 58, 'hostPrivate', 1);
    FGUYText(ui, x, py + 286, 300, 26, 'PLAYERS', false, 16, FGUYC.muted, 'left');
    for (var n = 2; n <= 4; n++) {
        FGUYChoice(ui, x + (n - 2) * 148, py + 314, 138, String(n), FGUYHostMax == n, hot && FGUYFocus == 1);
        FGUYHit(x + (n - 2) * 148, py + 314, 138, 58, 'hostMax', n);
    }
    FGUYBigButton(ui, x, py + ph - 120, pw - 56, 90, 'CREATE LOBBY', '', hot && FGUYFocus == 2, online);
    FGUYHit(x, py + ph - 120, pw - 56, 90, 'hostCreate', 0);
    // find
    x = px[1] + 28;
    FGUYTitle(ui, x, py + 24, pw - 56, 56, 'FIND A GAME', 40, FGUYC.title, 'left');
    var games = FGUYS.lobbies;
    FGUYText(ui, x, py + 34, pw - 56, 30, games.length + ' open', false, 18, FGUYC.muted, 'right');
    if (FGUYFind >= games.length) FGUYFind = games.length > 0 ? games.length - 1 : 0;
    if (games.length == 0)
        FGUYText(ui, x, py + 110, pw - 56, 30, online ? 'No open games right now - host one!' : 'Waiting for the server...', false, 19, FGUYC.muted2, 'left');
    var first = Math.max(0, Math.min(FGUYFind - 4, games.length - 7));
    for (var i = first; i < games.length && i < first + 7; i++) {
        var g = games[i], y = py + 96 + (i - first) * 76;
        var sel = FGUYHubPanel == 1 && FGUYFind == i;
        FGUYRect(ui, x, y, pw - 56, 66, 16, sel ? FGUYC.rowHot : FGUYC.row, 100, sel ? FGUYC.yellow : FGUYC.rowLine, 100, sel ? 3 : 2);
        FGUYHit(x, y, pw - 56, 66, 'find', i);
        FGUYText(ui, x + 16, y + 6, 300, 30, g.host + "'s game", false, 21, FGUYC.white, 'left');
        FGUYText(ui, x + 16, y + 34, 330, 26, FGUYMode(g.mode).name + ' - ' + FGUYMapName(g.map, g.mode) +
                 (g.mods != '' ? ' - mods: ' + g.mods : ''), false, 16, g.mods != '' ? FGUYC.yellow : FGUYC.muted2, 'left');
        FGUYText(ui, x + pw - 56 - 120, y + 18, 104, 30, g.players + ' / ' + g.max, false, 21, FGUYC.white, 'right');
    }
    FGUYText(ui, x, py + ph - 50, pw - 56, 30, 'Press A or click a game to join', false, 17, FGUYC.muted, 'left');
    // code
    x = px[2] + 28;
    FGUYTitle(ui, x, py + 24, pw - 56, 56, 'JOIN WITH CODE', 40, FGUYC.title, 'left');
    FGUYText(ui, x, py + 92, pw - 56, 30, 'Got a code from a friend?', false, 19, FGUYC.soft, 'left');
    FGUYText(ui, x, py + 118, pw - 56, 30, 'Codes are 4 letters or numbers.', false, 19, FGUYC.soft, 'left');
    FGUYText(ui, x, py + 172, 300, 26, 'LOBBY CODE', false, 16, FGUYC.muted, 'left');
    for (var k = 0; k < 4; k++) {
        var bx = x + k * 112, edit = FGUYHubPanel == 2 && FGUYFocus == 0 && FGUYCodePos == k;
        FGUYRect(ui, bx, py + 200, 100, 110, 16, FGUYC.deep, 100, edit ? FGUYC.yellow : FGUYC.chipLine, 100, 3);
        FGUYHit(bx, py + 200, 100, 110, 'codeBox', k);
        var ch = k < FGUYCodeLen || edit ? FGUYCodeChars.charAt(FGUYCode[k]) : '_';
        FGUYTitle(ui, bx, py + 222, 100, 70, ch, 56, edit ? FGUYC.yellow : (k < FGUYCodeLen ? FGUYC.white : FGUYC.chipLine), 'center');
    }
    FGUYText(ui, x, py + 330, pw - 56, 30, 'Just type it - or up / down on a controller', false, 17, FGUYC.muted, 'left');
    var codeHot = FGUYHubPanel == 2 && FGUYFocus == 1;
    FGUYRect(ui, x, py + ph - 120, pw - 56, 90, 18, FGUYC.rowHot, 100, codeHot ? FGUYC.yellow : FGUYC.glow, 100, 3);
    FGUYHit(x, py + ph - 120, pw - 56, 90, 'codeJoin', 0);
    FGUYTitle(ui, x, py + ph - 100, pw - 56, 56, 'JOIN', 36, FGUYC.white, 'center');
    if (FGUYS.status != '' && FGUYS.state == 'online') FGUYText(ui, 48, 824, 1504, 28, FGUYS.status, false, 18, FGUYC.red, 'left');
    var hints = ['A', 'Select', 'B', 'Main menu', 'LB', 'Switch panel'];
    var reports = Number(flash.external.ExternalInterface.call('FGUYMOD_ReportCount'));   // (saved when a match went wrong)
    if (reports > 0) { hints.push('Y'); hints.push('Reports (' + reports + ')'); }
    FGUYFooter(ui, hints, '');
}

// ---- lobby --------------------------------------------------------------------------------------------------------
function FGUYLobbyItems() {
    return [FGUYIsHost() ? 'start' : 'ready', 'mode', 'map', 'settings', 'char', 'skin', 'team', 'controls', 'chat', 'leave'];
}

function FGUYReadyCount() {
    var n = 0;
    for (var i = 0; i < FGUYS.members.length; i++) if (FGUYS.members[i].slot == 0 || FGUYS.members[i].ready) n++;
    return n;
}

function FGUYDrawLobby(ui) {
    var host = FGUYIsHost(), me = FGUYMe(), mode = FGUYMode(FGUYS.mode);
    FGUYTitle(ui, 48, 26, 560, 80, 'ONLINE LOBBY', 60, FGUYC.title, 'left');
    FGUYRect(ui, 600, 46, 140, 40, 20, FGUYC.chip, 100, FGUYC.chipLine, 100, 2);
    FGUYText(ui, 600, 52, 140, 30, FGUYS.priv ? 'CODE ONLY' : 'PUBLIC', false, 18, FGUYC.white, 'center');
    FGUYRect(ui, 752, 46, 190, 40, 20, FGUYC.chip, 100, FGUYC.chipLine, 100, 2);
    FGUYText(ui, 752, 52, 190, 30, 'CODE  ' + FGUYS.code, false, 18, FGUYC.yellow, 'center');
    FGUYText(ui, 1120, 52, 432, 30, 'Connected - ' + FGUYS.ping + ' ms', false, 20, FGUYC.muted2, 'right');

    // left: actions
    var items = FGUYLobbyItems(), y = 130;
    for (var i = 0; i < items.length; i++) {
        var it = items[i], hot = FGUYFocus == i;
        if (it == 'start') {
            var ready = FGUYReadyCount(), all = ready == FGUYS.members.length && FGUYS.members.length > 1;
            FGUYBigButton(ui, 48, y, 400, 76, 'START MATCH', ready + ' / ' + FGUYS.members.length + ' ready', hot, all);
            FGUYHit(48, y, 400, 76, 'lobbyItem', i);
            y = y + 92;
        } else if (it == 'ready') {
            FGUYBigButton(ui, 48, y, 400, 76, me.ready ? 'READY!' : 'READY UP', me.ready ? 'waiting for host' : '', hot, true);
            FGUYHit(48, y, 400, 76, 'lobbyItem', i);
            y = y + 92;
        } else if (it == 'leave') {
            y = 778;
            FGUYRect(ui, 48, y, 400, 56, 16, FGUYC.bg, 100, hot ? FGUYC.yellow : FGUYC.redLine, 100, 2);
            FGUYHit(48, y, 400, 56, 'lobbyItem', i);
            FGUYText(ui, 70, y + 12, 360, 32, 'Leave lobby', false, 21, FGUYC.red, 'left');
        } else {
            var label = '', value = '';
            if (it == 'mode') { label = 'GAME MODE'; value = mode.name; }
            else if (it == 'map') { label = mode.code == 'ST' ? 'LEVEL' : 'MAP'; value = FGUYMapName(FGUYS.map, FGUYS.mode); }
            else if (it == 'settings') { label = 'MATCH SETTINGS'; value = FGUYRulesLine(true); }
            else if (it == 'char') { label = 'CHARACTER'; value = FGUYCharName(FGUYPickChar); }
            else if (it == 'skin') { label = 'SKIN'; value = FGUYCostumeName(FGUYPickChar, FGUYPickCostume); }
            else if (it == 'team') { label = 'TEAM'; value = mode.teams ? (FGUYPickTeam == 1 ? 'Evil' : 'Good') : 'Everyone together'; }
            else if (it == 'controls') { label = 'CONTROLS'; value = FGUYInputName(FGUYPickInput); }
            else if (it == 'chat') { label = 'CHAT'; value = FGUYQuickChat()[FGUYChatQuick]; }
            if (it == 'char') y = y + 8;
            var changeable = it == 'char' || it == 'skin' || it == 'controls' || it == 'chat' || (it == 'team' && mode.teams) || ((it == 'mode' || it == 'map') && host);
            FGUYRow(ui, 48, y, 400, 62, label, value, hot, changeable, (it == 'mode' || it == 'map' || it == 'settings') && !host ? 'Host picks' : '',
                    'lobbyItem', i);
            y = y + 68;
        }
    }

    // centre: the match, and my character live in 3D
    var cx = 480, cw = 560, rules = FGUYRulesParts(false);
    FGUYPanel(ui, cx, 130, cw, 160, 24, FGUYC.panel2, FGUYC.glow);
    FGUYMapPicture(ui, FGUYS.map, FGUYS.mode, cx + 3, 133, 250, 154, 21);
    FGUYTitle(ui, cx + 272, 140, cw - 290, 40, mode.name, 26, FGUYC.title, 'left');
    FGUYText(ui, cx + 272, 184, cw - 290, 30, FGUYMapName(FGUYS.map, FGUYS.mode), false, 21, FGUYC.white, 'left');
    FGUYText(ui, cx + 272, 216, cw - 290, 28, rules.slice(0, 2).join(' - '), false, 17, FGUYC.soft, 'left');
    FGUYText(ui, cx + 272, 242, cw - 290, 28, rules.slice(2).join(' - '), false, 17, FGUYC.soft, 'left');
    FGUYStage(ui, cx, 306, cw, 508);
    FGUYHit(cx + 3, 309, cw - 6, 430, 'stage', 0);
    FGUY3DShow(FGUYPickChar, FGUYPickCostume);
    FGUYStageView(cx + cw / 2, 332, 724);
    FGUYRect(ui, cx + 16, 322, 170, 32, 16, FGUYC.ink, 70, 0, 0, 0);
    FGUYText(ui, cx + 16, 326, 170, 26, "YOU'RE PLAYING", false, 15, FGUYC.muted2, 'center');
    FGUYRect(ui, cx + 3, 744, cw - 6, 67, 4, FGUYC.ink, 78, 0, 0, 0);
    FGUYTitle(ui, cx + 22, 748, 280, 56, FGUYCharName(FGUYPickChar), 40, FGUYC.yellow, 'left');
    FGUYText(ui, cx + 290, 750, cw - 312, 28, 'Skin: ' + FGUYCostumeName(FGUYPickChar, FGUYPickCostume), false, 18, FGUYC.soft, 'right');
    FGUYText(ui, cx + 290, 778, cw - 312, 28, (mode.teams ? 'Team ' + (FGUYPickTeam == 1 ? 'Evil' : 'Good') + ' - ' : '') + 'Y to change', false, 17, FGUYC.muted, 'right');

    // right: players
    var rx = 1072, rw = 480;
    FGUYPanel(ui, rx, 130, rw, 684, 28, FGUYC.panel, FGUYC.glow);
    FGUYTitle(ui, rx + 22, 148, 300, 46, 'PLAYERS', 32, FGUYC.title, 'left');
    FGUYText(ui, rx + rw - 140, 156, 118, 30, FGUYS.members.length + ' / 4', false, 21, FGUYC.soft, 'right');
    var ry = 206;
    if (mode.teams) {
        for (var team = 0; team < 2; team++) {
            FGUYText(ui, rx + 22, ry, 300, 24, team == 0 ? 'GOOD TEAM' : 'EVIL TEAM', false, 15, team == 0 ? FGUYC.good : FGUYC.evil, 'left');
            ry = ry + 28;
            for (var m = 0; m < FGUYS.members.length; m++)
                if (FGUYS.members[m].team == team) { FGUYPlayerRow(ui, rx + 18, ry, rw - 36, FGUYS.members[m]); ry = ry + 84; }
            ry = ry + 8;
        }
    } else {
        for (var m2 = 0; m2 < FGUYS.members.length; m2++) { FGUYPlayerRow(ui, rx + 18, ry, rw - 36, FGUYS.members[m2]); ry = ry + 84; }
    }
    for (var open = FGUYS.members.length; open < 4 && ry < 730; open++) {
        FGUYRect(ui, rx + 18, ry, rw - 36, 72, 16, FGUYC.panel, 0, FGUYC.chipLine, 100, 2);
        FGUYCircle(ui, rx + 54, ry + 36, 24, 0, 0, FGUYC.chipLine, 2);
        FGUYText(ui, rx + 92, ry + 22, rw - 130, 30, 'Open slot - share code ' + FGUYS.code, false, 18, FGUYC.muted, 'left');
        ry = ry + 84;
    }
    FGUYDrawChat(ui, rx, Math.max(ry + 6, 600), rw);
    var status = FGUYLobbyStatus();
    FGUYFooter(ui, ['A', 'Select', 'ARROWS', 'Change', 'X', host ? 'Start' : 'Ready up', 'Y', 'Character', 'B', 'Leave'],
               status[0], status[1]);
}

// ---- chat ------------------------------------------------------------------------------------------------------------
// The lobby's chat (the server passes each line to everyone in the lobby): the last lines under the players. Keyboard:
// T (or A on the CHAT row) types a message - Enter sends, Esc cancels; the loader hands over every typed character
// while the box is open (FGUYMOD_ChatMode / ChatTyped). Controller: left / right on the CHAT row picks a quick
// message, A sends it.
function FGUYQuickChat() {
    return ['Ready?', 'Ready!', 'One sec', "Let's go!", 'GG', 'Rematch?', 'Nice!', 'Brb'];
}

function FGUYDrawChat(ui, x, y, w) {
    FGUYText(ui, x + 22, y, 200, 24, 'CHAT', false, 15, FGUYC.muted, 'left');
    var lines = FGUYS.chat, first = Math.max(0, lines.length - 4);
    for (var i = first; i < lines.length; i++)
        FGUYText(ui, x + 22, y + 24 + (i - first) * 24, w - 44, 24, lines[i].name + ':  ' + lines[i].text, false, 16,
                 lines[i].name == FGUYS.name ? FGUYC.yellow : FGUYC.white, 'left');
    var by = y + 24 + 4 * 24 + 6;
    FGUYRect(ui, x + 18, by, w - 36, 38, 12, FGUYC.deep, 100, FGUYChatTyping ? FGUYC.yellow : FGUYC.chipLine, 100, 2);
    var hint = FGUYChatTyping ? FGUYChatDraft + '_' : 'T: type a message  -  CHAT row: quick messages';
    FGUYText(ui, x + 30, by + 7, w - 60, 28, hint, false, 16, FGUYChatTyping ? FGUYC.white : FGUYC.muted, 'left');
}

function FGUYChatOpen() {
    FGUYChatTyping = true;
    FGUYChatDraft = '';
    flash.external.ExternalInterface.call('FGUYMOD_ChatMode', 1);
    FGUYSound('nav');
}

function FGUYChatClose(send) {
    if (send && FGUYChatDraft != '') FGUYDo('say', FGUYChatDraft);
    FGUYChatTyping = false;
    FGUYChatDraft = '';
    flash.external.ExternalInterface.call('FGUYMOD_ChatMode', 0);
    FGUYSound(send ? 'accept' : 'back');
}

// (FGUYPoll, while the box is open) the characters typed since
function FGUYChatPoll() {
    if (FGUYScreen != 'lobby') { FGUYChatClose(false); return; }
    var t = String(flash.external.ExternalInterface.call('FGUYMOD_ChatTyped'));
    if (t == '' || t == 'undefined') return;
    for (var i = 0; i < t.length && FGUYChatTyping; i++) {
        var ch = t.charAt(i), code = t.charCodeAt(i);
        if (code == 13 || code == 10) FGUYChatClose(true);
        else if (code == 27) FGUYChatClose(false);
        else if (code == 8) FGUYChatDraft = FGUYChatDraft.substr(0, Math.max(0, FGUYChatDraft.length - 1));
        else if (code >= 32 && ch != '|' && FGUYChatDraft.length < 100) FGUYChatDraft = FGUYChatDraft + ch;
    }
    FGUYDraw();
}

function FGUYPlayerRow(ui, x, y, w, m) {
    var me = m.slot == FGUYS.slot;
    FGUYRect(ui, x, y, w, 72, 16, me ? FGUYC.rowHot : 0x174478, 100, me ? FGUYC.yellow : FGUYC.rowLine, 100, 2);
    FGUYPortrait(ui, FGUYCostumePic(m.character, m.costume), x + 36, y + 36, 26);
    FGUYText(ui, x + 74, y + 8, w - 230, 32, m.name, false, 22, FGUYC.white, 'left');
    FGUYText(ui, x + 74, y + 38, w - 230, 26, FGUYCharName(m.character) + ' - ' + (m.input == 'k' ? 'Keyboard' : 'Controller') +
             ' - ' + m.ping + ' ms', false, 16, FGUYC.muted2, 'left');
    var label = m.away ? 'IN MATCH' : (m.slot == 0 ? 'HOST' : (m.ready ? 'READY' : 'NOT READY'));
    var fill = m.slot == 0 ? FGUYC.yellow : (m.ready ? FGUYC.green : FGUYC.bg);
    var line = m.slot == 0 ? FGUYC.yellow : (m.ready ? FGUYC.greenLine : FGUYC.redLine);
    var ink = m.slot == 0 ? FGUYC.dark : (m.ready ? FGUYC.white : FGUYC.red);
    FGUYRect(ui, x + w - 142, y + 20, 128, 34, 10, fill, 100, line, 100, 2);
    FGUYText(ui, x + w - 142, y + 25, 128, 28, label, false, 16, ink, 'center');
}

function FGUYRulesLine(short) {
    var mode = FGUYMode(FGUYS.mode);
    if (mode.code == 'ST') return 'Story level';
    return FGUYRulesParts(short).join(' - ');
}

function FGUYRulesParts(short) {
    var mode = FGUYMode(FGUYS.mode);
    if (mode.code == 'ST') return ['Story level', 'Drop in any time'];
    var t = FGUYRules.TimeLimit[FGUYS.time];
    var parts = [];
    if (mode.teams) parts.push(short ? 'Teams' : 'Good vs Evil');
    if (t == undefined) t = '-';
    if (isNaN(Number(t))) parts.push(short ? t : 'No time limit');
    else parts.push(t + (short ? '' : ' min'));
    if (!short && mode.score != '') parts.push('to ' + FGUYRules[mode.score][FGUYS.score]);
    if (!short) parts.push('Friendly fire ' + FGUYRules.FriendlyFire[FGUYS.ff]);
    return parts;
}

// ---- character & skin ---------------------------------------------------------------------------------------------
function FGUYDrawChar(ui) {
    var mode = FGUYMode(FGUYS.mode);
    FGUYTitle(ui, 48, 26, 900, 80, 'CHARACTER', 60, FGUYC.title, 'left');
    FGUYText(ui, 700, 52, 852, 30, (FGUYIsHost() ? 'From your save' : "From the host's save (the match plays on it)") +
             ' - others see your pick live', false, 20, FGUYC.muted2, 'right');
    if (mode.teams) {
        FGUYChoice(ui, 48, 120, 150, 'GOOD', FGUYPickTeam == 0, false);
        FGUYChoice(ui, 210, 120, 150, 'EVIL', FGUYPickTeam == 1, false);
        FGUYHit(48, 120, 150, 58, 'team', 0);
        FGUYHit(210, 120, 150, 58, 'team', 1);
        FGUYText(ui, 372, 134, 300, 30, 'X or click to switch team', false, 17, FGUYC.muted, 'left');
    }
    for (var i = 0; i < FGUYChars.length; i++) {
        var col = i % 5, row = Math.floor(i / 5);
        var x = 48 + col * 196, y = 200 + row * 300, c = FGUYChars[i], sel = FGUYCharSel == i;
        if (sel) FGUYRect(ui, x - 6, y - 6, 192, 292, 24, FGUYC.yellow, 35, 0, 0, 0);
        FGUYRect(ui, x, y, 180, 280, 20, FGUYC.panel, 100, sel ? FGUYC.yellow : FGUYC.rowLine, 100, 3);
        FGUYHit(x, y, 180, 280, 'charCard', i);
        var list = FGUYCostumeList(c);
        FGUYPicture(ui, FGUYEntryPic(c, list[0]), x + 3, y + 3, 174, 224, 17, 0.08);
        FGUYText(ui, x + 6, y + 236, 168, 34, FGUYCharName(c), true, 22, sel ? FGUYC.yellow : FGUYC.white, 'center');
    }
    // preview: the character live in 3D, then its skins
    var px = 1042, pw = 510, c2 = FGUYChars[FGUYCharSel];
    var costumes = FGUYCostumeList(c2);
    if (FGUYCostumeSel >= costumes.length) FGUYCostumeSel = 0;
    FGUYStage(ui, px, 120, pw, 443);
    FGUYHit(px + 3, 123, pw - 6, 437, 'stage', 0);
    FGUY3DShow(c2, costumes.length > 0 ? costumes[FGUYCostumeSel].CostumeIndex : 0);
    FGUYStageView(px + pw / 2, 156, 528);
    FGUYPanel(ui, px, 578, pw, 242, 24, FGUYC.panel, FGUYC.glow);
    FGUYTitle(ui, px + 26, 588, pw - 52, 56, FGUYCharName(c2), 42, FGUYC.yellow, 'left');
    var skinName = costumes.length > 0 ? FGUYCostumeName(c2, costumes[FGUYCostumeSel].CostumeIndex) : 'Classic';
    FGUYText(ui, px + 26, 646, pw - 52, 30, 'Skin: ' + skinName + '   (' + (FGUYCostumeSel + 1) + ' / ' + Math.max(1, costumes.length) + ')', false, 20, FGUYC.white, 'left');
    var first = Math.max(0, Math.min(FGUYCostumeSel - 2, costumes.length - 5));
    for (var k = first; k < costumes.length && k < first + 5; k++) {
        var tx = px + 26 + (k - first) * 92, on = k == FGUYCostumeSel;
        FGUYRect(ui, tx, 690, 82, 112, 12, FGUYC.panel2, 100, on ? FGUYC.yellow : FGUYC.rowLine, 100, on ? 3 : 2);
        FGUYHit(tx, 690, 82, 112, 'skin', k);
        FGUYPicture(ui, FGUYEntryPic(c2, costumes[k]), tx + 3, 693, 76, 106, 9, 0.05);
    }
    FGUYFooter(ui, ['A', 'Confirm', 'B', 'Back', 'LB', 'Skin', 'RB', 'Skin'], 'Click to pick - drag or Q / E to turn');
}

// ---- loading: the match is starting (the session game boots hidden and takes over when it's ready) ---------
function FGUYDrawLoading(ui) {
    var mode = FGUYMode(FGUYS.mode);
    FGUYMapPicture(ui, FGUYS.map, FGUYS.mode, 0, 0, 1600, 900, 0);
    var top = ui.createEmptyMovieClip('loadTop', ui.getNextHighestDepth());
    FGUYRect(top, 0, 0, 1600, 900, 0, FGUYC.bg, 45, 0, 0, 0);
    FGUYRect(top, 0, 560, 1600, 340, 0, FGUYC.bg, 80, 0, 0, 0);
    FGUYRect(top, 0, 558, 1600, 3, 0, FGUYC.glow, 100, 0, 0, 0);
    FGUYText(top, 64, 594, 900, 30, mode.name, false, 22, FGUYC.title, 'left');
    FGUYTitle(top, 64, 622, 1000, 90, FGUYMapName(FGUYS.map, FGUYS.mode), 66, FGUYC.yellow, 'left');
    FGUYText(top, 64, 712, 1000, 30, FGUYRulesLine(false), false, 20, FGUYC.soft, 'left');
    // everyone in the match
    var n = FGUYS.members.length, x = 64;
    for (var i = 0; i < n; i++) {
        var m = FGUYS.members[i];
        FGUYRect(top, x, 770, 330, 76, 18, FGUYC.panel, 90, m.slot == FGUYS.slot ? FGUYC.yellow : FGUYC.rowLine, 100, 2);
        FGUYPortrait(top, FGUYCostumePic(m.character, m.costume), x + 38, 808, 28);
        FGUYText(top, x + 76, 776, 240, 32, m.name, false, 22, FGUYC.white, 'left');
        FGUYText(top, x + 76, 808, 240, 28, FGUYCharName(m.character) + (mode.teams ? ' - ' + (m.team == 1 ? 'Evil' : 'Good') : ''), false, 17, FGUYC.muted2, 'left');
        x = x + 350;
    }
    // "LOADING..." with a spinner of dots
    var dots = FGUYLoadStep % 4, d = '';
    for (var k = 0; k < dots; k++) d = d + '.';
    FGUYTitle(top, 1100, 640, 440, 70, 'LOADING' + d, 48, FGUYC.white, 'left');
    for (var j = 0; j < 5; j++)
        FGUYCircle(top, 1124 + j * 34, 734, 10, j == FGUYLoadStep % 5 ? FGUYC.yellow : FGUYC.chipLine, 100, 0, 0);
    FGUYText(top, 64, 40, 1472, 30, 'Everyone gets their own full screen', false, 20, FGUYC.soft, 'right');
}

// ---- match settings --------------------------------------------------------------------------------------------------
// Auto frame rate: the lowest of everyone's monitors (the server picks the same at the start).
function FGUYAutoRate() {
    var low = 240;   // (the highest online rate)
    for (var i = 0; i < FGUYS.members.length; i++) {
        var r = FGUYS.members[i].rate;
        if (r > 0 && r < low) low = r;
    }
    return low;
}

function FGUYSettingRows() {
    var mode = FGUYMode(FGUYS.mode);
    var rows = ['mode', 'map'];
    if (mode.code != 'ST') {
        rows.push('time');
        if (mode.score != '') rows.push('score');
        rows.push('ff');
    }
    rows.push('rate');
    return rows;
}

function FGUYSettingValue(r) {
    var mode = FGUYMode(FGUYS.mode);
    if (r == 'mode') return ['GAME MODE', mode.name];
    if (r == 'map') return [mode.code == 'ST' ? 'LEVEL' : 'MAP', FGUYMapName(FGUYS.map, FGUYS.mode)];
    if (r == 'time') return ['TIME LIMIT', FGUYRules.TimeLimit[FGUYS.time]];
    if (r == 'score') return [mode.score == 'FlagLimit' ? 'FLAG LIMIT' : 'WINNING SCORE', FGUYRules[mode.score][FGUYS.score]];
    if (r == 'rate') return ['FRAME RATE', FGUYS.rate > 0 ? FGUYS.rate + ' FPS' : 'Auto (' + FGUYAutoRate() + ' FPS)'];
    return ['FRIENDLY FIRE', FGUYRules.FriendlyFire[FGUYS.ff]];
}

function FGUYSettingHelp(r) {
    var mode = FGUYMode(FGUYS.mode);
    if (r == 'mode') return mode.about;
    if (r == 'map') return mode.code == 'ST' ? 'Which story level you play together.' : "Where you play. You can pick the maps the host's save has unlocked.";
    if (r == 'time') return 'How long a match lasts.';
    if (r == 'score') return mode.score == 'FlagLimit' ? 'The match ends when a team captures this many flags.' : 'The match ends when a team reaches this score.';
    if (r == 'rate') return 'Everyone plays at the same frame rate. Auto: the best every player\'s screen shows (up to 240). If a PC can\'t keep up, the match follows it: fewer frames for a while, never slow motion.';
    return 'On: you can hurt your own team. Off: you can only hurt the other team.';
}

function FGUYWrap(mc, x, y, w, text, chars, size, color) {   // simple word wrap; returns the next line's y
    var words = String(text).split(' '), line = '';
    for (var i = 0; i < words.length; i++) {
        if (line != '' && (line + ' ' + words[i]).length > chars) { FGUYText(mc, x, y, w, 30, line, false, size, color, 'left'); y = y + size + 8; line = words[i]; }
        else line = line == '' ? words[i] : line + ' ' + words[i];
    }
    if (line != '') { FGUYText(mc, x, y, w, 30, line, false, size, color, 'left'); y = y + size + 8; }
    return y;
}

function FGUYDrawSettings(ui) {
    var host = FGUYIsHost(), mode = FGUYMode(FGUYS.mode);
    FGUYTitle(ui, 48, 26, 900, 80, 'MATCH SETTINGS', 60, FGUYC.title, 'left');
    FGUYText(ui, 900, 52, 652, 30, host ? 'You pick - everyone sees it right away' : 'Only the host can change these', false, 20, FGUYC.muted2, 'right');
    FGUYPanel(ui, 48, 130, 940, 690, 28, FGUYC.panel, FGUYC.glow);
    var rows = FGUYSettingRows();
    if (FGUYFocus >= rows.length) FGUYFocus = 0;
    // the rows share the panel with the help box under them (always 130 high): fewer rows, taller rows
    var step = Math.min(84, Math.floor(500 / (rows.length + 1))), rh = step - 12;
    for (var i = 0; i < rows.length; i++) {
        var v = FGUYSettingValue(rows[i]);
        FGUYRow(ui, 76, 160 + i * step, 884, rh, v[0], v[1], FGUYFocus == i, host, host ? '' : 'Host picks', 'setRow', i);
    }
    var ly = 160 + rows.length * step;
    FGUYRow(ui, 76, ly, 884, rh, 'LOBBY', FGUYS.priv ? 'Code only' : 'Anyone can join', false);
    // what the selected setting does
    var hy = ly + step + 6;
    FGUYRect(ui, 76, hy, 884, 790 - hy, 18, FGUYC.deep, 100, FGUYC.rowLine, 100, 2);
    FGUYText(ui, 100, hy + 12, 836, 24, FGUYSettingValue(rows[FGUYFocus])[0], false, 15, FGUYC.muted, 'left');
    FGUYWrap(ui, 100, hy + 40, 836, FGUYSettingHelp(rows[FGUYFocus]), 80, 19, FGUYC.soft);
    var px = 1020, pw = 532;
    FGUYPanel(ui, px, 130, pw, 470, 28, FGUYC.panel2, FGUYC.glow);
    FGUYMapPicture(ui, FGUYS.map, FGUYS.mode, px + 3, 133, pw - 6, 250, 25);
    FGUYTitle(ui, px + 24, 396, pw - 48, 46, FGUYMapName(FGUYS.map, FGUYS.mode), 30, FGUYC.title, 'left');
    FGUYWrap(ui, px + 24, 446, pw - 48, mode.name + ' - ' + FGUYRulesLine(false), 44, 18, FGUYC.soft);
    FGUYRect(ui, px, 620, pw, 110, 20, FGUYC.deep, 100, FGUYC.rowLine, 100, 2);
    FGUYText(ui, px + 22, 636, pw - 44, 24, 'ONLINE', false, 15, FGUYC.muted, 'left');
    FGUYText(ui, px + 22, 664, pw - 44, 30, 'Everyone plays full screen on their own PC.', false, 18, FGUYC.soft, 'left');
    if (host) FGUYFooter(ui, ['ARROWS', 'Change', 'A', 'Next choice', 'B', 'Done'], '', '');
    else FGUYFooter(ui, ['B', 'Back'], 'Only the host can change these', 'info');
}

// ---- input ------------------------------------------------------------------------------------------------------------
// Keys from the menu: 38 up, 40 down, 37 left, 39 right, 13 A (after 65), 27 B, 36 Start (then 32), 88 X,
// 89 Y (112 = F1 on a keyboard), 76 LB, 82 RB; on a keyboard also letters / digits (code entry), 8 backspace.
function OnOnlineHandleInput(key, controller) {
    if (FGUYScreen == 'loading') return;   // the match is on its way
    if (FGUYChatTyping) return;            // (typing in the chat box: its characters come from the loader)
    if (key >= 37 && key <= 40 && flash.external.ExternalInterface.call('FGUYMOD_FromWASD', key) == true) return;
    FGUYKeyFromPad = FGUYPadKey(key);
    if (FGUYScreen == 'mods') FGUYInputMods(key);
    else if (FGUYScreen == 'hub') FGUYInputHub(key);
    else if (FGUYScreen == 'lobby') FGUYInputLobby(key);
    else if (FGUYScreen == 'char') FGUYInputChar(key);
    else FGUYInputSettings(key);
    if (FGUYOnline) FGUYDraw();
}

// The menus turn some controller buttons into letter keys (A, LB = L, RB = R, X, Y). The loader knows
// whether that button was just pressed on a controller; if not, it's a letter typed on a keyboard.
function FGUYPadKey(key) {
    var bits = 0;
    if (key == 65) bits = 0x1000;
    else if (key == 76) bits = 0x0100;
    else if (key == 82) bits = 0x0200;
    else if (key == 88) bits = 0x4000;
    else if (key == 89) bits = 0x8000;
    if (bits == 0) return false;
    return flash.external.ExternalInterface.call('FGUYMOD_PadPressed', bits) == true;
}

function FGUYTyping() {   // the code boxes have the focus: letter keys type
    return FGUYScreen == 'hub' && FGUYHubPanel == 2 && FGUYFocus == 0;
}

function FGUYInputHub(key) {
    var online = FGUYS.state == 'online';
    // (not in the first moment: the 3D camera is still on its way to the Store, and leaving then showed the main
    //  menu with the camera mid-way - black - until it got back; the game's own pages wait for their camera too)
    if (key == 27 && FGUYNow() - FGUYEnteredAt < 1200) return;
    if (key == 27) { FGUYSound('back'); PrevPage(); return; }

    if ((key == 76 || key == 82) && (FGUYKeyFromPad || !FGUYTyping())) {
        FGUYHubPanel = (FGUYHubPanel + (key == 82 ? 1 : 2)) % 3;
        FGUYFocus = 0;
        FGUYSound('nav');
        return;
    }
    if (key == 89 && (FGUYKeyFromPad || !FGUYTyping())) {   // Y: the reports folder (out-of-sync matches, crashes)
        flash.external.ExternalInterface.call('FGUYMOD_OpenReports');
        FGUYSound('accept');
        return;
    }
    if (FGUYHubPanel == 0) {
        if (key == 38 || key == 40) { FGUYFocus = (FGUYFocus + (key == 40 ? 1 : 2)) % 3; FGUYSound('nav'); }
        else if ((key == 37 || key == 39) && FGUYFocus == 0) { FGUYHostPrivate = 1 - FGUYHostPrivate; FGUYSound('change'); }
        else if ((key == 37 || key == 39) && FGUYFocus == 1) { FGUYHostMax = Math.max(2, Math.min(4, FGUYHostMax + (key == 39 ? 1 : -1))); FGUYSound('change'); }
        else if (key == 39) { FGUYHubPanel = 1; FGUYFocus = 0; FGUYSound('nav'); }
        else if (key == 13 || key == 36) {
            if (FGUYFocus < 2) { FGUYFocus = 2; FGUYSound('nav'); }
            else if (online) { FGUYDo('host', FGUYHostMax, FGUYHostPrivate); FGUYSound('accept'); }
            else FGUYSound('deny');
        }
    } else if (FGUYHubPanel == 1) {
        var n = FGUYS.lobbies.length;
        if (key == 38 && n > 0) { FGUYFind = (FGUYFind + n - 1) % n; FGUYSound('nav'); }
        else if (key == 40 && n > 0) { FGUYFind = (FGUYFind + 1) % n; FGUYSound('nav'); }
        else if (key == 37 || key == 39) { FGUYHubPanel = key == 39 ? 2 : 0; FGUYFocus = 0; FGUYSound('nav'); }
        else if (key == 13 && n > 0 && online) { FGUYDo('join', FGUYS.lobbies[FGUYFind].code); FGUYSound('accept'); }
        else if (key == 13) FGUYSound('deny');
    } else {
        FGUYInputCode(key, online);
    }
}

function FGUYInputCode(key, online) {
    var len = FGUYCodeChars.length;
    if (FGUYFocus == 1) {   // the JOIN button
        if (key == 38) { FGUYFocus = 0; FGUYSound('nav'); }
        else if (key == 37) { FGUYHubPanel = 1; FGUYFocus = 0; FGUYSound('nav'); }
        else if (key == 13 && FGUYCodeLen == 4 && online) {
            var code = '';
            for (var i = 0; i < 4; i++) code = code + FGUYCodeChars.charAt(FGUYCode[i]);
            FGUYDo('join', code);
            FGUYSound('accept');
        } else if (key == 13) FGUYSound('deny');
        return;
    }
    if (key == 38 || key == 40) {
        FGUYCode[FGUYCodePos] = (FGUYCode[FGUYCodePos] + (key == 38 ? 1 : len - 1)) % len;
        if (FGUYCodeLen <= FGUYCodePos) FGUYCodeLen = FGUYCodePos + 1;
        FGUYSound('scroll');
    } else if (key == 37) {
        if (FGUYCodePos > 0) { FGUYCodePos--; FGUYSound('nav'); }
        else { FGUYHubPanel = 1; FGUYFocus = 0; FGUYSound('nav'); }
    } else if (key == 39) {
        if (FGUYCodePos < 3) { FGUYCodePos++; if (FGUYCodeLen < FGUYCodePos) FGUYCodeLen = FGUYCodePos; FGUYSound('nav'); }
    } else if (key == 13) {
        if (FGUYCodeLen == 4) { FGUYFocus = 1; FGUYInputCode(13, online); }   // a whole code: join
        else if (FGUYCodePos < 3) { FGUYCodePos++; if (FGUYCodeLen < FGUYCodePos) FGUYCodeLen = FGUYCodePos; FGUYSound('nav'); }
        else { FGUYCodeLen = 4; FGUYFocus = 1; FGUYSound('nav'); }
    }
}

// Typed on a keyboard (FGUYMOD_TypedText, from the loader): letters and digits go straight into the code
// (no need to pick the boxes first), \b deletes. Enter (a menu key) joins once it's complete.
function FGUYTyped(text) {
    for (var i = 0; i < text.length; i++) {
        var ch = text.charAt(i);
        if (FGUYHubPanel != 2 || FGUYFocus != 0) { FGUYHubPanel = 2; FGUYFocus = 0; }
        if (ch == '\b') {
            if (FGUYCodeLen > 0) { FGUYCodeLen--; FGUYSound('back'); }
            FGUYCodePos = Math.min(FGUYCodeLen, 3);
            continue;
        }
        var at = FGUYCodeChars.indexOf(ch);
        if (at < 0) { FGUYSound('deny'); continue; }   // I O 0 1 aren't used in codes
        if (FGUYCodeLen < 4) {
            FGUYCode[FGUYCodeLen] = at;
            FGUYCodeLen++;
            FGUYSound('scroll');
        }
        FGUYCodePos = Math.min(FGUYCodeLen, 3);
    }
}

function FGUYInputLobby(key) {
    var items = FGUYLobbyItems(), host = FGUYIsHost(), mode = FGUYMode(FGUYS.mode);
    var it = items[FGUYFocus];
    if (key == 27) { FGUYDo('leave'); FGUYSound('back'); FGUYScreen = 'hub'; FGUYFocus = 0; return; }
    if (key == 38) { FGUYFocus = (FGUYFocus + items.length - 1) % items.length; FGUYSound('nav'); return; }
    if (key == 40) { FGUYFocus = (FGUYFocus + 1) % items.length; FGUYSound('nav'); return; }
    if (key == 88 || key == 36) { FGUYPrimary(); return; }
    if (key == 65 || key == 32) return;   // the controller's A and Start come again as Enter / Start
    if (key == 89 || key == 112) { FGUYOpenChar(); return; }
    var dir = key == 39 ? 1 : (key == 37 ? -1 : 0);
    if (it == 'chat') {
        var quick = FGUYQuickChat();
        if (dir != 0) { FGUYChatQuick = (FGUYChatQuick + dir + quick.length) % quick.length; FGUYSound('change'); return; }
        if (key == 13) {
            if (FGUYKeyFromPad) { FGUYDo('say', quick[FGUYChatQuick]); FGUYSound('accept'); }
            else FGUYChatOpen();
            return;
        }
    }
    if (dir != 0) {
        if (it == 'mode' && host) { FGUYCycleMode(dir); FGUYSound('change'); }
        else if (it == 'map' && host) { FGUYCycleMap(dir); FGUYSound('change'); }
        else if ((it == 'mode' || it == 'map' || it == 'settings') && !host) { FGUYToast('Only the host can change the match'); FGUYSound('deny'); }
        else if (it == 'settings') { FGUYScreen = 'settings'; FGUYFocus = 0; FGUYSound('accept'); }
        else if (it == 'skin') { FGUYCycleSkin(dir); FGUYSendPick(); FGUYSound('change'); }
        else if (it == 'char') { FGUYCycleChar(dir); FGUYSendPick(); FGUYSound('change'); }
        else if (it == 'team' && mode.teams) { FGUYPickTeam = 1 - FGUYPickTeam; FGUYSendPick(); FGUYSound('change'); }
        else if (it == 'controls') { FGUYToggleInput(); }
        else FGUYSound('deny');
        return;
    }
    if (key == 13) {
        if (it == 'start' || it == 'ready') FGUYPrimary();
        else if ((it == 'mode' || it == 'map') && host) {   // A steps to the next choice, like right
            if (it == 'mode') FGUYCycleMode(1); else FGUYCycleMap(1);
            FGUYSound('change');
        } else if (it == 'settings' || it == 'mode' || it == 'map') { FGUYScreen = 'settings'; FGUYFocus = it == 'map' ? 1 : 0; FGUYSound('accept'); }
        else if (it == 'char' || it == 'skin') FGUYOpenChar();
        else if (it == 'team' && mode.teams) { FGUYPickTeam = 1 - FGUYPickTeam; FGUYSendPick(); FGUYSound('change'); }
        else if (it == 'controls') { FGUYToggleInput(); }
        else if (it == 'leave') { FGUYDo('leave'); FGUYSound('back'); FGUYScreen = 'hub'; FGUYFocus = 0; }
    }
}

function FGUYToggleInput() {
    FGUYPickInput = FGUYPickInput == 'k' ? 'c' : 'k';
    FGUYSendPick();
    FGUYSound('change');
    FGUYToast('You play with ' + (FGUYPickInput == 'k' ? 'keyboard and mouse' : 'a controller') + ' (your own key bindings)');
}

function FGUYPrimary() {
    if (FGUYIsHost()) {
        var all = FGUYReadyCount() == FGUYS.members.length && FGUYS.members.length > 1;
        if (all) { FGUYDo('start'); FGUYSound('accept'); }
        else { FGUYToast(FGUYLobbyStatus()[0]); FGUYSound('deny'); }
    } else {
        FGUYDo('ready');
        FGUYSound('accept');
    }
}

function FGUYCycleMode(dir) {
    var at = 0;
    for (var i = 0; i < FGUYModes.length; i++) if (FGUYModes[i].code == FGUYS.mode) at = i;
    at = (at + dir + FGUYModes.length) % FGUYModes.length;
    FGUYS.mode = FGUYModes[at].code;
    var maps = FGUYMapsFor(FGUYS.mode), ok = false;
    for (var k = 0; k < maps.length; k++) if (maps[k] == FGUYS.map) ok = true;
    if (!ok) FGUYS.map = maps[0];
    if (!FGUYModes[at].teams && FGUYPickTeam != 0) { FGUYPickTeam = 0; FGUYSendPick(); }
    FGUYSendConf();
    FGUYToast('Mode: ' + FGUYModes[at].name + (ok ? '' : ' - map: ' + FGUYMapName(FGUYS.map, FGUYS.mode)));
    FGUYCheckPick();   // (story co-op is Stewie and Brian only; the server's echo won't show this change)
}

// Host: make sure the lobby's map exists in its mode (e.g. right after creating the lobby).
function FGUYCheckMap() {
    var maps = FGUYMapsFor(FGUYS.mode);
    for (var i = 0; i < maps.length; i++) if (maps[i] == FGUYS.map) return;
    FGUYS.map = maps[0];
    FGUYSendConf();
}

function FGUYCycleMap(dir) {
    var maps = FGUYMapsFor(FGUYS.mode), at = 0;
    for (var i = 0; i < maps.length; i++) if (maps[i] == FGUYS.map) at = i;
    FGUYS.map = maps[(at + dir + maps.length) % maps.length];
    FGUYSendConf();
    FGUYToast((FGUYMode(FGUYS.mode).code == 'ST' ? 'Level: ' : 'Map: ') + FGUYMapName(FGUYS.map, FGUYS.mode) +
              (maps.length == 1 ? ' (the only one unlocked)' : ''));
}

function FGUYCycleSkin(dir) {
    var list = FGUYCostumeList(FGUYPickChar), at = 0;
    if (list.length == 0) return;
    for (var i = 0; i < list.length; i++) if (String(list[i].CostumeIndex) == String(FGUYPickCostume)) at = i;
    FGUYPickCostume = list[(at + dir + list.length) % list.length].CostumeIndex;
}

function FGUYCycleChar(dir) {
    var at = 0, n = FGUYChars.length;
    for (var i = 0; i < n; i++) if (FGUYChars[i] == FGUYPickChar) at = i;
    var to = (at + dir + n) % n;
    while (to != at && FGUYStoryTakenBy(FGUYChars[to], false) != null) to = (to + dir + n) % n;   // (story: someone's)
    if (to == at) {
        var by = FGUYStoryTakenBy(FGUYChars[(at + dir + n) % n], false);
        if (by != null) FGUYToast(by.name + ' is ' + FGUYCharName(by.character));
        return;
    }
    FGUYPickChar = FGUYChars[to];
    var list = FGUYCostumeList(FGUYPickChar);
    FGUYPickCostume = list.length > 0 ? list[0].CostumeIndex : 0;
}

function FGUYOpenChar() {
    FGUYScreen = 'char';
    FGUYCharSel = 0;
    for (var i = 0; i < FGUYChars.length; i++) if (FGUYChars[i] == FGUYPickChar) FGUYCharSel = i;
    FGUYCostumeSel = 0;
    var list = FGUYCostumeList(FGUYPickChar);
    for (var k = 0; k < list.length; k++) if (String(list[k].CostumeIndex) == String(FGUYPickCostume)) FGUYCostumeSel = k;
    FGUYSound('accept');
}

function FGUYInputChar(key) {
    var n = FGUYChars.length, mode = FGUYMode(FGUYS.mode);
    if (key == 27) { FGUYScreen = 'lobby'; FGUYSound('back'); return; }
    if (key == 37) { FGUYCharSel = (FGUYCharSel + n - 1) % n; FGUYCostumeSel = 0; FGUYSound('nav'); }
    else if (key == 39) { FGUYCharSel = (FGUYCharSel + 1) % n; FGUYCostumeSel = 0; FGUYSound('nav'); }
    else if (key == 38 || key == 40) { FGUYCharSel = (FGUYCharSel + 5) % 10; if (FGUYCharSel >= n) FGUYCharSel = n - 1; FGUYCostumeSel = 0; FGUYSound('nav'); }
    else if (key == 76 || key == 82) {
        var list = FGUYCostumeList(FGUYChars[FGUYCharSel]);
        if (list.length > 0) FGUYCostumeSel = (FGUYCostumeSel + (key == 82 ? 1 : list.length - 1)) % list.length;
        FGUYSound('change');
    } else if (key == 88 && mode.teams) { FGUYPickTeam = 1 - FGUYPickTeam; FGUYSound('change'); }
    else if (key == 13 || key == 36) {
        var by = FGUYStoryTakenBy(FGUYChars[FGUYCharSel], false);
        if (by != null && FGUYChars[FGUYCharSel] != FGUYPickChar) {   // (story co-op: someone else plays them)
            FGUYToast(by.name + ' is ' + FGUYCharName(by.character));
            FGUYSound('back');
            return;
        }
        FGUYPickChar = FGUYChars[FGUYCharSel];
        var costumes = FGUYCostumeList(FGUYPickChar);
        FGUYPickCostume = costumes.length > 0 ? costumes[FGUYCostumeSel].CostumeIndex : 0;
        FGUYSendPick();
        FGUYScreen = 'lobby';
        FGUYSound('accept');
    }
}

function FGUYInputSettings(key) {
    var rows = FGUYSettingRows(), r = rows[FGUYFocus], mode = FGUYMode(FGUYS.mode);
    if (key == 27) { FGUYScreen = 'lobby'; FGUYFocus = 3; FGUYSound('back'); return; }
    if (key == 38) { FGUYFocus = (FGUYFocus + rows.length - 1) % rows.length; FGUYSound('nav'); return; }
    if (key == 40) { FGUYFocus = (FGUYFocus + 1) % rows.length; FGUYSound('nav'); return; }
    var dir = key == 39 ? 1 : (key == 37 || key == 76 ? -1 : (key == 13 || key == 82 ? 1 : 0));
    if (dir == 0) return;
    if (!FGUYIsHost()) {
        if (key == 13) { FGUYScreen = 'lobby'; FGUYFocus = 3; FGUYSound('back'); return; }
        FGUYToast('Only the host can change the match');
        FGUYSound('deny');
        return;
    }
    if (r == 'mode') FGUYCycleMode(dir);
    else if (r == 'map') FGUYCycleMap(dir);
    else if (r == 'rate') {
        var rates = [0, 60, 120, 144, 165, 240], at = 0;
        for (var k = 0; k < rates.length; k++) if (rates[k] == FGUYS.rate) at = k;
        FGUYS.rate = rates[(at + dir + rates.length) % rates.length];
        FGUYDo('rate', FGUYS.rate);
        var rv = FGUYSettingValue('rate');
        FGUYToast('Frame rate: ' + rv[1]);
    } else {
        var list = r == 'time' ? FGUYRules.TimeLimit : (r == 'score' ? FGUYRules[mode.score] : FGUYRules.FriendlyFire);
        var field = r == 'time' ? 'time' : (r == 'score' ? 'score' : 'ff');
        FGUYS[field] = (FGUYS[field] + dir + list.length) % list.length;
        FGUYSendConf();
        var v = FGUYSettingValue(r);
        FGUYToast(v[0].charAt(0) + v[0].substr(1).toLowerCase() + ': ' + v[1]);
    }
    FGUYSound('change');
}

// ---- MODS ------------------------------------------------------------------------------------------------------------
// The separate mods in FGUYMod\mods\ (src/loader/modloader.cpp): on / off, from the next start. Gameplay mods must be
// the same for everyone in an online lobby; cosmetic ones may differ.
function FGUYModsEnter() {
    _root.subMenu._visible = false;
    Selection.setFocus(null);
    FGUYColors();
    FGUYScreen = 'mods';
    FGUYModsSel = 0;
    FGUYModsTop = 0;
    FGUYModsRead();
    FGUYDraw();
}

function FGUYModsRead() {
    var lines = String(flash.external.ExternalInterface.call('FGUYMOD_ModsList')).split('\n');
    FGUYModsChanged = lines[0] == '1';
    FGUYMods = [];
    for (var i = 1; i < lines.length; i++) {
        if (lines[i] == '') continue;
        var f = lines[i].split('|');
        FGUYMods.push({folder: f[0], name: f[1], version: f[2], author: f[3], type: f[4], on: f[5] == '1', running: f[6] == '1',
                       about: f[7]});
    }
    if (FGUYModsSel >= FGUYMods.length) FGUYModsSel = Math.max(0, FGUYMods.length - 1);
}

function FGUYDrawMods(ui) {
    FGUYTitle(ui, 48, 26, 600, 80, 'MODS', 60, FGUYC.title, 'left');
    FGUYText(ui, 640, 50, 912, 30, 'Separate mods from FGUYMod\\mods - switching takes effect after a restart', false, 20,
             FGUYC.muted2, 'right');
    FGUYPanel(ui, 48, 130, 1504, 690, 28, FGUYC.panel, FGUYC.glow);
    if (FGUYMods.length == 0) {
        FGUYText(ui, 90, 200, 1400, 40, 'No mods yet.', false, 30, FGUYC.white, 'left');
        FGUYText(ui, 90, 250, 1400, 30, 'Put a mod\'s folder in FGUYMod\\mods\\ (Y opens it), then come back here to switch it on.',
                 false, 20, FGUYC.soft, 'left');
    }
    var shown = 7;
    if (FGUYModsSel < FGUYModsTop) FGUYModsTop = FGUYModsSel;
    if (FGUYModsSel >= FGUYModsTop + shown) FGUYModsTop = FGUYModsSel - shown + 1;
    for (var i = FGUYModsTop; i < FGUYMods.length && i < FGUYModsTop + shown; i++) {
        var m = FGUYMods[i], y = 156 + (i - FGUYModsTop) * 72, hot = i == FGUYModsSel;
        FGUYRect(ui, 76, y, 1448, 62, 16, hot ? FGUYC.rowHot : FGUYC.row, 100, hot ? FGUYC.yellow : FGUYC.rowLine, 100, hot ? 3 : 2);
        FGUYHit(76, y, 1448, 62, 'modRow', i);
        FGUYText(ui, 100, y + 6, 760, 30, m.name + '  ' + m.version, false, 22, FGUYC.white, 'left');
        FGUYText(ui, 100, y + 34, 760, 26, m.author != '' ? 'by ' + m.author : m.folder, false, 16, FGUYC.muted2, 'left');
        var gameplay = m.type == 'gameplay';
        FGUYRect(ui, 1080, y + 16, 170, 32, 10, FGUYC.ink, 100, gameplay ? FGUYC.yellow : FGUYC.glow, 100, 2);
        FGUYText(ui, 1080, y + 20, 170, 28, gameplay ? 'GAMEPLAY' : 'COSMETIC', false, 15, gameplay ? FGUYC.yellow : FGUYC.soft, 'center');
        FGUYRect(ui, 1290, y + 12, 200, 40, 14, m.on ? FGUYC.green : FGUYC.bg, 100, m.on ? FGUYC.greenLine : FGUYC.redLine, 100, 2);
        FGUYText(ui, 1290, y + 18, 200, 30, m.on ? 'ON' : 'OFF', false, 20, m.on ? FGUYC.white : FGUYC.red, 'center');
    }
    if (FGUYMods.length > 0) {   // the chosen one's description, and what on / off means for it
        var c = FGUYMods[FGUYModsSel];
        var note = c.type == 'gameplay' ? 'Gameplay mod: online, everyone in the lobby needs it (the same version).'
                                        : 'Cosmetic mod: online, the others don\'t need it.';
        if (c.on && c.running) note = note + '  Its plugin is running.';
        FGUYText(ui, 90, 676, 1420, 30, c.about, false, 20, FGUYC.white, 'left');
        FGUYText(ui, 90, 712, 1420, 28, note, false, 17, FGUYC.muted2, 'left');
    }
    if (FGUYModsChanged) {
        FGUYRect(ui, 76, 754, 1448, 46, 14, 0x3A2A10, 100, FGUYC.yellow, 100, 2);
        FGUYText(ui, 76, 762, 1448, 30, 'Restart the game to apply your changes', false, 20, FGUYC.yellow, 'center');
    }
    FGUYFooter(ui, ['A', 'On / off', 'Y', 'Open the mods folder', 'B', 'Back'], '');
}

function FGUYInputMods(key) {
    var n = FGUYMods.length;
    if (key == 27) { FGUYSound('back'); PrevPage(); return; }
    if (key == 89) { flash.external.ExternalInterface.call('FGUYMOD_ModsOpenFolder'); FGUYSound('accept'); return; }
    if (n == 0) return;
    if (key == 38) { FGUYModsSel = (FGUYModsSel + n - 1) % n; FGUYSound('nav'); }
    else if (key == 40) { FGUYModsSel = (FGUYModsSel + 1) % n; FGUYSound('nav'); }
    else if (key == 13 || key == 37 || key == 39) {
        flash.external.ExternalInterface.call('FGUYMOD_ModsToggle', FGUYMods[FGUYModsSel].folder);
        FGUYModsRead();
        FGUYSound('change');
    }
}
