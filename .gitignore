# Build output
build/
*.obj
*.exp
*.lib

# Built mod plugins (src\mods\<mod>\build.bat puts them in their mod's folder)
dist/FGUYMod/mods/*/*.dll

# Local Python environment
.venv/
__pycache__/

# Game-derived data and personal files: never publish these
reference/
backups/
*.obj
*.exe

# The loading screen's music (a re-recording): it goes in the release download only, never in the code repo
sounds/
dist/FGUYMod/sounds/
